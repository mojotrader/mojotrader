//@version=6
indicator("BMS Market Structure — ZigZag", overlay=true, max_lines_count=500, max_labels_count=500)

// ---------------------------------------------------------------- Inputs
confClose = input.bool(true, "Confirm swings on candle CLOSE (else on wick break)",
     tooltip="On (your rule): a swing LOW needs a candle to CLOSE above the low-candle's high; a swing HIGH needs a candle to CLOSE below the high-candle's low. Off: confirms the instant a wick breaks the level.")
lineWidth = input.int(2, "ZigZag width", 1, 5)
upCol     = input.color(color.new(#26a69a, 0), "Up leg (into a high)")
dnCol     = input.color(color.new(#ef5350, 0), "Down leg (into a low)")
showLbls  = input.bool(true, "Show HH / HL / LH / LL labels")

// Close-level markers -------------------------------------------- (new)
// Marks the CLOSE of the candle that CONFIRMED the swing
// (the candle that closed above the low-candle's high, or below the high-candle's low).
showClose  = input.bool(true, "Mark confirming candle's CLOSE with a small horizontal line", group = "Close-level markers")
markBars   = input.int(3,     "Marker length (bars)", 1, 50, group = "Close-level markers")
markWidth  = input.int(2,     "Marker width", 1, 5, group = "Close-level markers")
markLowCol = input.color(color.new(#26a69a, 0), "Swing LOW confirm marker",  group = "Close-level markers")
markHighCol= input.color(color.new(#ef5350, 0), "Swing HIGH confirm marker", group = "Close-level markers")

// ---------------------------------------------------------------- Confirmed pivots (x stored as TIME)
var array<int>   pTime = array.new<int>()      // bar time of the pivot
var array<float> pPrc  = array.new<float>()
var array<int>   pTyp  = array.new<int>()      // 1 = high, -1 = low
var array<line>  pLine = array.new<line>()
var array<label> pLbl  = array.new<label>()

// ---------------------------------------------------------------- Current leg state
var int   dir  = -1    // -1 = down-leg (hunting a swing LOW), 1 = up-leg (hunting a swing HIGH)
var float extP = na    // running extreme price (candidate pivot)
var int   extT = na    // bar TIME of that extreme
var float armL = na    // level a later candle must break/close beyond to confirm

// bar duration in ms — used to give the close markers a fixed length in time
barMs = timeframe.in_seconds() * 1000

// ---------------------------------------------------------------- Draw a confirmed pivot
// tx/prc  = the swing point itself (extreme candle) -> used for the ZigZag + label
// mtx/mc  = the CONFIRMING candle's time/close      -> used for the close-level marker
addPivot(int typ, int tx, float prc, int mtx, float mc) =>
    float prevSame = na
    if array.size(pTyp) > 0
        for i = array.size(pTyp) - 1 to 0
            if array.get(pTyp, i) == typ
                prevSame := array.get(pPrc, i)
                break
    string txt = typ == 1 ? (na(prevSame) or prc > prevSame ? "HH" : "LH") : (na(prevSame) or prc < prevSame ? "LL" : "HL")
    color  c   = typ == 1 ? upCol : dnCol
    if array.size(pTime) > 0
        array.push(pLine, line.new(array.get(pTime, array.size(pTime) - 1), array.get(pPrc, array.size(pTime) - 1), tx, prc, xloc = xloc.bar_time, color = c, width = lineWidth))
    else
        array.push(pLine, na)
    if showLbls
        array.push(pLbl, label.new(tx, prc, txt, xloc = xloc.bar_time, style = typ == 1 ? label.style_label_down : label.style_label_up, color = color.new(c, 80), textcolor = c, size = size.small))
    else
        array.push(pLbl, na)
    // small horizontal line at the CONFIRMING candle's CLOSE level
    if showClose
        line.new(mtx, mc, mtx + barMs * markBars, mc, xloc = xloc.bar_time, color = typ == -1 ? markLowCol : markHighCol, width = markWidth)
    array.push(pTime, tx)
    array.push(pPrc, prc)
    array.push(pTyp, typ)

// ---------------------------------------------------------------- Confirmation triggers
confirmLow  = confClose ? close > armL : high > armL   // break above the low-candle's high  -> swing LOW
confirmHigh = confClose ? close < armL : low  < armL   // break below the high-candle's low  -> swing HIGH

// ---------------------------------------------------------------- Engine
if barstate.isfirst
    dir  := -1
    extP := low
    extT := time
    armL := high
else
    if dir == -1
        // hunting a swing LOW: keep tracking the lowest low; confirm on a CLOSE above that low-candle's HIGH
        if low < extP
            extP := low
            extT := time
            armL := high
        else if confirmLow
            // current bar is the CONFIRMING candle -> mark its close (time, close)
            addPivot(-1, extT, extP, time, close)
            dir  := 1
            extP := high
            extT := time
            armL := low
    else
        // hunting a swing HIGH: keep tracking the highest high; confirm on a CLOSE below that high-candle's LOW
        if high > extP
            extP := high
            extT := time
            armL := low
        else if confirmHigh
            // current bar is the CONFIRMING candle -> mark its close (time, close)
            addPivot(1, extT, extP, time, close)
            dir  := -1
            extP := low
            extT := time
            armL := high
