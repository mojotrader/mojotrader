//@version=6
strategy("BMS Market Structure — Strategy", overlay = true, max_lines_count = 500, max_labels_count = 500, pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = true, calc_on_every_tick = false)

// ================================================================ INPUTS
// ---- Swing rule (shared by both timeframes)
confClose = input.bool(true, "Confirm swings on candle CLOSE (else on wick break)",
     tooltip="On (your rule): a swing LOW needs a candle to CLOSE above the low-candle's high; a swing HIGH needs a candle to CLOSE below the high-candle's low. Off: confirms the instant a wick breaks the level.")
useEngulf = input.bool(true, "Instant swing on a full engulfing candle",
     tooltip="If a candle takes the PREVIOUS candle's high and CLOSES below its low, that candle's high is an immediate swing HIGH. Mirror: takes the previous low and closes above its high -> immediate swing LOW.")

// ---- Chart-timeframe (native) structure
grpL      = "Chart-timeframe structure"
showLTF   = input.bool(true,  "Show chart-timeframe structure", group = grpL)
lineWidth = input.int(2, "ZigZag width", 1, 5, group = grpL)
upCol     = input.color(color.new(#26a69a, 0), "Up leg (into a high)", group = grpL)
dnCol     = input.color(color.new(#ef5350, 0), "Down leg (into a low)", group = grpL)
showLbls  = input.bool(true, "Show HH / HL / LH / LL labels", group = grpL)
showClose = input.bool(true, "Mark confirming candle's CLOSE", group = grpL)
markBars  = input.int(3,  "Close-marker length (bars)", 1, 50, group = grpL)
markWidth = input.int(2,  "Close-marker width", 1, 5, group = grpL)
markLowCol  = input.color(color.new(#26a69a, 0), "Swing LOW confirm marker",  group = grpL)
markHighCol = input.color(color.new(#ef5350, 0), "Swing HIGH confirm marker", group = grpL)

// ---- Higher-timeframe structure (drawn on THIS chart)
grpH        = "Higher-timeframe structure"
showHTF     = input.bool(true,  "Show higher-timeframe structure", group = grpH)
htfTf       = input.timeframe("15", "Higher timeframe", group = grpH)
htfLineW    = input.int(3, "HTF ZigZag width", 1, 5, group = grpH)
htfUp       = input.color(color.new(#2962FF, 0), "HTF up leg (into a high)", group = grpH)
htfDn       = input.color(color.new(#FF6D00, 0), "HTF down leg (into a low)", group = grpH)
htfShowLbls = input.bool(true, "Show HTF HH / HL / LH / LL labels", group = grpH)
htfShowClose= input.bool(true, "Mark HTF confirming candle's CLOSE", group = grpH)
htfMarkW    = input.int(2, "HTF close-marker width", 1, 6, group = grpH)
htfMarkLow  = input.color(color.new(#2962FF, 0), "HTF swing LOW confirm marker",  group = grpH)
htfMarkHigh = input.color(color.new(#FF6D00, 0), "HTF swing HIGH confirm marker", group = grpH)

// bar durations in ms — used to give the close markers a fixed length in time
barMs = timeframe.in_seconds() * 1000
htfMs = timeframe.in_seconds(htfTf) * 1000

// ================================================================ STATE (per timeframe)
var array<int>   pTime = array.new<int>()
var array<float> pPrc  = array.new<float>()
var array<int>   pTyp  = array.new<int>()      // 1 = high, -1 = low
var int   dir  = -1
var float extP = na
var int   extT = na
var float armL = na

var array<int>   hTime = array.new<int>()
var array<float> hPrc  = array.new<float>()
var array<int>   hTyp  = array.new<int>()
var int   dirH   = -1
var float extPH  = na
var int   extTH  = na
var float armLH  = na
var bool  htfInit = false
var float prevHtfH = na
var float prevHtfL = na

// HTF trend bias from HH/HL (bullish) vs LH/LL (bearish)
var float htfPrevHigh = na
var float htfPrevLow  = na
var int   htfBias     = 0

// Per-bar swing signals + the confirming candle's extremes for each source
bool sigLongLTF  = false
bool sigShortLTF = false
bool sigLongHTF  = false
bool sigShortHTF = false
var float confLowLTF  = na
var float confHighLTF = na
var float confLowHTF  = na
var float confHighHTF = na

// ================================================================ DRAWING (shared)
drawPivot(array<int> aTime, array<float> aPrc, array<int> aTyp, int typ, int tx, float prc, int mtx, float mc, bool drawOn, color legUp, color legDn, int legW, bool lbls, bool markOn, color mLow, color mHigh, int mW, float barLenMs, int mLen) =>
    float prevSame = na
    if array.size(aTyp) > 0
        for i = array.size(aTyp) - 1 to 0
            if array.get(aTyp, i) == typ
                prevSame := array.get(aPrc, i)
                break
    string txt = typ == 1 ? (na(prevSame) or prc > prevSame ? "HH" : "LH") : (na(prevSame) or prc < prevSame ? "LL" : "HL")
    color  c   = typ == 1 ? legUp : legDn
    if drawOn and array.size(aTime) > 0
        line.new(array.get(aTime, array.size(aTime) - 1), array.get(aPrc, array.size(aTime) - 1), tx, prc, xloc = xloc.bar_time, color = c, width = legW)
    if drawOn and lbls
        label.new(tx, prc, txt, xloc = xloc.bar_time, style = typ == 1 ? label.style_label_down : label.style_label_up, color = color.new(c, 80), textcolor = c, size = size.small)
    if drawOn and markOn
        line.new(mtx, mc, mtx + int(barLenMs * mLen), mc, xloc = xloc.bar_time, color = typ == -1 ? mLow : mHigh, width = mW)
    array.push(aTime, tx)
    array.push(aPrc, prc)
    array.push(aTyp, typ)

addPivotLTF(int typ, int tx, float prc, int mtx, float mc) =>
    drawPivot(pTime, pPrc, pTyp, typ, tx, prc, mtx, mc, showLTF, upCol, dnCol, lineWidth, showLbls, showClose, markLowCol, markHighCol, markWidth, barMs, markBars)

addPivotHTF(int typ, int tx, float prc, int mtx, float mc) =>
    drawPivot(hTime, hPrc, hTyp, typ, tx, prc, mtx, mc, showHTF, htfUp, htfDn, htfLineW, htfShowLbls, htfShowClose, htfMarkLow, htfMarkHigh, htfMarkW, htfMs, markBars)

// helper: most recent pivot price of a given type (1 = high, -1 = low)
lastPivotPrice(array<int> aTyp, array<float> aPrc, int want) =>
    float r = na
    if array.size(aTyp) > 0
        for i = array.size(aTyp) - 1 to 0
            if array.get(aTyp, i) == want
                r := array.get(aPrc, i)
                break
    r

// ================================================================ CHART-TIMEFRAME ENGINE (always runs -> drives signals)
confirmLow  = confClose ? close > armL : high > armL
confirmHigh = confClose ? close < armL : low  < armL
bearEngulf  = high > high[1] and close < low[1]
bullEngulf  = low  < low[1]  and close > high[1]

if barstate.isfirst
    dir  := -1
    extP := low
    extT := time
    armL := high
else
    if dir == -1
        if useEngulf and bullEngulf
            if low < extP
                extP := low
                extT := time
            addPivotLTF(-1, extT, extP, time, close)
            sigLongLTF := true
            dir  := 1
            extP := high
            extT := time
            armL := low
        else if low < extP
            extP := low
            extT := time
            armL := high
        else if confirmLow
            addPivotLTF(-1, extT, extP, time, close)
            sigLongLTF := true
            dir  := 1
            extP := high
            extT := time
            armL := low
    else
        if useEngulf and bearEngulf
            if high > extP
                extP := high
                extT := time
            addPivotLTF(1, extT, extP, time, close)
            sigShortLTF := true
            dir  := -1
            extP := low
            extT := time
            armL := high
        else if high > extP
            extP := high
            extT := time
            armL := low
        else if confirmHigh
            addPivotLTF(1, extT, extP, time, close)
            sigShortLTF := true
            dir  := -1
            extP := low
            extT := time
            armL := high

if sigLongLTF or sigShortLTF
    confLowLTF  := low
    confHighLTF := high

// ================================================================ HIGHER-TIMEFRAME ENGINE (non-repainting)
[cH, cL, cC, cT] = request.security(syminfo.tickerid, htfTf, [high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)
htfNewBar = ta.change(cT) != 0

if htfNewBar and not na(cT)
    bullEngulfH = useEngulf and not na(prevHtfL) and cL < prevHtfL and cC > prevHtfH
    bearEngulfH = useEngulf and not na(prevHtfH) and cH > prevHtfH and cC < prevHtfL
    if not htfInit
        dirH   := -1
        extPH  := cL
        extTH  := cT
        armLH  := cH
        htfInit := true
    else
        if dirH == -1
            if bullEngulfH
                if cL < extPH
                    extPH := cL
                    extTH := cT
                addPivotHTF(-1, extTH, extPH, cT, cC)
                sigLongHTF := true
                dirH  := 1
                extPH := cH
                extTH := cT
                armLH := cL
            else if cL < extPH
                extPH := cL
                extTH := cT
                armLH := cH
            else if (confClose ? cC > armLH : cH > armLH)
                addPivotHTF(-1, extTH, extPH, cT, cC)
                sigLongHTF := true
                dirH  := 1
                extPH := cH
                extTH := cT
                armLH := cL
        else
            if bearEngulfH
                if cH > extPH
                    extPH := cH
                    extTH := cT
                addPivotHTF(1, extTH, extPH, cT, cC)
                sigShortHTF := true
                dirH  := -1
                extPH := cL
                extTH := cT
                armLH := cH
            else if cH > extPH
                extPH := cH
                extTH := cT
                armLH := cL
            else if (confClose ? cC < armLH : cL < armLH)
                addPivotHTF(1, extTH, extPH, cT, cC)
                sigShortHTF := true
                dirH  := -1
                extPH := cL
                extTH := cT
                armLH := cH
    prevHtfH := cH
    prevHtfL := cL

if sigLongHTF or sigShortHTF
    confLowHTF  := cL
    confHighHTF := cH

// HTF trend bias: HH -> +1, LH -> -1 (from swing highs); HL -> +1, LL -> -1 (from swing lows)
if sigShortHTF
    nh = lastPivotPrice(hTyp, hPrc, 1)
    if not na(htfPrevHigh)
        htfBias := nh > htfPrevHigh ? 1 : nh < htfPrevHigh ? -1 : htfBias
    htfPrevHigh := nh
if sigLongHTF
    nl = lastPivotPrice(hTyp, hPrc, -1)
    if not na(htfPrevLow)
        htfBias := nl < htfPrevLow ? -1 : nl > htfPrevLow ? 1 : htfBias
    htfPrevLow := nl

// ================================================================ ANCHORED VWAPs (session opens)
grpV      = "Anchored VWAPs"
vTz       = input.string("America/New_York", "Anchor / session timezone", group = grpV)
showAsia  = input.bool(true, "Show Asia VWAP (18:00)",     group = grpV)
showLon   = input.bool(true, "Show London VWAP (02:00)",   group = grpV)
showNy    = input.bool(true, "Show New York VWAP (09:30)", group = grpV)
asiaH     = input.int(18, "Asia open hour",     0, 23, group = grpV)
asiaM     = input.int(0,  "Asia open minute",   0, 59, group = grpV)
lonH      = input.int(2,  "London open hour",   0, 23, group = grpV)
lonM      = input.int(0,  "London open minute", 0, 59, group = grpV)
nyH       = input.int(9,  "New York open hour",   0, 23, group = grpV)
nyM       = input.int(30, "New York open minute", 0, 59, group = grpV)
asiaCol   = input.color(color.new(#ab47bc, 0), "Asia VWAP color",     group = grpV)
lonCol    = input.color(color.new(#ffa726, 0), "London VWAP color",   group = grpV)
nyCol     = input.color(color.new(#26c6da, 0), "New York VWAP color", group = grpV)
vwapWidth = input.int(2, "VWAP line width", 1, 5, group = grpV)

// ---- Trade direction filter (only trade with the selected VWAP trend)
grpF       = "Trade direction filter (VWAP)"
useAsiaDir = input.bool(false, "Only trade in direction of Asia VWAP",     group = grpF)
useLonDir  = input.bool(false, "Only trade in direction of London VWAP",   group = grpF)
useNyDir   = input.bool(false, "Only trade in direction of New York VWAP", group = grpF)
showBias   = input.bool(true,  "Show VWAP trade-bias table",               group = grpF)

newAnchor(int hh, int mm) =>
    a = timestamp(vTz, year(time, vTz), month(time, vTz), dayofmonth(time, vTz), hh, mm)
    time >= a and time[1] < a

avwap(bool reset) =>
    var float pv = 0.0
    var float vv = 0.0
    if reset
        pv := 0.0
        vv := 0.0
    pv += hlc3 * volume
    vv += volume
    vv != 0 ? pv / vv : na

// mitigation tracker: a VWAP is "mitigated" once price moves > buf away from it and later trades back to touch it
mitTrack(float v, bool reset, float buf) =>
    var bool away = false
    var bool mit  = false
    if reset
        away := false
        mit  := false
    if not na(v) and math.abs(close - v) > buf
        away := true
    if away and not na(v) and high >= v and low <= v
        mit := true
    mit

asiaReset = newAnchor(asiaH, asiaM)
lonReset  = newAnchor(lonH,  lonM)
nyReset   = newAnchor(nyH,   nyM)
asiaVwap  = avwap(asiaReset)
lonVwap   = avwap(lonReset)
nyVwap    = avwap(nyReset)

plot(showAsia ? (asiaReset ? na : asiaVwap) : na, "Asia VWAP",     color = asiaCol, linewidth = vwapWidth, style = plot.style_linebr)
plot(showLon  ? (lonReset  ? na : lonVwap)  : na, "London VWAP",   color = lonCol,  linewidth = vwapWidth, style = plot.style_linebr)
plot(showNy   ? (nyReset   ? na : nyVwap)   : na, "New York VWAP", color = nyCol,   linewidth = vwapWidth, style = plot.style_linebr)

vdir(float v) => na(v) ? 0 : close > v ? 1 : close < v ? -1 : 0
dirAsia = vdir(asiaVwap)
dirLon  = vdir(lonVwap)
dirNy   = vdir(nyVwap)

longOK  = (not useAsiaDir or dirAsia == 1)  and (not useLonDir or dirLon == 1)  and (not useNyDir or dirNy == 1)
shortOK = (not useAsiaDir or dirAsia == -1) and (not useLonDir or dirLon == -1) and (not useNyDir or dirNy == -1)
noFilter = not useAsiaDir and not useLonDir and not useNyDir
tradeBias = longOK and not shortOK ? 1 : shortOK and not longOK ? -1 : 0

dtxt(int d) => d == 1 ? "▲ up" : d == -1 ? "▼ down" : "—"
dcol(int d) => d == 1 ? color.teal : d == -1 ? color.red : color.gray
var table biasT = table.new(position.top_right, 2, 5, border_width = 1)
if showBias and barstate.islast
    table.cell(biasT, 0, 0, "VWAP",  text_color = color.white, bgcolor = color.new(color.gray, 20))
    table.cell(biasT, 1, 0, "trend", text_color = color.white, bgcolor = color.new(color.gray, 20))
    table.cell(biasT, 0, 1, "Asia",     text_color = color.white)
    table.cell(biasT, 1, 1, dtxt(dirAsia), text_color = dcol(dirAsia))
    table.cell(biasT, 0, 2, "London",   text_color = color.white)
    table.cell(biasT, 1, 2, dtxt(dirLon),  text_color = dcol(dirLon))
    table.cell(biasT, 0, 3, "New York", text_color = color.white)
    table.cell(biasT, 1, 3, dtxt(dirNy),   text_color = dcol(dirNy))
    string btxt = noFilter ? "no filter" : tradeBias == 1 ? "LONG only" : tradeBias == -1 ? "SHORT only" : "no trade"
    table.cell(biasT, 0, 4, "Allowed", text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(biasT, 1, 4, btxt, text_color = color.yellow, bgcolor = color.new(color.gray, 40))

// ================================================================ DAILY HIGH / LOW + VWAP MITIGATION
grpSL  = "Risk — stop loss"
grpTP  = "Risk — take profit"
grpBE  = "Risk — breakeven"
grpRR  = "Risk — min R:R filter"

mitBufPts = input.float(2, "VWAP 'mitigated' buffer (points)", minval = 0, group = grpSL,
     tooltip="A VWAP counts as mitigated once price moves this many points away from it and later returns to touch it.")

mitAsia = mitTrack(asiaVwap, asiaReset, mitBufPts)
mitLon  = mitTrack(lonVwap,  lonReset,  mitBufPts)
mitNY   = mitTrack(nyVwap,   nyReset,   mitBufPts)

newDay = ta.change(time("D")) != 0
var float dHigh = na
var float dLow  = na
if newDay or na(dHigh)
    dHigh := high
    dLow  := low
else
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)

// ================================================================ STRATEGY — INPUTS
grpT     = "Strategy — trading"
entrySrc = input.string("Chart timeframe", "Entry signal source", options = ["Chart timeframe", "Higher timeframe"], group = grpT)
qty      = input.float(1, "Contracts", minval = 1, group = grpT)
oppExit  = input.bool(true,  "Exit on opposite-direction signal", group = grpT)

// Stop loss
slMethod  = input.string("Previous swing", "Stop loss method", options = ["Points", "Previous swing", "Confirming candle", "Unmitigated VWAP"], group = grpSL,
     tooltip="Previous swing = the pivot the signal formed on. Confirming candle = the candle that broke & confirmed the swing. Unmitigated VWAP = first VWAP (NY->London->Asia) on the protective side that price has not mitigated.")
stopPts   = input.float(20, "Stop loss (points, 'Points' method)", minval = 0, group = grpSL)
slBufferPts = input.float(1, "Stop buffer beyond level (points)", minval = 0, group = grpSL)

// Take profit
tpMethod = input.string("Last swing point", "Take profit method", options = ["Points", "Last swing point", "Today HOD/LOD"], group = grpTP)
tpPts    = input.float(40, "Take profit (points, 'Points' method)", minval = 0, group = grpTP)

// Breakeven
useBE    = input.bool(true, "Move stop to breakeven", group = grpBE)
beMode   = input.string("R multiple", "Breakeven trigger", options = ["R multiple", "Last swing touched"], group = grpBE)
beTrigR  = input.float(1.0, "Breakeven trigger (R multiple)", minval = 0.1, step = 0.1, group = grpBE)
beLockPts= input.float(0, "Lock profit at breakeven (points)", minval = 0, group = grpBE)

// Min R:R filter
useRRFilter = input.bool(true, "Require min room to next swing", group = grpRR)
minRR       = input.float(1.0, "Min reward:risk to next swing (R)", minval = 0.1, step = 0.1, group = grpRR)

// HTF trend alignment
grpAlign    = "Filters — HTF trend alignment"
useHTFalign = input.bool(true, "Only trade WITH the higher-timeframe trend", group = grpAlign,
     tooltip="Longs only when the 15m structure is bullish (HH/HL); shorts only when bearish (LH/LL). Usually the biggest win-rate boost — removes counter-trend trades.")

// Partial profit + structure trail
grpScale   = "Risk — partial profit & trail"
usePartial = input.bool(true,  "Take partial profit (needs qty >= 2)", group = grpScale)
partialR   = input.float(1.0,  "Partial at (R multiple)", minval = 0.1, step = 0.1, group = grpScale)
partialPct = input.float(50,   "Partial size (% of position)", minval = 1, maxval = 99, group = grpScale)
partialBE  = input.bool(true,  "Move stop to breakeven after partial", group = grpScale)
useTrail   = input.bool(true,  "Trail stop on structure after partial", group = grpScale)

// Chop / volatility filters
grpChop      = "Filters — chop / volatility"
useMidday    = input.bool(false, "Skip midday session", group = grpChop)
midStartH    = input.int(12, "Midday start hour",   0, 23, group = grpChop)
midStartM    = input.int(0,  "Midday start minute", 0, 59, group = grpChop)
midEndH      = input.int(13, "Midday end hour",   0, 23, group = grpChop)
midEndM      = input.int(30, "Midday end minute", 0, 59, group = grpChop)
useVwapDist  = input.bool(false, "Require min distance from NY VWAP", group = grpChop)
vwapDistPts  = input.float(5, "Min distance from NY VWAP (points)", minval = 0, group = grpChop)
useAtrFilter = input.bool(false, "Require minimum ATR", group = grpChop)
atrLen       = input.int(14, "ATR length", 1, group = grpChop)
minAtrPts    = input.float(5, "Minimum ATR (points)", minval = 0, group = grpChop)

// Session times
grpTime   = "Strategy — session times (in Anchor timezone)"
entStartH = input.int(9,  "Entry window START hour",   0, 23, group = grpTime)
entStartM = input.int(30, "Entry window START minute", 0, 59, group = grpTime)
cutH      = input.int(15, "Entry CUTOFF hour",   0, 23, group = grpTime)
cutM      = input.int(0,  "Entry CUTOFF minute", 0, 59, group = grpTime)
useFlat   = input.bool(true, "Force flat at session end", group = grpTime)
flatH     = input.int(15, "Flatten hour",   0, 23, group = grpTime)
flatM     = input.int(55, "Flatten minute", 0, 59, group = grpTime)

// ================================================================ STRATEGY — ENGINE
tod           = hour(time, vTz) * 60 + minute(time, vTz)
inEntryWindow = tod >= (entStartH * 60 + entStartM) and tod <= (cutH * 60 + cutM)
flatten       = useFlat and tod >= (flatH * 60 + flatM)

// ---- HTF trend alignment + chop/volatility filters
htfLongOK  = not useHTFalign or htfBias == 1
htfShortOK = not useHTFalign or htfBias == -1

atrVal   = ta.atr(atrLen)
inMidday = useMidday and tod >= (midStartH * 60 + midStartM) and tod < (midEndH * 60 + midEndM)
farVwap  = not useVwapDist or na(nyVwap) or math.abs(close - nyVwap) >= vwapDistPts
okAtr    = not useAtrFilter or (not na(atrVal) and atrVal >= minAtrPts)
chopOK   = not inMidday and farVwap and okAtr

longSignal  = entrySrc == "Higher timeframe" ? sigLongHTF  : sigLongLTF
shortSignal = entrySrc == "Higher timeframe" ? sigShortHTF : sigShortLTF

// pivots / confirming candle from the selected source
useLTFsrc = entrySrc != "Higher timeframe"
lastHigh  = useLTFsrc ? lastPivotPrice(pTyp, pPrc, 1)  : lastPivotPrice(hTyp, hPrc, 1)
lastLow   = useLTFsrc ? lastPivotPrice(pTyp, pPrc, -1) : lastPivotPrice(hTyp, hPrc, -1)
cLow      = useLTFsrc ? confLowLTF  : confLowHTF
cHigh     = useLTFsrc ? confHighLTF : confHighHTF
entryPx   = close

// live count + newest swing point of the selected source (for BE "last swing touched")
selSize      = useLTFsrc ? array.size(pTyp) : array.size(hTyp)
selLastSwing = useLTFsrc ? (array.size(pPrc) > 0 ? array.get(pPrc, array.size(pPrc) - 1) : na) : (array.size(hPrc) > 0 ? array.get(hPrc, array.size(hPrc) - 1) : na)

// ---- STOP price for a potential entry this bar (per chosen method)
float longStopCalc = na
if slMethod == "Points"
    longStopCalc := entryPx - stopPts
else if slMethod == "Previous swing"
    longStopCalc := na(lastLow) ? na : lastLow - slBufferPts
else if slMethod == "Confirming candle"
    longStopCalc := na(cLow) ? na : cLow - slBufferPts
else
    longStopCalc := (not mitNY and nyVwap < entryPx) ? nyVwap - slBufferPts : (not mitLon and lonVwap < entryPx) ? lonVwap - slBufferPts : (not mitAsia and asiaVwap < entryPx) ? asiaVwap - slBufferPts : na

float shortStopCalc = na
if slMethod == "Points"
    shortStopCalc := entryPx + stopPts
else if slMethod == "Previous swing"
    shortStopCalc := na(lastHigh) ? na : lastHigh + slBufferPts
else if slMethod == "Confirming candle"
    shortStopCalc := na(cHigh) ? na : cHigh + slBufferPts
else
    shortStopCalc := (not mitNY and nyVwap > entryPx) ? nyVwap + slBufferPts : (not mitLon and lonVwap > entryPx) ? lonVwap + slBufferPts : (not mitAsia and asiaVwap > entryPx) ? asiaVwap + slBufferPts : na

// ---- TARGET price (per chosen method)
float longTPCalc = na
if tpMethod == "Points"
    longTPCalc := entryPx + tpPts
else if tpMethod == "Last swing point"
    longTPCalc := lastHigh
else
    longTPCalc := dHigh

float shortTPCalc = na
if tpMethod == "Points"
    shortTPCalc := entryPx - tpPts
else if tpMethod == "Last swing point"
    shortTPCalc := lastLow
else
    shortTPCalc := dLow

// ---- risk + room-to-next-swing (for the min R:R filter)
longRisk   = na(longStopCalc)  ? na : math.abs(entryPx - longStopCalc)
shortRisk  = na(shortStopCalc) ? na : math.abs(entryPx - shortStopCalc)
longRoom   = na(lastHigh) ? na : lastHigh - entryPx     // distance up to next swing high
shortRoom  = na(lastLow)  ? na : entryPx - lastLow      // distance down to next swing low

passRRlong  = not useRRFilter or (not na(longRoom)  and not na(longRisk)  and longRisk  > 0 and longRoom  >= minRR * longRisk)
passRRshort = not useRRFilter or (not na(shortRoom) and not na(shortRisk) and shortRisk > 0 and shortRoom >= minRR * shortRisk)

// ---- position-level stored risk levels
var float curStop  = na
var float curTP    = na
var float curEntry = na
var float curRisk  = na
var int   entPivCnt = 0   // swing count at entry -> BE waits for a NEW swing after entry
var bool  beDone   = false
var bool  partialDone = false

canEnterLong  = longSignal  and longOK  and htfLongOK  and chopOK and inEntryWindow and not flatten and not na(longStopCalc)  and passRRlong
canEnterShort = shortSignal and shortOK and htfShortOK and chopOK and inEntryWindow and not flatten and not na(shortStopCalc) and passRRshort

// ---- ENTRIES (gated by cutoff window + VWAP filter + min R:R)
if canEnterLong
    strategy.entry("L", strategy.long, qty = qty)
    curStop  := longStopCalc
    curTP    := longTPCalc
    curEntry := entryPx
    curRisk  := longRisk
    entPivCnt := selSize
    beDone   := false
    partialDone := false
if canEnterShort
    strategy.entry("S", strategy.short, qty = qty)
    curStop  := shortStopCalc
    curTP    := shortTPCalc
    curEntry := entryPx
    curRisk  := shortRisk
    entPivCnt := selSize
    beDone   := false
    partialDone := false

// ---- BREAKEVEN: raise stop to entry(+lock) at R-multiple or when target swing is touched
posLong  = strategy.position_size > 0
posShort = strategy.position_size < 0
if useBE and not beDone and (posLong or posShort) and not na(curEntry)
    bool trig = false
    if beMode == "R multiple" and not na(curRisk)
        trig := posLong ? high >= curEntry + beTrigR * curRisk : low <= curEntry - beTrigR * curRisk
    else if beMode == "Last swing touched"
        // a NEW swing must have formed after entry, and price must touch it
        trig := selSize > entPivCnt and not na(selLastSwing) and high >= selLastSwing and low <= selLastSwing
    if trig
        float bePrice = posLong ? curEntry + beLockPts : curEntry - beLockPts
        curStop := posLong ? math.max(curStop, bePrice) : math.min(curStop, bePrice)
        beDone  := true

// ---- PARTIAL PROFIT: close a fraction at partialR, then (optionally) move stop to breakeven
if usePartial and not partialDone and (posLong or posShort) and not na(curRisk) and not na(curEntry)
    hitL = posLong  and high >= curEntry + partialR * curRisk
    hitS = posShort and low  <= curEntry - partialR * curRisk
    if hitL or hitS
        int closeQty = int(math.max(1, math.round(qty * partialPct / 100)))
        if closeQty < math.abs(strategy.position_size)
            strategy.close(posLong ? "L" : "S", qty = closeQty, comment = "TP1")
            partialDone := true
            if partialBE
                curStop := posLong ? math.max(curStop, curEntry + beLockPts) : math.min(curStop, curEntry - beLockPts)

// ---- STRUCTURE TRAIL: after the partial, trail the runner's stop to the latest swing
if useTrail and partialDone and (posLong or posShort)
    if posLong and not na(lastLow)
        curStop := math.max(curStop, lastLow - slBufferPts)
    if posShort and not na(lastHigh)
        curStop := math.min(curStop, lastHigh + slBufferPts)

// ---- EXITS — NEVER gated by the cutoff time
// 1) opposite-direction signal
if oppExit and shortSignal
    strategy.close("L", comment = "opp")
if oppExit and longSignal
    strategy.close("S", comment = "opp")

// 2) protective stop / target (stored levels; breakeven-adjusted) stay active while in a position
if not na(curStop) or not na(curTP)
    strategy.exit("L-x", from_entry = "L", stop = curStop, limit = curTP)
    strategy.exit("S-x", from_entry = "S", stop = curStop, limit = curTP)

// 3) forced flat at session end
if flatten
    strategy.close_all(comment = "EOD flat")
