//@version=6
// Break-then-pullback strategy (run on a 5m chart). Runs ORB (15-min) FIRST, then IB (1-hour).
//
// PRIORITY / INTERACTION (when both are enabled):
//   - ORB may enter only BEFORE the IB forms (i.e. before 10:30). Its resting limit is cancelled at 10:30 if unfilled.
//   - If ORB never traded by the time the IB forms -> ORB is abandoned for the day, only IB plays.
//   - If an ORB position is OPEN when the IB forms and the IB is the OPPOSITE direction -> the ORB position is
//     closed first, then the IB setup is armed. (Same direction -> ORB is left to run and IB arms independently.)
//
// PER SETUP (each range, independently configurable below):
//   1) At the range close: bias = low-before-high (long) / high-before-low (short) AND the range close in the
//      top half (long) / bottom half (short) of the range.
//   2) The trade ARMS only AFTER the range level BREAKS. Break type is selectable: "Wick (touch)" or "Close beyond".
//   3) A LIMIT rests at the fib pullback: shallow(0-25%)->25% line, deeper(25-50%)->50% line.
//   4) AVERAGE DOWN (optional): shallow setup -> a 2nd same-size unit at the 50% line.
//   Stop: shallow -> range extreme (100%) ; deeper -> 75% line. Optional breakeven when the range level is reclaimed.
//   TP long/short selectable: range level / +10% / +30% / +50% / HOD-LOD. One setup/day per range, EOD flatten.
//
// PROBABILITY TABLE (bottom right) - two walk-forward studies of how often price REACHES each level:
//   - "From FILL" rows: per range-size bucket, measured from the entry fill to the EOD flatten.
//   - "From PULLBACK" rows: measured from the moment price retraces to the 25% fib (and, separately, the 50% fib)
//     to the EOD flatten - i.e. "given the pullback got this deep, how often did the TP extension print?".
//     N is the number of setups that pulled back that far; the bracket is how often that pullback happens at all.
//
// LIMITATION: a Pine strategy nets all orders into ONE position (no hedging). Same-direction overlaps merge fine;
//   the interaction rules above are what handle the opposite-direction ORB/IB case (ORB is closed, not hedged).
strategy("Break-then-Pullback (ORB + IB)", overlay = true, pyramiding = 6, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500,
     initial_capital = 30000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)
// NOTE: position sizing uses a FIXED account size (see 'Account size $' input) - it does NOT compound with P&L.

// ---------------------------------------------------------------- Strategy toggles (isolate each for backtesting)
gStrat    = "Strategies (toggle to track each separately)"
runORB    = input.bool(true, "Run ORB strategy", group = gStrat, tooltip = "Turn OFF to backtest the IB strategy alone in the Strategy Tester.")
runIB     = input.bool(true, "Run IB strategy",  group = gStrat, tooltip = "Turn OFF to backtest the ORB strategy alone.")

// ---------------------------------------------------------------- Trade-day filters (see which weekday hurts each)
gDayO     = "Trade days - ORB"
orbMon    = input.bool(true, "ORB Monday",    group = gDayO)
orbTue    = input.bool(true, "ORB Tuesday",   group = gDayO)
orbWed    = input.bool(true, "ORB Wednesday", group = gDayO)
orbThu    = input.bool(true, "ORB Thursday",  group = gDayO)
orbFri    = input.bool(true, "ORB Friday",    group = gDayO)
gDayI     = "Trade days - IB"
ibMon     = input.bool(true, "IB Monday",    group = gDayI)
ibTue     = input.bool(true, "IB Tuesday",   group = gDayI)
ibWed     = input.bool(true, "IB Wednesday", group = gDayI)
ibThu     = input.bool(true, "IB Thursday",  group = gDayI)
ibFri     = input.bool(true, "IB Friday",    group = gDayI)

// ---------------------------------------------------------------- Risk sizing (% of a FIXED capital, no compounding)
gRisk       = "Risk sizing"
useRiskSize = input.bool(false, "Size by % risk (else use the contracts below)", group = gRisk,
     tooltip = "OFF (default): trade exactly the contract counts set below - the R/R tool, the strategy orders and the webhook all use them. ON: ignore those counts and size each entry so its risk = (risk per setup %)/units of the FIXED account size below.")
orbQtyIn    = input.float(2, "ORB contracts per entry", minval = 1, step = 1, group = gRisk,
     tooltip = "Contracts for ONE ORB entry unit. With average-down on, a shallow ORB setup fires two of these units, so the setup's total is 2x this number (the R/R label shows both the per-unit and the setup total).")
ibQtyIn     = input.float(1, "IB contracts per entry", minval = 1, step = 1, group = gRisk,
     tooltip = "Contracts for ONE IB entry unit. With average-down on, a shallow IB setup fires two of these units.")
acctSize    = input.float(30000, "Account size $ (fixed - NO compounding)", minval = 1, group = gRisk,
     tooltip = "Sizing uses this constant capital every day; it does NOT grow/shrink with P&L. So the dollar risk per trade is the same every day (no compounding).")
riskPct     = input.float(1.0, "Risk per setup (% of capital)", minval = 0.1, step = 0.1, group = gRisk,
     tooltip = "Total risk for one strategy's setup, split equally between its entry units. 1% on 30k = $300 = $150 per unit (with average-down on).")
maxDayPct   = input.float(2.0, "Daily max loss (% of capital, 0 = off)", minval = 0, step = 0.5, group = gRisk,
     tooltip = "Once the day's loss reaches this % of the day's starting equity, open trades are closed and no new trades are taken until the next day.")

// ---------------------------------------------------------------- HARDCODED CONFIG (edit values here)
// Session
tz      = "America/New_York"
sess    = "0930-1600"
orbSess = "0930-0945"
ibSess  = "0930-1030"
flatH   = 15
flatM   = 30
// ORB settings
orbLong   = true
orbShort  = true
orbBreak  = "Close beyond"
orbAvg    = true
orbTpL    = "Ext 10%"
orbTpS    = "Ext 30%"
orbDeepSL = "75% line"
orbBE     = false
orbQty    = orbQtyIn          // contracts per ORB unit (from the Risk sizing group)
orbCutH   = 15
orbCutM   = 0
// IB settings
ibLong    = true
ibShort   = true
ibBreak   = "Wick (touch)"
ibAvg     = true
ibTpL     = "Ext 30%"
ibTpS     = "Ext 30%"
ibDeepSL  = "75% line"
ibBE      = false
ibQty     = ibQtyIn           // contracts per IB unit (from the Risk sizing group)
ibCutH    = 14
ibCutM    = 0

// ---------------------------------------------------------------- Filters
gFilt     = "Filters"
noDbl     = input.bool(true, "Skip double-break days (both range sides break)", group = gFilt,
     tooltip = "If the side OPPOSITE the setup direction also breaks (long: price trades below the range low; short: above the range high), cancel the pending entry and take no trade that day. Keeps you to clean one-directional break days only.")

// ---------------------------------------------------------------- Automation (PickMyTrade webhook -> Tradovate)
grpA      = "Automation - PickMyTrade"
autoOn    = input.bool(false, "Enable webhook alerts", group = grpA,
     tooltip = "Create ONE alert with condition 'alert() function calls only' and paste PickMyTrade's webhook URL. Verify the JSON fields match PickMyTrade's template. WARNING: alerts fire on the NET position, so for live automation enable only ONE of ORB/IB at a time.")
pmtToken  = input.string("", "PickMyTrade token", group = grpA)
pmtAcct   = input.string("", "Tradovate account id", group = grpA)
pmtSym    = input.string("MNQ1!", "Broker symbol", group = grpA)
pmtType   = input.string("market", "Order type", options = ["market", "limit"], group = grpA)

// ---------------------------------------------------------------- Break alerts (manual trading)
grpBA     = "Break alerts (manual)"
brkAlerts = input.bool(true, "Alert when ORB / IB level breaks", group = grpBA,
     tooltip = "Fires a notification the moment the ORB or IB range breaks, with the direction and the planned entry/stop/target so you can place the trade yourself. Create ONE alert on this strategy with condition 'alert() function calls only'. (Independent of the PickMyTrade automation above.)")

// ---------------------------------------------------------------- Risk/Reward tool
grpRR     = "Risk / Reward tool"
showRR    = input.bool(true, "Show risk/reward box at the break", group = grpRR)
showFibs  = input.bool(true, "Show fib retracement lines (25/50/75)", group = grpRR, tooltip = "Labels flip by direction: long -> 25% near the top, short -> 25% near the bottom.")
showInfo  = input.bool(true, "Show strategy rules panel", group = grpRR)
ptVal     = input.float(2.0, "$ per point per contract", group = grpRR, tooltip = "MNQ=2, NQ=20, MES=5, ES=50.")
rrBars    = input.int(24, "R/R box width (bars)", 1, 300, group = grpRR)

// ---------------------------------------------------------------- Historical probabilities
grpP      = "Historical probabilities"
showProb  = input.bool(true, "Show hit-probability labels at levels", group = grpP,
     tooltip = "At each break, label the SL lines (100% / 75%) and the TP extensions (0 / 10 / 30 / 50%) with the historical probability that price REACHES them. Each TP label carries three numbers: from the FILL, from the 25% pullback, and from the 50% pullback. All are computed over prior days only (walk-forward).")
showTable = input.bool(true, "Show probability table", group = grpP)
tblPos    = input.string("Bottom right", "Table position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = grpP)
bMode     = input.string("Auto (equal thirds)", "Size buckets", options = ["Auto (equal thirds)", "Manual (%)"], group = grpP,
     tooltip = "Applies to the size-segmented rows only. Range is measured as % of price (range / range-low * 100) so buckets stay comparable as price drifts over time. Auto: split each strategy's own range-% distribution into three equal-count buckets (S/M/L). Manual: use the fixed % thresholds below.")
orbB1     = input.float(0.25, "Manual ORB small/med split (%)", step = 0.05, group = grpP, tooltip = "Used only in Manual mode. ORB range-% below this = Small; between the two = Medium; at/above the med/large split = Large.")
orbB2     = input.float(0.40, "Manual ORB med/large split (%)", step = 0.05, group = grpP)
ibB1      = input.float(0.50, "Manual IB small/med split (%)",  step = 0.05, group = grpP)
ibB2      = input.float(0.80, "Manual IB med/large split (%)",  step = 0.05, group = grpP)
pbSplit   = input.bool(false, "Split the pullback rows by size too", group = grpP,
     tooltip = "OFF (default): one 'after 25% PB' and one 'after 50% PB' row per strategy, pooled across range sizes - the biggest sample, least noise. ON: those rows are repeated per S/M/L bucket (6 rows per strategy); useful once you have a few hundred days, misleading before that.")
autoMode  = bMode == "Auto (equal thirds)"

// ---------------------------------------------------------------- Shared tracking
inSess     = not na(time(timeframe.period, sess, tz))
newSession = inSess and not inSess[1]
var float dHigh = na
var float dLow  = na
if newSession
    dHigh := high
    dLow  := low
else if inSess
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)
tod     = hour(time, tz) * 60 + minute(time, tz)
flatten = tod >= (flatH*60 + flatM)

// fixed-capital sizing (NO compounding) + daily max-loss halt (today's P&L vs today's start equity)
var float dayStartEq = na
if newSession
    dayStartEq := strategy.equity
dayPnL    = strategy.equity - dayStartEq              // today's P&L incl. open
dailyHalt = maxDayPct > 0 and dayPnL <= -(acctSize * maxDayPct / 100.0)

// day-of-week gates (per strategy)
dow      = dayofweek(time, tz)
orbDayOK = (dow == dayofweek.monday and orbMon) or (dow == dayofweek.tuesday and orbTue) or (dow == dayofweek.wednesday and orbWed) or (dow == dayofweek.thursday and orbThu) or (dow == dayofweek.friday and orbFri)
ibDayOK  = (dow == dayofweek.monday and ibMon)  or (dow == dayofweek.tuesday and ibTue)  or (dow == dayofweek.wednesday and ibWed)  or (dow == dayofweek.thursday and ibThu)  or (dow == dayofweek.friday and ibFri)

or_inR   = not na(time(timeframe.period, orbSess, tz))
or_rDone = not or_inR and or_inR[1]
ib_inR   = not na(time(timeframe.period, ibSess, tz))
ib_rDone = not ib_inR and ib_inR[1]
var bool ibFormed = false
if newSession
    ibFormed := false
if ib_rDone
    ibFormed := true

// position sizer: contracts for a given $ budget and stop distance (points).
// round: fractional <= .5 -> down, > .5 -> up (2.1-2.5 -> 2, >2.5 -> 3). Min 1 when the unit's risk >= 0.5%.
f_size(float budget, float ptDist, float unitPct) =>
    perC = ptDist * ptVal
    raw  = perC > 0 ? budget / perC : 0.0
    fr   = raw - math.floor(raw)
    n = fr > 0.5 ? math.ceil(raw) : math.floor(raw)
    n := (unitPct >= 0.5 and n < 1) ? 1 : n
    n

// TP resolver
f_tp(int d, float rH, float rL, float rg, float dHi, float dLo, string tpL, string tpS) =>
    d == 1 ? (tpL == "HOD/LOD" ? dHi : tpL == "Ext 10%" ? rH + 0.10*rg : tpL == "Ext 30%" ? rH + 0.30*rg : tpL == "Ext 50%" ? rH + 0.50*rg : rH) : (tpS == "HOD/LOD" ? dLo : tpS == "Ext 10%" ? rL - 0.10*rg : tpS == "Ext 30%" ? rL - 0.30*rg : tpS == "Ext 50%" ? rL - 0.50*rg : rL)

// ================================================================ Historical-probability stats
// TWO walk-forward studies are collected (a day is only added to the sample after its EOD flatten, so the numbers
// shown on any bar never contain data from that day or later):
//
//   A) FILL -> EOD, segmented by range size. One record per FILLED trade: did price TOUCH each level between the
//      fill and the EOD flatten? Range is stored as % of price (range / range-low * 100) so the S/M/L buckets stay
//      comparable as price drifts over the years. These are the "size" rows of the table.
//
//   B) PULLBACK -> EOD. One record per ARMED setup (break + all filters passed). It answers: once price has
//      retraced to the 25% fib, how often does it go on to tag each TP extension? And the same from the 50% fib.
//      A level counts only if it is touched on a bar AFTER the bar that reached the pullback, so the pullback is
//      never "confirmed" by the same candle that also runs to target (conservative - a 5m bar that pulls back and
//      rips to the extension in one candle is not counted). The 50% line can only be reached through the 25% line,
//      so the "after 50%" sample is always a subset of the "after 25%" one.
//      Read a cell as: "of the setups that pulled back this far, X% later traded to that level (before 15:30 ET)".
//      SL columns use the same conditioning, so a row shows the reward AND the risk that follow the pullback.
f_pct(int hit, int n) => n > 0 ? 100.0 * hit / n : na
f_pctStr(int hit, int n) =>
    p = f_pct(hit, n)
    na(p) ? "-" : str.tostring(p, "#") + "%"

// ---- study A: one record per filled trade -------------------------------------------------------------------
var tRng   = array.new_float(0)
var tStrat = array.new_int(0)
var tSL100 = array.new_int(0)
var tSL75  = array.new_int(0)
var tTP0   = array.new_int(0)
var tTP10  = array.new_int(0)
var tTP30  = array.new_int(0)
var tTP50  = array.new_int(0)

f_pushTrade(int s, float rng, bool s100, bool s75, bool t0, bool t10, bool t30, bool t50) =>
    array.push(tRng,   rng)
    array.push(tStrat, s)
    array.push(tSL100, s100 ? 1 : 0)
    array.push(tSL75,  s75  ? 1 : 0)
    array.push(tTP0,   t0   ? 1 : 0)
    array.push(tTP10,  t10  ? 1 : 0)
    array.push(tTP30,  t30  ? 1 : 0)
    array.push(tTP50,  t50  ? 1 : 0)

// ranges recorded so far for one strategy (walk-forward: only days finalized before now)
f_ranges(int s) =>
    tmp = array.new_float(0)
    if array.size(tRng) > 0
        for i = 0 to array.size(tRng) - 1
            if array.get(tStrat, i) == s
                array.push(tmp, array.get(tRng, i))
    tmp

// tercile boundaries for a strategy (na until >=3 samples); in manual mode the caller passes fixed thresholds
f_b1(array<float> rr) => array.size(rr) < 3 ? na : array.percentile_linear_interpolation(rr, 33.33333)
f_b2(array<float> rr) => array.size(rr) < 3 ? na : array.percentile_linear_interpolation(rr, 66.66667)
f_bkt(float rng, float b1, float b2) => (na(b1) or na(b2)) ? 0 : rng < b1 ? 0 : rng < b2 ? 1 : 2

// counts [n, sl100, sl75, tp0, tp10, tp30, tp50] for one strategy+bucket given the boundaries
f_seg(int s, int bkt, float b1, float b2) =>
    nn = 0
    a0 = 0
    a1 = 0
    a2 = 0
    a3 = 0
    a4 = 0
    a5 = 0
    if array.size(tRng) > 0
        for i = 0 to array.size(tRng) - 1
            if array.get(tStrat, i) == s and f_bkt(array.get(tRng, i), b1, b2) == bkt
                nn := nn + 1
                a0 := a0 + array.get(tSL100, i)
                a1 := a1 + array.get(tSL75,  i)
                a2 := a2 + array.get(tTP0,   i)
                a3 := a3 + array.get(tTP10,  i)
                a4 := a4 + array.get(tTP30,  i)
                a5 := a5 + array.get(tTP50,  i)
    [nn, a0, a1, a2, a3, a4, a5]

// ---- study B: one record per armed setup, conditioned on how deep the pullback went --------------------------
type PbRec
    int   strat    = 0
    float rngPct   = na
    bool  r25      = false      // price retraced to the 25% fib after the break
    bool  r50      = false      // ... and to the 50% fib
    bool  a25sl100 = false      // levels touched AFTER the 25% retrace
    bool  a25sl75  = false
    bool  a25tp0   = false
    bool  a25tp10  = false
    bool  a25tp30  = false
    bool  a25tp50  = false
    bool  a50sl100 = false      // levels touched AFTER the 50% retrace
    bool  a50sl75  = false
    bool  a50tp0   = false
    bool  a50tp10  = false
    bool  a50tp30  = false
    bool  a50tp50  = false

type PbTrk
    bool  active = false
    int   dir    = 0
    float pb25   = na
    float pb50   = na
    float sl100  = na
    float sl75   = na
    float tp0    = na
    float tp10   = na
    float tp30   = na
    float tp50   = na
    PbRec rec    = na

var array<PbRec> pbRecs = array.new<PbRec>()

// arm the tracker at the break (levels are fixed for the rest of the day)
f_pbArm(PbTrk t, int s, int d, float rH, float rL, float rng) =>
    t.active := true
    t.dir    := d
    t.pb25   := rL + (d == 1 ? 0.75 : 0.25) * rng    // 25% retracement of the range, direction-relative
    t.pb50   := rL + 0.50 * rng
    t.sl100  := d == 1 ? rL : rH
    t.sl75   := rL + (d == 1 ? 0.25 : 0.75) * rng
    t.tp0    := d == 1 ? rH : rL
    t.tp10   := d == 1 ? rH + 0.10*rng : rL - 0.10*rng
    t.tp30   := d == 1 ? rH + 0.30*rng : rL - 0.30*rng
    t.tp50   := d == 1 ? rH + 0.50*rng : rL - 0.50*rng
    t.rec    := PbRec.new(strat = s, rngPct = rL > 0 ? rng / rL * 100 : na)

// one bar of tracking. Level touches are evaluated against the retrace flags as they stood BEFORE this bar, so the
// bar that reaches the pullback cannot also supply the TP hit.
f_pbTrack(PbTrk t) =>
    if t.active
        up = t.dir == 1
        if t.rec.r25
            t.rec.a25tp0   := t.rec.a25tp0   or (up ? high >= t.tp0   : low  <= t.tp0)
            t.rec.a25tp10  := t.rec.a25tp10  or (up ? high >= t.tp10  : low  <= t.tp10)
            t.rec.a25tp30  := t.rec.a25tp30  or (up ? high >= t.tp30  : low  <= t.tp30)
            t.rec.a25tp50  := t.rec.a25tp50  or (up ? high >= t.tp50  : low  <= t.tp50)
            t.rec.a25sl75  := t.rec.a25sl75  or (up ? low  <= t.sl75  : high >= t.sl75)
            t.rec.a25sl100 := t.rec.a25sl100 or (up ? low  <= t.sl100 : high >= t.sl100)
        if t.rec.r50
            t.rec.a50tp0   := t.rec.a50tp0   or (up ? high >= t.tp0   : low  <= t.tp0)
            t.rec.a50tp10  := t.rec.a50tp10  or (up ? high >= t.tp10  : low  <= t.tp10)
            t.rec.a50tp30  := t.rec.a50tp30  or (up ? high >= t.tp30  : low  <= t.tp30)
            t.rec.a50tp50  := t.rec.a50tp50  or (up ? high >= t.tp50  : low  <= t.tp50)
            t.rec.a50sl75  := t.rec.a50sl75  or (up ? low  <= t.sl75  : high >= t.sl75)
            t.rec.a50sl100 := t.rec.a50sl100 or (up ? low  <= t.sl100 : high >= t.sl100)
        if not t.rec.r25 and (up ? low <= t.pb25 : high >= t.pb25)
            t.rec.r25 := true
        if not t.rec.r50 and (up ? low <= t.pb50 : high >= t.pb50)
            t.rec.r50 := true

// file the record at the EOD flatten (once)
f_pbClose(PbTrk t) =>
    if t.active
        array.push(pbRecs, t.rec)
        t.active := false

// counts for one strategy at one pullback depth. depth 0 = reached the 25% fib, 1 = reached the 50% fib.
// bkt = -1 pools all range sizes; 0/1/2 restricts to the S/M/L bucket defined by b1/b2.
// Returns [setups in scope, setups that reached the pullback, then SL100, SL75, TP0, TP10, TP30, TP50 counts].
f_pbSeg(int s, int depth, int bkt, float b1, float b2) =>
    nAll = 0
    nn   = 0
    a0 = 0
    a1 = 0
    a2 = 0
    a3 = 0
    a4 = 0
    a5 = 0
    if array.size(pbRecs) > 0
        for i = 0 to array.size(pbRecs) - 1
            r = array.get(pbRecs, i)
            if r.strat == s and (bkt < 0 or f_bkt(r.rngPct, b1, b2) == bkt)
                nAll := nAll + 1
                if (depth == 0 ? r.r25 : r.r50)
                    nn := nn + 1
                    a0 := a0 + ((depth == 0 ? r.a25sl100 : r.a50sl100) ? 1 : 0)
                    a1 := a1 + ((depth == 0 ? r.a25sl75  : r.a50sl75)  ? 1 : 0)
                    a2 := a2 + ((depth == 0 ? r.a25tp0   : r.a50tp0)   ? 1 : 0)
                    a3 := a3 + ((depth == 0 ? r.a25tp10  : r.a50tp10)  ? 1 : 0)
                    a4 := a4 + ((depth == 0 ? r.a25tp30  : r.a50tp30)  ? 1 : 0)
                    a5 := a5 + ((depth == 0 ? r.a25tp50  : r.a50tp50)  ? 1 : 0)
    [nAll, nn, a0, a1, a2, a3, a4, a5]

// ================================================================ ORB ENGINE (runs first)
var float or_rH = na
var float or_rL = na
var int   or_rHbar = na
var int   or_rLbar = na
var int   or_dir = 0
var bool  or_shallow = false
var float or_e1 = na
var float or_e2 = na
var float or_zstop = na
var float or_rng = na
var bool  or_broke = false
var bool  or_placed = false
var bool  or_f1 = false
var bool  or_f2 = false
var float or_avgPx = na
var float or_curStop = na
var float or_curTP = na
var bool  or_beDone = false
var bool  or_closed = false
var bool  or_oppBroke = false
var float orbSz1 = na
var float orbSz2 = na

if newSession
    or_rH := na
    or_rL := na
    or_dir := 0
    or_shallow := false
    or_e1 := na
    or_e2 := na
    or_zstop := na
    or_rng := na
    or_broke := false
    or_placed := false
    or_f1 := false
    or_f2 := false
    or_avgPx := na
    or_curStop := na
    or_curTP := na
    or_beDone := false
    or_closed := false
    or_oppBroke := false
    orbSz1 := na
    orbSz2 := na
if or_inR
    if na(or_rH) or high > or_rH
        or_rH := high
        or_rHbar := bar_index
    if na(or_rL) or low < or_rL
        or_rL := low
        or_rLbar := bar_index
if or_rDone and not na(or_rH) and or_rH > or_rL
    or_rng := or_rH - or_rL
    or_lf = or_rLbar < or_rHbar
    or_pos = (close[1] - or_rL) / or_rng
    if orbLong and or_lf and or_pos >= 0.5
        or_dir := 1
        or_shallow := or_pos >= 0.75
        or_e1 := or_shallow ? or_rL + 0.75*or_rng : or_rL + 0.5*or_rng
        or_e2 := or_rL + 0.5*or_rng
        or_zstop := or_shallow ? or_rL : (orbDeepSL == "75% line" ? or_rL + 0.25*or_rng : or_rL)
    else if orbShort and (not or_lf) and or_pos <= 0.5
        or_dir := -1
        or_shallow := or_pos <= 0.25
        or_e1 := or_shallow ? or_rL + 0.25*or_rng : or_rL + 0.5*or_rng
        or_e2 := or_rL + 0.5*or_rng
        or_zstop := or_shallow ? or_rH : (orbDeepSL == "75% line" ? or_rL + 0.75*or_rng : or_rH)
    if or_dir != 0
        orbU  = (orbAvg and or_shallow) ? 2 : 1                          // units this setup will use
        orbBud = acctSize * (riskPct/100.0) / orbU                         // $ risk budget per unit
        orbUPct = riskPct / orbU
        orbSz1 := useRiskSize ? f_size(orbBud, math.abs(or_e1 - or_zstop), orbUPct) : orbQty
        orbSz2 := useRiskSize ? f_size(orbBud, math.abs(or_e2 - or_zstop), orbUPct) : orbQty
or_useAdd = orbAvg and or_shallow and not na(or_e2)
// break by selected type
or_brk = orbBreak == "Wick (touch)" ? ((or_dir == 1 and high >= or_rH) or (or_dir == -1 and low <= or_rL)) : ((or_dir == 1 and close > or_rH) or (or_dir == -1 and close < or_rL))
if or_dir != 0 and or_brk
    or_broke := true
// double-break detection: opposite range extreme is violated
if or_dir == 1 and low < or_rL
    or_oppBroke := true
if or_dir == -1 and high > or_rH
    or_oppBroke := true
// entry window: before IB forms (when IB is on), within ORB cutoff otherwise, on an allowed weekday
orbWin = inSess and orbDayOK and tod <= (orbCutH*60 + orbCutM) and (not runIB or not ibFormed) and not dailyHalt
if runORB and or_dir != 0 and or_broke and not or_placed and not or_closed and orbWin and not flatten and (not noDbl or not or_oppBroke) and orbSz1 >= 1
    if or_dir == 1
        strategy.entry("ORL", strategy.long, qty = orbSz1, limit = or_e1)
        if or_useAdd and orbSz2 >= 1
            strategy.entry("ORL2", strategy.long, qty = orbSz2, limit = or_e2)
    else
        strategy.entry("ORS", strategy.short, qty = orbSz1, limit = or_e1)
        if or_useAdd and orbSz2 >= 1
            strategy.entry("ORS2", strategy.short, qty = orbSz2, limit = or_e2)
    or_placed := true
if or_placed and not or_closed
    if or_dir == 1
        if not or_f1 and low <= or_e1
            or_f1 := true
        if or_useAdd and not or_f2 and low <= or_e2
            or_f2 := true
    if or_dir == -1
        if not or_f1 and high >= or_e1
            or_f1 := true
        if or_useAdd and not or_f2 and high >= or_e2
            or_f2 := true
or_firstFill = (or_f1 or or_f2) and not (or_f1[1] or or_f2[1])
if or_f1 or or_f2
    or_avgPx := or_f1 and or_f2 ? (or_e1 + or_e2) / 2 : or_f1 ? or_e1 : or_e2
if or_firstFill
    or_curStop := or_zstop
    or_curTP := f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    or_beDone := false
if orbBE and not or_beDone and (or_f1 or or_f2) and not or_closed
    if or_dir == 1 and high >= or_rH
        or_curStop := math.max(or_curStop, or_avgPx)
        or_beDone := true
    if or_dir == -1 and low <= or_rL
        or_curStop := math.min(or_curStop, or_avgPx)
        or_beDone := true
if not na(or_curStop)
    strategy.exit("ORLx",  from_entry = "ORL",  stop = or_curStop, limit = or_curTP)
    strategy.exit("ORL2x", from_entry = "ORL2", stop = or_curStop, limit = or_curTP)
    strategy.exit("ORSx",  from_entry = "ORS",  stop = or_curStop, limit = or_curTP)
    strategy.exit("ORS2x", from_entry = "ORS2", stop = or_curStop, limit = or_curTP)
if (or_f1 or or_f2) and not or_closed and not na(or_curStop)
    if or_dir == 1 and (low <= or_curStop or high >= or_curTP)
        or_closed := true
    if or_dir == -1 and (high >= or_curStop or low <= or_curTP)
        or_closed := true
// cancel resting ORB entries once the window closes unfilled, or done/flat/off/double-break
if or_closed or flatten or not runORB or (noDbl and or_oppBroke) or ((not orbWin) and not (or_f1 or or_f2))
    strategy.cancel("ORL")
    strategy.cancel("ORL2")
    strategy.cancel("ORS")
    strategy.cancel("ORS2")

// ---- ORB study A: from the fill to EOD, did price touch each level? ----
var bool  or_trk    = false
var int   or_tdir   = 0
var float orL_sl100 = na
var float orL_sl75  = na
var float orL_tp0   = na
var float orL_tp10  = na
var float orL_tp30  = na
var float orL_tp50  = na
var bool  orR_sl100 = false
var bool  orR_sl75  = false
var bool  orR_tp0   = false
var bool  orR_tp10  = false
var bool  orR_tp30  = false
var bool  orR_tp50  = false
if newSession
    or_trk := false
if or_firstFill and not na(or_rng)
    or_trk    := true
    or_tdir   := or_dir
    orL_sl100 := or_dir == 1 ? or_rL : or_rH
    orL_sl75  := or_rL + (or_dir == 1 ? 0.25 : 0.75) * or_rng
    orL_tp0   := or_dir == 1 ? or_rH : or_rL
    orL_tp10  := or_dir == 1 ? or_rH + 0.10*or_rng : or_rL - 0.10*or_rng
    orL_tp30  := or_dir == 1 ? or_rH + 0.30*or_rng : or_rL - 0.30*or_rng
    orL_tp50  := or_dir == 1 ? or_rH + 0.50*or_rng : or_rL - 0.50*or_rng
    orR_sl100 := false
    orR_sl75  := false
    orR_tp0   := false
    orR_tp10  := false
    orR_tp30  := false
    orR_tp50  := false
if or_trk
    if or_tdir == 1
        orR_tp0   := orR_tp0   or high >= orL_tp0
        orR_tp10  := orR_tp10  or high >= orL_tp10
        orR_tp30  := orR_tp30  or high >= orL_tp30
        orR_tp50  := orR_tp50  or high >= orL_tp50
        orR_sl75  := orR_sl75  or low  <= orL_sl75
        orR_sl100 := orR_sl100 or low  <= orL_sl100
    else
        orR_tp0   := orR_tp0   or low  <= orL_tp0
        orR_tp10  := orR_tp10  or low  <= orL_tp10
        orR_tp30  := orR_tp30  or low  <= orL_tp30
        orR_tp50  := orR_tp50  or low  <= orL_tp50
        orR_sl75  := orR_sl75  or high >= orL_sl75
        orR_sl100 := orR_sl100 or high >= orL_sl100
    if flatten
        f_pushTrade(0, or_rng / or_rL * 100, orR_sl100, orR_sl75, orR_tp0, orR_tp10, orR_tp30, orR_tp50)
        or_trk := false

// ---- ORB study B: armed -> 25%/50% pullback -> TP/SL, filed at the EOD flatten ----
var PbTrk orPb = PbTrk.new()
if newSession
    orPb.active := false
if or_placed and not or_placed[1] and or_dir != 0 and not na(or_rng)
    f_pbArm(orPb, 0, or_dir, or_rH, or_rL, or_rng)
f_pbTrack(orPb)
if flatten
    f_pbClose(orPb)

// ================================================================ IB ENGINE
var float ib_rH = na
var float ib_rL = na
var int   ib_rHbar = na
var int   ib_rLbar = na
var int   ib_dir = 0
var bool  ib_shallow = false
var float ib_e1 = na
var float ib_e2 = na
var float ib_zstop = na
var float ib_rng = na
var bool  ib_broke = false
var bool  ib_placed = false
var bool  ib_f1 = false
var bool  ib_f2 = false
var float ib_avgPx = na
var float ib_curStop = na
var float ib_curTP = na
var bool  ib_beDone = false
var bool  ib_closed = false
var bool  ib_oppBroke = false
var float ibSz1 = na
var float ibSz2 = na

if newSession
    ib_rH := na
    ib_rL := na
    ib_dir := 0
    ib_shallow := false
    ib_e1 := na
    ib_e2 := na
    ib_zstop := na
    ib_rng := na
    ib_broke := false
    ib_placed := false
    ib_f1 := false
    ib_f2 := false
    ib_avgPx := na
    ib_curStop := na
    ib_curTP := na
    ib_beDone := false
    ib_closed := false
    ib_oppBroke := false
    ibSz1 := na
    ibSz2 := na
if ib_inR
    if na(ib_rH) or high > ib_rH
        ib_rH := high
        ib_rHbar := bar_index
    if na(ib_rL) or low < ib_rL
        ib_rL := low
        ib_rLbar := bar_index
if ib_rDone and not na(ib_rH) and ib_rH > ib_rL
    ib_rng := ib_rH - ib_rL
    ib_lf = ib_rLbar < ib_rHbar
    ib_pos = (close[1] - ib_rL) / ib_rng
    if ibLong and ib_lf and ib_pos >= 0.5
        ib_dir := 1
        ib_shallow := ib_pos >= 0.75
        ib_e1 := ib_shallow ? ib_rL + 0.75*ib_rng : ib_rL + 0.5*ib_rng
        ib_e2 := ib_rL + 0.5*ib_rng
        ib_zstop := ib_shallow ? ib_rL : (ibDeepSL == "75% line" ? ib_rL + 0.25*ib_rng : ib_rL)
    else if ibShort and (not ib_lf) and ib_pos <= 0.5
        ib_dir := -1
        ib_shallow := ib_pos <= 0.25
        ib_e1 := ib_shallow ? ib_rL + 0.25*ib_rng : ib_rL + 0.5*ib_rng
        ib_e2 := ib_rL + 0.5*ib_rng
        ib_zstop := ib_shallow ? ib_rH : (ibDeepSL == "75% line" ? ib_rL + 0.75*ib_rng : ib_rH)
    if ib_dir != 0
        ibU  = (ibAvg and ib_shallow) ? 2 : 1
        ibBud = acctSize * (riskPct/100.0) / ibU
        ibUPct = riskPct / ibU
        ibSz1 := useRiskSize ? f_size(ibBud, math.abs(ib_e1 - ib_zstop), ibUPct) : ibQty
        ibSz2 := useRiskSize ? f_size(ibBud, math.abs(ib_e2 - ib_zstop), ibUPct) : ibQty
// INTERACTION: on IB formation, resolve ORB vs IB
if ib_rDone and runIB and runORB
    or_open = (or_f1 or or_f2) and not or_closed
    if or_open and ib_dir != 0 and ib_dir == -or_dir
        strategy.close("ORL",  comment = "ORB->IB flip")
        strategy.close("ORL2", comment = "ORB->IB flip")
        strategy.close("ORS",  comment = "ORB->IB flip")
        strategy.close("ORS2", comment = "ORB->IB flip")
        or_closed := true
ib_useAdd = ibAvg and ib_shallow and not na(ib_e2)
ib_brk = ibBreak == "Wick (touch)" ? ((ib_dir == 1 and high >= ib_rH) or (ib_dir == -1 and low <= ib_rL)) : ((ib_dir == 1 and close > ib_rH) or (ib_dir == -1 and close < ib_rL))
if ib_dir != 0 and ib_brk
    ib_broke := true
if ib_dir == 1 and low < ib_rL
    ib_oppBroke := true
if ib_dir == -1 and high > ib_rH
    ib_oppBroke := true
ibWin = inSess and ibDayOK and tod <= (ibCutH*60 + ibCutM) and not dailyHalt
if runIB and ib_dir != 0 and ib_broke and not ib_placed and not ib_closed and ibWin and not flatten and (not noDbl or not ib_oppBroke) and ibSz1 >= 1
    if ib_dir == 1
        strategy.entry("IBL", strategy.long, qty = ibSz1, limit = ib_e1)
        if ib_useAdd and ibSz2 >= 1
            strategy.entry("IBL2", strategy.long, qty = ibSz2, limit = ib_e2)
    else
        strategy.entry("IBS", strategy.short, qty = ibSz1, limit = ib_e1)
        if ib_useAdd and ibSz2 >= 1
            strategy.entry("IBS2", strategy.short, qty = ibSz2, limit = ib_e2)
    ib_placed := true
if ib_placed and not ib_closed
    if ib_dir == 1
        if not ib_f1 and low <= ib_e1
            ib_f1 := true
        if ib_useAdd and not ib_f2 and low <= ib_e2
            ib_f2 := true
    if ib_dir == -1
        if not ib_f1 and high >= ib_e1
            ib_f1 := true
        if ib_useAdd and not ib_f2 and high >= ib_e2
            ib_f2 := true
ib_firstFill = (ib_f1 or ib_f2) and not (ib_f1[1] or ib_f2[1])
if ib_f1 or ib_f2
    ib_avgPx := ib_f1 and ib_f2 ? (ib_e1 + ib_e2) / 2 : ib_f1 ? ib_e1 : ib_e2
if ib_firstFill
    ib_curStop := ib_zstop
    ib_curTP := f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    ib_beDone := false
if ibBE and not ib_beDone and (ib_f1 or ib_f2) and not ib_closed
    if ib_dir == 1 and high >= ib_rH
        ib_curStop := math.max(ib_curStop, ib_avgPx)
        ib_beDone := true
    if ib_dir == -1 and low <= ib_rL
        ib_curStop := math.min(ib_curStop, ib_avgPx)
        ib_beDone := true
if not na(ib_curStop)
    strategy.exit("IBLx",  from_entry = "IBL",  stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBL2x", from_entry = "IBL2", stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBSx",  from_entry = "IBS",  stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBS2x", from_entry = "IBS2", stop = ib_curStop, limit = ib_curTP)
if (ib_f1 or ib_f2) and not ib_closed and not na(ib_curStop)
    if ib_dir == 1 and (low <= ib_curStop or high >= ib_curTP)
        ib_closed := true
    if ib_dir == -1 and (high >= ib_curStop or low <= ib_curTP)
        ib_closed := true
if ib_closed or flatten or not runIB or (noDbl and ib_oppBroke) or ((not ibWin) and not (ib_f1 or ib_f2))
    strategy.cancel("IBL")
    strategy.cancel("IBL2")
    strategy.cancel("IBS")
    strategy.cancel("IBS2")

// ---- IB study A: from the fill to EOD, did price touch each level? ----
var bool  ib_trk    = false
var int   ib_tdir   = 0
var float ibL_sl100 = na
var float ibL_sl75  = na
var float ibL_tp0   = na
var float ibL_tp10  = na
var float ibL_tp30  = na
var float ibL_tp50  = na
var bool  ibR_sl100 = false
var bool  ibR_sl75  = false
var bool  ibR_tp0   = false
var bool  ibR_tp10  = false
var bool  ibR_tp30  = false
var bool  ibR_tp50  = false
if newSession
    ib_trk := false
if ib_firstFill and not na(ib_rng)
    ib_trk    := true
    ib_tdir   := ib_dir
    ibL_sl100 := ib_dir == 1 ? ib_rL : ib_rH
    ibL_sl75  := ib_rL + (ib_dir == 1 ? 0.25 : 0.75) * ib_rng
    ibL_tp0   := ib_dir == 1 ? ib_rH : ib_rL
    ibL_tp10  := ib_dir == 1 ? ib_rH + 0.10*ib_rng : ib_rL - 0.10*ib_rng
    ibL_tp30  := ib_dir == 1 ? ib_rH + 0.30*ib_rng : ib_rL - 0.30*ib_rng
    ibL_tp50  := ib_dir == 1 ? ib_rH + 0.50*ib_rng : ib_rL - 0.50*ib_rng
    ibR_sl100 := false
    ibR_sl75  := false
    ibR_tp0   := false
    ibR_tp10  := false
    ibR_tp30  := false
    ibR_tp50  := false
if ib_trk
    if ib_tdir == 1
        ibR_tp0   := ibR_tp0   or high >= ibL_tp0
        ibR_tp10  := ibR_tp10  or high >= ibL_tp10
        ibR_tp30  := ibR_tp30  or high >= ibL_tp30
        ibR_tp50  := ibR_tp50  or high >= ibL_tp50
        ibR_sl75  := ibR_sl75  or low  <= ibL_sl75
        ibR_sl100 := ibR_sl100 or low  <= ibL_sl100
    else
        ibR_tp0   := ibR_tp0   or low  <= ibL_tp0
        ibR_tp10  := ibR_tp10  or low  <= ibL_tp10
        ibR_tp30  := ibR_tp30  or low  <= ibL_tp30
        ibR_tp50  := ibR_tp50  or low  <= ibL_tp50
        ibR_sl75  := ibR_sl75  or high >= ibL_sl75
        ibR_sl100 := ibR_sl100 or high >= ibL_sl100
    if flatten
        f_pushTrade(1, ib_rng / ib_rL * 100, ibR_sl100, ibR_sl75, ibR_tp0, ibR_tp10, ibR_tp30, ibR_tp50)
        ib_trk := false

// ---- IB study B: armed -> 25%/50% pullback -> TP/SL, filed at the EOD flatten ----
var PbTrk ibPb = PbTrk.new()
if newSession
    ibPb.active := false
if ib_placed and not ib_placed[1] and ib_dir != 0 and not na(ib_rng)
    f_pbArm(ibPb, 1, ib_dir, ib_rH, ib_rL, ib_rng)
f_pbTrack(ibPb)
if flatten
    f_pbClose(ibPb)

// ---------------------------------------------------------------- EOD flatten + daily max-loss halt
if flatten
    strategy.close_all(comment = "EOD flat")
if dailyHalt
    strategy.close_all(comment = "Daily max loss")
    strategy.cancel_all()

// ---------------------------------------------------------------- Automation: PickMyTrade webhook JSON (net position)
f_pmt(string act, float q, float slp, float tpp) =>
    '{"token":"' + pmtToken + '","account_id":"' + pmtAcct + '","symbol":"' + pmtSym +
      '","action":"' + act + '","quantity":' + str.tostring(q) +
      ',"order_type":"' + pmtType +
      '","sl":' + str.tostring(math.round_to_mintick(slp)) +
      ',"tp":' + str.tostring(math.round_to_mintick(tpp)) + '}'
liveORB  = (or_f1 or or_f2) and not or_closed
autoStop = liveORB ? or_curStop : ib_curStop
autoTP   = liveORB ? or_curTP  : ib_curTP
autoQty  = math.abs(strategy.position_size)   // actual net contracts (respects % sizing)
buyNow   = strategy.position_size > 0 and (strategy.position_size[1] <= 0 or strategy.position_size > strategy.position_size[1])
sellNow  = strategy.position_size < 0 and (strategy.position_size[1] >= 0 or strategy.position_size < strategy.position_size[1])
closeNow = flatten and strategy.position_size[1] != 0
if autoOn and buyNow
    alert(f_pmt("buy",  autoQty, autoStop, autoTP), alert.freq_once_per_bar)
if autoOn and sellNow
    alert(f_pmt("sell", autoQty, autoStop, autoTP), alert.freq_once_per_bar)
if autoOn and closeNow
    alert(f_pmt("close", 0, 0.0, 0.0), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Break alerts (fire once when each range breaks)
if brkAlerts and runORB and or_dir != 0 and or_broke and not or_broke[1]
    orTPa = f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    alert("ORB BREAK  " + (or_dir == 1 ? "LONG" : "SHORT") +
         "  | broke " + str.tostring(math.round_to_mintick(or_dir == 1 ? or_rH : or_rL)) +
         "  | pullback entry " + str.tostring(math.round_to_mintick(or_e1)) +
         "  | stop " + str.tostring(math.round_to_mintick(or_zstop)) +
         "  | target " + str.tostring(math.round_to_mintick(orTPa)), alert.freq_once_per_bar)
if brkAlerts and runIB and ib_dir != 0 and ib_broke and not ib_broke[1]
    ibTPa = f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    alert("IB BREAK  " + (ib_dir == 1 ? "LONG" : "SHORT") +
         "  | broke " + str.tostring(math.round_to_mintick(ib_dir == 1 ? ib_rH : ib_rL)) +
         "  | pullback entry " + str.tostring(math.round_to_mintick(ib_e1)) +
         "  | stop " + str.tostring(math.round_to_mintick(ib_zstop)) +
         "  | target " + str.tostring(math.round_to_mintick(ibTPa)), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Risk/Reward + fib tool
// Drawn once per setup at the break and PERSIST. Border/line colour: orange = ORB, teal = IB. The label shows the
// $ risk/reward for the configured contracts AND, on a second line, the per-1-contract numbers.
// q = contracts on THIS unit. ent2/q2 describe the average-down unit when there is one (na/0 otherwise) so the
// first box can also print the whole setup's risk and reward for the contracts actually being traded.
f_drawRR(int d, float ent, float zstop, float ptp, float q, color sigCol, string tag, int xoff, float ent2, float q2) =>
    x1 = bar_index + xoff
    x2 = x1 + rrBars
    riskUsd = math.abs(ent - zstop) * ptVal * q
    rewUsd  = math.abs(ptp - ent) * ptVal * q
    risk1   = math.abs(ent - zstop) * ptVal
    rew1    = math.abs(ptp - ent) * ptVal
    rrr = riskUsd > 0 ? rewUsd / riskUsd : na
    rewTop = d == 1 ? ptp : ent
    rewBot = d == 1 ? ent : ptp
    rskTop = d == 1 ? ent : zstop
    rskBot = d == 1 ? zstop : ent
    box.new(x1, rewTop, x2, rewBot, xloc = xloc.bar_index, border_color = sigCol, border_width = 1, bgcolor = color.new(color.green, 82))
    box.new(x1, rskTop, x2, rskBot, xloc = xloc.bar_index, border_color = sigCol, border_width = 1, bgcolor = color.new(color.red, 82))
    txt = tag + "  " + str.tostring(q, "#.#") + " contract" + (q == 1 ? "" : "s") +
         "  Risk $" + str.tostring(riskUsd, "#") + " | Reward $" + str.tostring(rewUsd, "#") + " (" + str.tostring(rrr, "#.##") + "R)" +
         "\n1 contract: Risk $" + str.tostring(risk1, "#") + " | Reward $" + str.tostring(rew1, "#")
    if not na(ent2) and q2 > 0
        totQ = q + q2
        totR = riskUsd + math.abs(ent2 - zstop) * ptVal * q2
        totW = rewUsd  + math.abs(ptp - ent2)  * ptVal * q2
        txt := txt + "\nSetup total " + str.tostring(totQ, "#.#") + " contracts: Risk $" + str.tostring(totR, "#") +
             " | Reward $" + str.tostring(totW, "#") + " (" + str.tostring(totR > 0 ? totW / totR : na, "#.##") + "R)"
    label.new(x2, ent, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)

f_drawFibs(float rL, float rg, int d, color sigCol, string tag) =>
    x1 = bar_index
    x2 = bar_index + rrBars
    l25 = rL + 0.25*rg
    l50 = rL + 0.50*rg
    l75 = rL + 0.75*rg
    lab75 = d == 1 ? "25%" : "75%"     // long -> 25% retr. near the top ; short -> 25% near the bottom
    lab25 = d == 1 ? "75%" : "25%"
    line.new(x1, l25, x2, l25, xloc = xloc.bar_index, color = color.new(sigCol, 35), style = line.style_dotted, width = 1)
    line.new(x1, l50, x2, l50, xloc = xloc.bar_index, color = color.new(sigCol, 35), style = line.style_dotted, width = 1)
    line.new(x1, l75, x2, l75, xloc = xloc.bar_index, color = color.new(sigCol, 35), style = line.style_dotted, width = 1)
    label.new(x1, l25, tag + " " + lab25, xloc = xloc.bar_index, style = label.style_label_right, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
    label.new(x1, l50, tag + " 50%",      xloc = xloc.bar_index, style = label.style_label_right, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
    label.new(x1, l75, tag + " " + lab75, xloc = xloc.bar_index, style = label.style_label_right, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)

// Historical hit-probability labels at the SL (100%/75%) and TP (0/10/30/50%) levels of THIS setup. Line 1 is the
// fill -> EOD number for this setup's size bucket; line 2 is the same level conditioned on the pullback depth,
// pooled across sizes (see the "After pullback" rows of the table). s = 0 ORB, 1 IB.
f_probTxt(string nm, int hit, int n) => nm + " " + f_pctStr(hit, n) + " (" + str.tostring(n) + ")"
f_probTxt2(string nm, int hit, int n, int h25, int n25, int h50, int n50) =>
    f_probTxt(nm, hit, n) + "\nafter 25% PB " + f_pctStr(h25, n25) + "  |  after 50% PB " + f_pctStr(h50, n50)
f_drawProb(int d, float rH, float rL, float rng, float rngPct, int s, bool auto, float mB1, float mB2) =>
    rr  = f_ranges(s)
    b1  = auto ? f_b1(rr) : mB1
    b2  = auto ? f_b2(rr) : mB2
    bkt = f_bkt(rngPct, b1, b2)
    [nn, a0, a1, a2, a3, a4, a5] = f_seg(s, bkt, b1, b2)
    [x25, n25, v0, v1, v2, v3, v4, v5] = f_pbSeg(s, 0, -1, b1, b2)
    [x50, n50, w0, w1, w2, w3, w4, w5] = f_pbSeg(s, 1, -1, b1, b2)
    xp  = bar_index + rrBars + 2
    sl100 = d == 1 ? rL : rH
    sl75  = rL + (d == 1 ? 0.25 : 0.75) * rng
    tp0   = d == 1 ? rH : rL
    tp10  = d == 1 ? rH + 0.10*rng : rL - 0.10*rng
    tp30  = d == 1 ? rH + 0.30*rng : rL - 0.30*rng
    tp50  = d == 1 ? rH + 0.50*rng : rL - 0.50*rng
    label.new(xp, sl100, f_probTxt2("SL100", a0, nn, v0, n25, w0, n50), xloc = xloc.bar_index, style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)
    label.new(xp, sl75,  f_probTxt2("SL75",  a1, nn, v1, n25, w1, n50), xloc = xloc.bar_index, style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)
    label.new(xp, tp0,   f_probTxt2("TP0",   a2, nn, v2, n25, w2, n50), xloc = xloc.bar_index, style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)
    label.new(xp, tp10,  f_probTxt2("TP10",  a3, nn, v3, n25, w3, n50), xloc = xloc.bar_index, style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)
    label.new(xp, tp30,  f_probTxt2("TP30",  a4, nn, v4, n25, w4, n50), xloc = xloc.bar_index, style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)
    label.new(xp, tp50,  f_probTxt2("TP50",  a5, nn, v5, n25, w5, n50), xloc = xloc.bar_index, style = label.style_label_left, color = color.black, textcolor = color.white, size = size.small)

if runORB and or_dir != 0 and or_broke and not or_broke[1] and not na(or_e1) and not na(or_zstop)
    orTP = f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    if showFibs
        f_drawFibs(or_rL, or_rng, or_dir, color.new(color.orange, 0), "ORB")
    if showRR
        f_drawRR(or_dir, or_e1, or_zstop, orTP, orbSz1, color.new(color.orange, 0), "ORB", 0, (or_useAdd and orbSz2 >= 1) ? or_e2 : na, or_useAdd ? orbSz2 : 0)
        if or_useAdd
            f_drawRR(or_dir, or_e2, or_zstop, orTP, orbSz2, color.new(color.orange, 0), "ORB avg #2", rrBars, na, 0)
    if showProb
        f_drawProb(or_dir, or_rH, or_rL, or_rng, or_rng / or_rL * 100, 0, autoMode, orbB1, orbB2)
if runIB and ib_dir != 0 and ib_broke and not ib_broke[1] and not na(ib_e1) and not na(ib_zstop)
    ibTP = f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    if showFibs
        f_drawFibs(ib_rL, ib_rng, ib_dir, color.new(color.teal, 0), "IB")
    if showRR
        f_drawRR(ib_dir, ib_e1, ib_zstop, ibTP, ibSz1, color.new(color.teal, 0), "IB", 0, (ib_useAdd and ibSz2 >= 1) ? ib_e2 : na, ib_useAdd ? ibSz2 : 0)
        if ib_useAdd
            f_drawRR(ib_dir, ib_e2, ib_zstop, ibTP, ibSz2, color.new(color.teal, 0), "IB avg #2", rrBars, na, 0)
    if showProb
        f_drawProb(ib_dir, ib_rH, ib_rL, ib_rng, ib_rng / ib_rL * 100, 1, autoMode, ibB1, ibB2)

// ---------------------------------------------------------------- Strategy rules panel (top-right)
var table info = na
if showInfo and barstate.islast
    info := table.new(position.top_right, 1, 13, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 50), border_width = 1)
    table.cell(info, 0, 0,  "BREAK-THEN-PULLBACK  (ORB + IB)",                    text_color = color.aqua,   text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 1,  "Ranges: ORB 09:30-09:45 | IB 09:30-10:30 (ET)",      text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 2,  "Direction: low-first = LONG, high-first = SHORT",     text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 3,  "  + close in top half (L) / bottom half (S)",         text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 4,  "Enter AFTER the range breaks; limit at fib pullback:", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 5,  "  shallow -> 25% line | deeper -> 50% line",          text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 6,  "Stop: shallow = range extreme | deeper = 75% line",   text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 7,  "Target: ORB L +10% / S +30% ; IB +30% extension",    text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 8,  "Avg-down: 2nd unit @ 50% (shallow setups)",           text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 9,  "ORB before 10:30; IB after; ORB closed if IB opp.",   text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 10, "Skip double-break days | Flatten 15:30 ET",           text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 11, "Toggle Run ORB/IB + weekdays to isolate results",     text_color = color.aqua,   text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 12, "Prob table: TP reach % from fill AND from 25/50% PB", text_color = color.aqua,   text_size = size.small, text_halign = text.align_left)

// ---------------------------------------------------------------- Probability table
// Section 1 (size rows)      : of the trades that FILLED in that range-size bucket, how many reached each level
//                              before the EOD flatten.
// Section 2 (pullback rows)  : of the setups that RETRACED to the 25% (resp. 50%) fib, how many then reached each
//                              level. N is the number that pulled back that far; the bracket in the row label is
//                              that count as a share of all armed setups, i.e. how often the pullback happens at all.
//                              Both sections count level TOUCHES, so a row can show a TP and an SL for the same day.
tPos  = tblPos == "Top right" ? position.top_right : tblPos == "Bottom left" ? position.bottom_left : tblPos == "Top left" ? position.top_left : position.bottom_right
tRows = 8 + (pbSplit ? 12 : 4)

var table probTbl = na

f_tblRow(int row, string lbl, int nn, int a0, int a1, int a2, int a3, int a4, int a5, color txt) =>
    table.cell(probTbl, 0, row, lbl,              text_color = txt,         bgcolor = color.black, text_size = size.normal, text_halign = text.align_left)
    table.cell(probTbl, 1, row, str.tostring(nn), text_color = color.white, bgcolor = color.black, text_size = size.normal)
    table.cell(probTbl, 2, row, f_pctStr(a0, nn), text_color = color.white, bgcolor = color.black, text_size = size.normal)
    table.cell(probTbl, 3, row, f_pctStr(a1, nn), text_color = color.white, bgcolor = color.black, text_size = size.normal)
    table.cell(probTbl, 4, row, f_pctStr(a2, nn), text_color = color.white, bgcolor = color.black, text_size = size.normal)
    table.cell(probTbl, 5, row, f_pctStr(a3, nn), text_color = color.white, bgcolor = color.black, text_size = size.normal)
    table.cell(probTbl, 6, row, f_pctStr(a4, nn), text_color = color.white, bgcolor = color.black, text_size = size.normal)
    table.cell(probTbl, 7, row, f_pctStr(a5, nn), text_color = color.white, bgcolor = color.black, text_size = size.normal)

if showTable and barstate.islast
    if na(probTbl)
        probTbl := table.new(tPos, 8, tRows, bgcolor = color.black, border_color = color.new(color.white, 70), border_width = 1, frame_color = color.white, frame_width = 1)
    hdr = array.from("From FILL - by range size", "N", "SL100", "SL75", "TP0", "TP10", "TP30", "TP50")
    for c = 0 to 7
        table.cell(probTbl, c, 0, array.get(hdr, c), text_color = color.black, bgcolor = color.white, text_size = size.normal, text_halign = c == 0 ? text.align_left : text.align_center)
    // ---- section 1: fill -> EOD, segmented by range size ----
    for s = 0 to 1
        rr = f_ranges(s)
        b1 = autoMode ? f_b1(rr) : (s == 0 ? orbB1 : ibB1)
        b2 = autoMode ? f_b2(rr) : (s == 0 ? orbB2 : ibB2)
        nm = s == 0 ? "ORB" : "IB"
        s1 = na(b1) ? "?" : str.tostring(b1, "#.##") + "%"
        s2 = na(b2) ? "?" : str.tostring(b2, "#.##") + "%"
        for bkt = 0 to 2
            [nn, a0, a1, a2, a3, a4, a5] = f_seg(s, bkt, b1, b2)
            lbl = bkt == 0 ? nm + " S <" + s1 : bkt == 1 ? nm + " M " + s1 + "-" + s2 : nm + " L >=" + s2
            f_tblRow(s * 3 + bkt + 1, lbl, nn, a0, a1, a2, a3, a4, a5, color.white)
    // ---- section 2: conditioned on how deep the pullback went ----
    hdr2 = array.from("From PULLBACK  [% of setups]", "N", "SL100", "SL75", "TP0", "TP10", "TP30", "TP50")
    for c = 0 to 7
        table.cell(probTbl, c, 7, array.get(hdr2, c), text_color = color.black, bgcolor = color.new(color.aqua, 20), text_size = size.normal, text_halign = c == 0 ? text.align_left : text.align_center)
    for s = 0 to 1
        rr2 = f_ranges(s)
        c1  = autoMode ? f_b1(rr2) : (s == 0 ? orbB1 : ibB1)
        c2  = autoMode ? f_b2(rr2) : (s == 0 ? orbB2 : ibB2)
        nm2 = s == 0 ? "ORB" : "IB"
        if pbSplit
            for bkt = 0 to 2
                for d = 0 to 1
                    [nAll, nn, a0, a1, a2, a3, a4, a5] = f_pbSeg(s, d, bkt, c1, c2)
                    szn = bkt == 0 ? "S" : bkt == 1 ? "M" : "L"
                    lbl = nm2 + " " + szn + " after " + (d == 0 ? "25%" : "50%") + " PB  [" + f_pctStr(nn, nAll) + " of " + str.tostring(nAll) + "]"
                    f_tblRow(8 + s * 6 + bkt * 2 + d, lbl, nn, a0, a1, a2, a3, a4, a5, d == 0 ? color.aqua : color.yellow)
        else
            for d = 0 to 1
                [nAll, nn, a0, a1, a2, a3, a4, a5] = f_pbSeg(s, d, -1, c1, c2)
                lbl = nm2 + " after " + (d == 0 ? "25%" : "50%") + " PB  [" + f_pctStr(nn, nAll) + " of " + str.tostring(nAll) + "]"
                f_tblRow(8 + s * 2 + d, lbl, nn, a0, a1, a2, a3, a4, a5, d == 0 ? color.aqua : color.yellow)

// ---------------------------------------------------------------- Visuals
plot(runORB and not na(or_rH) ? or_rH : na, "ORB High", color = color.new(color.orange, 0),  style = plot.style_linebr)
plot(runORB and not na(or_rL) ? or_rL : na, "ORB Low",  color = color.new(color.orange, 45), style = plot.style_linebr)
plot(runORB and or_dir != 0 and not na(or_e1) ? or_e1 : na, "ORB Entry", color = color.new(color.yellow, 0), style = plot.style_linebr)
plot(runIB and not na(ib_rH) ? ib_rH : na, "IB High", color = color.new(color.teal, 0),  style = plot.style_linebr)
plot(runIB and not na(ib_rL) ? ib_rL : na, "IB Low",  color = color.new(color.teal, 45), style = plot.style_linebr)
plot(runIB and ib_dir != 0 and not na(ib_e1) ? ib_e1 : na, "IB Entry", color = color.new(color.aqua, 0), style = plot.style_linebr)
