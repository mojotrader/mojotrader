//@version=6
// Break-then-pullback strategy (run on a 5m chart). Runs ORB (15-min) FIRST, then IB (1-hour).
//
// PRIORITY / INTERACTION (when both are enabled):
//   - ORB may enter only BEFORE the IB forms (i.e. before 10:30). Its resting limit is cancelled at 10:30 if unfilled.
//   - If ORB never traded by the time the IB forms -> ORB is abandoned for the day, only IB plays.
//   - If an ORB position is OPEN when the IB forms and the IB is the OPPOSITE direction -> the ORB position is
//     closed first, then the IB setup is armed. (Same direction -> ORB is left to run and IB arms independently.)
//
// PER SETUP (each range, independently configurable below):
//   1) At the range close: bias = low-before-high (long) / high-before-low (short) AND the range close in the
//      top half (long) / bottom half (short) of the range.
//   2) The trade ARMS only AFTER the range level BREAKS. Break type is selectable: "Wick (touch)" or "Close beyond".
//   3) A LIMIT rests at the fib pullback: shallow(0-25%)->25% line, deeper(25-50%)->50% line.
//   4) AVERAGE DOWN (optional): shallow setup -> a 2nd same-size unit at the 50% line.
//   Stop: shallow -> range extreme (100%) ; deeper -> 75% line. Optional breakeven when the range level is reclaimed.
//   TP long/short selectable: range level / +10% / +30% / +50% / HOD-LOD. One setup/day per range, EOD flatten.
//
// LIMITATION: a Pine strategy nets all orders into ONE position (no hedging). Same-direction overlaps merge fine;
//   the interaction rules above are what handle the opposite-direction ORB/IB case (ORB is closed, not hedged).
strategy("Break-then-Pullback (ORB + IB)", overlay = true, pyramiding = 6, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)

// ---------------------------------------------------------------- Global session inputs
tz     = input.string("America/New_York", "Timezone", group = "Session")
sess   = input.session("0930-1600", "RTH session", group = "Session")
orbSess= input.session("0930-0945", "ORB window", group = "Session")
ibSess = input.session("0930-1030", "IB window", group = "Session")
flatH  = input.int(16, "Flatten hour",   0, 23, group = "Session")
flatM  = input.int(0,  "Flatten minute", 0, 59, group = "Session")

// ---------------------------------------------------------------- ORB settings (under the ORB toggle)
gORB      = "ORB settings"
runORB    = input.bool(true,  "Run ORB", group = gORB)
orbLong   = input.bool(true,  "  ORB take longs",  group = gORB)
orbShort  = input.bool(true,  "  ORB take shorts", group = gORB)
orbBreak  = input.string("Wick (touch)", "  ORB break type", options = ["Wick (touch)", "Close beyond"], group = gORB,
     tooltip = "Wick = the high/low tags the level. Close = the bar must CLOSE beyond the level (stricter, fewer signals).")
orbAvg    = input.bool(true,  "  ORB average down (2nd unit at 50%)", group = gORB)
orbTpL    = input.string("Range level", "  ORB TP long",  options = ["Range level", "Ext 10%", "Ext 30%", "Ext 50%", "HOD/LOD"], group = gORB)
orbTpS    = input.string("Ext 30%",     "  ORB TP short", options = ["Range level", "Ext 10%", "Ext 30%", "Ext 50%", "HOD/LOD"], group = gORB)
orbDeepSL = input.string("75% line", "  ORB 50%-entry stop", options = ["75% line", "100% (range extreme)"], group = gORB,
     tooltip = "Stop for the DEEPER (50% entry) zone. Shallow (25% entry) always stops at the range extreme (100%). Test 75% vs 100% here.")
orbBE     = input.bool(false, "  ORB breakeven on range reclaim", group = gORB)
orbQty    = input.float(1, "  ORB contracts per unit", minval = 1, group = gORB)
orbCutH   = input.int(15, "  ORB entry cutoff hour",   0, 23, group = gORB, tooltip = "Only used if IB is OFF; when IB is ON the ORB deadline is the IB formation time.")
orbCutM   = input.int(0,  "  ORB entry cutoff minute", 0, 59, group = gORB)

// ---------------------------------------------------------------- IB settings (under the IB toggle)
gIB       = "IB settings"
runIB     = input.bool(true,  "Run IB", group = gIB)
ibLong    = input.bool(true,  "  IB take longs",  group = gIB)
ibShort   = input.bool(false, "  IB take shorts (weak in tests)", group = gIB)
ibBreak   = input.string("Wick (touch)", "  IB break type", options = ["Wick (touch)", "Close beyond"], group = gIB,
     tooltip = "Wick = the high/low tags the level. Close = the bar must CLOSE beyond the level (stricter, fewer signals).")
ibAvg     = input.bool(true,  "  IB average down (2nd unit at 50%)", group = gIB)
ibTpL     = input.string("Range level", "  IB TP long",  options = ["Range level", "Ext 10%", "Ext 30%", "Ext 50%", "HOD/LOD"], group = gIB)
ibTpS     = input.string("Ext 30%",     "  IB TP short", options = ["Range level", "Ext 10%", "Ext 30%", "Ext 50%", "HOD/LOD"], group = gIB)
ibDeepSL  = input.string("75% line", "  IB 50%-entry stop", options = ["75% line", "100% (range extreme)"], group = gIB,
     tooltip = "Stop for the DEEPER (50% entry) zone. Shallow (25% entry) always stops at the range extreme (100%). Test 75% vs 100% here.")
ibBE      = input.bool(false, "  IB breakeven on range reclaim", group = gIB)
ibQty     = input.float(1, "  IB contracts per unit", minval = 1, group = gIB)
ibCutH    = input.int(15, "  IB entry cutoff hour",   0, 23, group = gIB)
ibCutM    = input.int(0,  "  IB entry cutoff minute", 0, 59, group = gIB)

// ---------------------------------------------------------------- Filters
gFilt     = "Filters"
noDbl     = input.bool(true, "Skip double-break days (both range sides break)", group = gFilt,
     tooltip = "If the side OPPOSITE the setup direction also breaks (long: price trades below the range low; short: above the range high), cancel the pending entry and take no trade that day. Keeps you to clean one-directional break days only.")

// ---------------------------------------------------------------- Automation (PickMyTrade webhook -> Tradovate)
grpA      = "Automation - PickMyTrade"
autoOn    = input.bool(false, "Enable webhook alerts", group = grpA,
     tooltip = "Create ONE alert with condition 'alert() function calls only' and paste PickMyTrade's webhook URL. Verify the JSON fields match PickMyTrade's template. WARNING: alerts fire on the NET position, so for live automation enable only ONE of ORB/IB at a time.")
pmtToken  = input.string("", "PickMyTrade token", group = grpA)
pmtAcct   = input.string("", "Tradovate account id", group = grpA)
pmtSym    = input.string("MNQ1!", "Broker symbol", group = grpA)
pmtType   = input.string("market", "Order type", options = ["market", "limit"], group = grpA)

// ---------------------------------------------------------------- Break alerts (manual trading)
grpBA     = "Break alerts (manual)"
brkAlerts = input.bool(true, "Alert when ORB / IB level breaks", group = grpBA,
     tooltip = "Fires a notification the moment the ORB or IB range breaks, with the direction and the planned entry/stop/target so you can place the trade yourself. Create ONE alert on this strategy with condition 'alert() function calls only'. (Independent of the PickMyTrade automation above.)")

// ---------------------------------------------------------------- Risk/Reward tool
grpRR     = "Risk / Reward tool"
showRR    = input.bool(true, "Show risk/reward box at the break", group = grpRR)
showFibs  = input.bool(true, "Show fib retracement lines (25/50/75)", group = grpRR, tooltip = "Labels flip by direction: long -> 25% near the top, short -> 25% near the bottom.")
ptVal     = input.float(2.0, "$ per point per contract", group = grpRR, tooltip = "MNQ=2, NQ=20, MES=5, ES=50.")
rrBars    = input.int(24, "R/R box width (bars)", 1, 300, group = grpRR)

// ---------------------------------------------------------------- Shared tracking
inSess     = not na(time(timeframe.period, sess, tz))
newSession = inSess and not inSess[1]
var float dHigh = na
var float dLow  = na
if newSession
    dHigh := high
    dLow  := low
else if inSess
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)
tod     = hour(time, tz) * 60 + minute(time, tz)
flatten = tod >= (flatH*60 + flatM)

or_inR   = not na(time(timeframe.period, orbSess, tz))
or_rDone = not or_inR and or_inR[1]
ib_inR   = not na(time(timeframe.period, ibSess, tz))
ib_rDone = not ib_inR and ib_inR[1]
var bool ibFormed = false
if newSession
    ibFormed := false
if ib_rDone
    ibFormed := true

// TP resolver
f_tp(int d, float rH, float rL, float rg, float dHi, float dLo, string tpL, string tpS) =>
    d == 1 ? (tpL == "HOD/LOD" ? dHi : tpL == "Ext 10%" ? rH + 0.10*rg : tpL == "Ext 30%" ? rH + 0.30*rg : tpL == "Ext 50%" ? rH + 0.50*rg : rH) : (tpS == "HOD/LOD" ? dLo : tpS == "Ext 10%" ? rL - 0.10*rg : tpS == "Ext 30%" ? rL - 0.30*rg : tpS == "Ext 50%" ? rL - 0.50*rg : rL)

// ================================================================ ORB ENGINE (runs first)
var float or_rH = na
var float or_rL = na
var int   or_rHbar = na
var int   or_rLbar = na
var int   or_dir = 0
var bool  or_shallow = false
var float or_e1 = na
var float or_e2 = na
var float or_zstop = na
var float or_rng = na
var bool  or_broke = false
var bool  or_placed = false
var bool  or_f1 = false
var bool  or_f2 = false
var float or_avgPx = na
var float or_curStop = na
var float or_curTP = na
var bool  or_beDone = false
var bool  or_closed = false
var bool  or_oppBroke = false

if newSession
    or_rH := na
    or_rL := na
    or_dir := 0
    or_shallow := false
    or_e1 := na
    or_e2 := na
    or_zstop := na
    or_rng := na
    or_broke := false
    or_placed := false
    or_f1 := false
    or_f2 := false
    or_avgPx := na
    or_curStop := na
    or_curTP := na
    or_beDone := false
    or_closed := false
    or_oppBroke := false
if or_inR
    if na(or_rH) or high > or_rH
        or_rH := high
        or_rHbar := bar_index
    if na(or_rL) or low < or_rL
        or_rL := low
        or_rLbar := bar_index
if or_rDone and not na(or_rH) and or_rH > or_rL
    or_rng := or_rH - or_rL
    or_lf = or_rLbar < or_rHbar
    or_pos = (close[1] - or_rL) / or_rng
    if orbLong and or_lf and or_pos >= 0.5
        or_dir := 1
        or_shallow := or_pos >= 0.75
        or_e1 := or_shallow ? or_rL + 0.75*or_rng : or_rL + 0.5*or_rng
        or_e2 := or_rL + 0.5*or_rng
        or_zstop := or_shallow ? or_rL : (orbDeepSL == "75% line" ? or_rL + 0.25*or_rng : or_rL)
    else if orbShort and (not or_lf) and or_pos <= 0.5
        or_dir := -1
        or_shallow := or_pos <= 0.25
        or_e1 := or_shallow ? or_rL + 0.25*or_rng : or_rL + 0.5*or_rng
        or_e2 := or_rL + 0.5*or_rng
        or_zstop := or_shallow ? or_rH : (orbDeepSL == "75% line" ? or_rL + 0.75*or_rng : or_rH)
or_useAdd = orbAvg and or_shallow and not na(or_e2)
// break by selected type
or_brk = orbBreak == "Wick (touch)" ? ((or_dir == 1 and high >= or_rH) or (or_dir == -1 and low <= or_rL)) : ((or_dir == 1 and close > or_rH) or (or_dir == -1 and close < or_rL))
if or_dir != 0 and or_brk
    or_broke := true
// double-break detection: opposite range extreme is violated
if or_dir == 1 and low < or_rL
    or_oppBroke := true
if or_dir == -1 and high > or_rH
    or_oppBroke := true
// entry window: before IB forms (when IB is on), within ORB cutoff otherwise
orbWin = inSess and tod <= (orbCutH*60 + orbCutM) and (not runIB or not ibFormed)
if runORB and or_dir != 0 and or_broke and not or_placed and not or_closed and orbWin and not flatten and (not noDbl or not or_oppBroke)
    if or_dir == 1
        strategy.entry("ORL", strategy.long, qty = orbQty, limit = or_e1)
        if or_useAdd
            strategy.entry("ORL2", strategy.long, qty = orbQty, limit = or_e2)
    else
        strategy.entry("ORS", strategy.short, qty = orbQty, limit = or_e1)
        if or_useAdd
            strategy.entry("ORS2", strategy.short, qty = orbQty, limit = or_e2)
    or_placed := true
if or_placed and not or_closed
    if or_dir == 1
        if not or_f1 and low <= or_e1
            or_f1 := true
        if or_useAdd and not or_f2 and low <= or_e2
            or_f2 := true
    if or_dir == -1
        if not or_f1 and high >= or_e1
            or_f1 := true
        if or_useAdd and not or_f2 and high >= or_e2
            or_f2 := true
or_firstFill = (or_f1 or or_f2) and not (or_f1[1] or or_f2[1])
if or_f1 or or_f2
    or_avgPx := or_f1 and or_f2 ? (or_e1 + or_e2) / 2 : or_f1 ? or_e1 : or_e2
if or_firstFill
    or_curStop := or_zstop
    or_curTP := f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    or_beDone := false
if orbBE and not or_beDone and (or_f1 or or_f2) and not or_closed
    if or_dir == 1 and high >= or_rH
        or_curStop := math.max(or_curStop, or_avgPx)
        or_beDone := true
    if or_dir == -1 and low <= or_rL
        or_curStop := math.min(or_curStop, or_avgPx)
        or_beDone := true
if not na(or_curStop)
    strategy.exit("ORLx",  from_entry = "ORL",  stop = or_curStop, limit = or_curTP)
    strategy.exit("ORL2x", from_entry = "ORL2", stop = or_curStop, limit = or_curTP)
    strategy.exit("ORSx",  from_entry = "ORS",  stop = or_curStop, limit = or_curTP)
    strategy.exit("ORS2x", from_entry = "ORS2", stop = or_curStop, limit = or_curTP)
if (or_f1 or or_f2) and not or_closed and not na(or_curStop)
    if or_dir == 1 and (low <= or_curStop or high >= or_curTP)
        or_closed := true
    if or_dir == -1 and (high >= or_curStop or low <= or_curTP)
        or_closed := true
// cancel resting ORB entries once the window closes unfilled, or done/flat/off/double-break
if or_closed or flatten or not runORB or (noDbl and or_oppBroke) or ((not orbWin) and not (or_f1 or or_f2))
    strategy.cancel("ORL")
    strategy.cancel("ORL2")
    strategy.cancel("ORS")
    strategy.cancel("ORS2")

// ================================================================ IB ENGINE
var float ib_rH = na
var float ib_rL = na
var int   ib_rHbar = na
var int   ib_rLbar = na
var int   ib_dir = 0
var bool  ib_shallow = false
var float ib_e1 = na
var float ib_e2 = na
var float ib_zstop = na
var float ib_rng = na
var bool  ib_broke = false
var bool  ib_placed = false
var bool  ib_f1 = false
var bool  ib_f2 = false
var float ib_avgPx = na
var float ib_curStop = na
var float ib_curTP = na
var bool  ib_beDone = false
var bool  ib_closed = false
var bool  ib_oppBroke = false

if newSession
    ib_rH := na
    ib_rL := na
    ib_dir := 0
    ib_shallow := false
    ib_e1 := na
    ib_e2 := na
    ib_zstop := na
    ib_rng := na
    ib_broke := false
    ib_placed := false
    ib_f1 := false
    ib_f2 := false
    ib_avgPx := na
    ib_curStop := na
    ib_curTP := na
    ib_beDone := false
    ib_closed := false
    ib_oppBroke := false
if ib_inR
    if na(ib_rH) or high > ib_rH
        ib_rH := high
        ib_rHbar := bar_index
    if na(ib_rL) or low < ib_rL
        ib_rL := low
        ib_rLbar := bar_index
if ib_rDone and not na(ib_rH) and ib_rH > ib_rL
    ib_rng := ib_rH - ib_rL
    ib_lf = ib_rLbar < ib_rHbar
    ib_pos = (close[1] - ib_rL) / ib_rng
    if ibLong and ib_lf and ib_pos >= 0.5
        ib_dir := 1
        ib_shallow := ib_pos >= 0.75
        ib_e1 := ib_shallow ? ib_rL + 0.75*ib_rng : ib_rL + 0.5*ib_rng
        ib_e2 := ib_rL + 0.5*ib_rng
        ib_zstop := ib_shallow ? ib_rL : (ibDeepSL == "75% line" ? ib_rL + 0.25*ib_rng : ib_rL)
    else if ibShort and (not ib_lf) and ib_pos <= 0.5
        ib_dir := -1
        ib_shallow := ib_pos <= 0.25
        ib_e1 := ib_shallow ? ib_rL + 0.25*ib_rng : ib_rL + 0.5*ib_rng
        ib_e2 := ib_rL + 0.5*ib_rng
        ib_zstop := ib_shallow ? ib_rH : (ibDeepSL == "75% line" ? ib_rL + 0.75*ib_rng : ib_rH)
// INTERACTION: on IB formation, resolve ORB vs IB
if ib_rDone and runIB and runORB
    or_open = (or_f1 or or_f2) and not or_closed
    if or_open and ib_dir != 0 and ib_dir == -or_dir
        strategy.close("ORL",  comment = "ORB->IB flip")
        strategy.close("ORL2", comment = "ORB->IB flip")
        strategy.close("ORS",  comment = "ORB->IB flip")
        strategy.close("ORS2", comment = "ORB->IB flip")
        or_closed := true
ib_useAdd = ibAvg and ib_shallow and not na(ib_e2)
ib_brk = ibBreak == "Wick (touch)" ? ((ib_dir == 1 and high >= ib_rH) or (ib_dir == -1 and low <= ib_rL)) : ((ib_dir == 1 and close > ib_rH) or (ib_dir == -1 and close < ib_rL))
if ib_dir != 0 and ib_brk
    ib_broke := true
if ib_dir == 1 and low < ib_rL
    ib_oppBroke := true
if ib_dir == -1 and high > ib_rH
    ib_oppBroke := true
ibWin = inSess and tod <= (ibCutH*60 + ibCutM)
if runIB and ib_dir != 0 and ib_broke and not ib_placed and not ib_closed and ibWin and not flatten and (not noDbl or not ib_oppBroke)
    if ib_dir == 1
        strategy.entry("IBL", strategy.long, qty = ibQty, limit = ib_e1)
        if ib_useAdd
            strategy.entry("IBL2", strategy.long, qty = ibQty, limit = ib_e2)
    else
        strategy.entry("IBS", strategy.short, qty = ibQty, limit = ib_e1)
        if ib_useAdd
            strategy.entry("IBS2", strategy.short, qty = ibQty, limit = ib_e2)
    ib_placed := true
if ib_placed and not ib_closed
    if ib_dir == 1
        if not ib_f1 and low <= ib_e1
            ib_f1 := true
        if ib_useAdd and not ib_f2 and low <= ib_e2
            ib_f2 := true
    if ib_dir == -1
        if not ib_f1 and high >= ib_e1
            ib_f1 := true
        if ib_useAdd and not ib_f2 and high >= ib_e2
            ib_f2 := true
ib_firstFill = (ib_f1 or ib_f2) and not (ib_f1[1] or ib_f2[1])
if ib_f1 or ib_f2
    ib_avgPx := ib_f1 and ib_f2 ? (ib_e1 + ib_e2) / 2 : ib_f1 ? ib_e1 : ib_e2
if ib_firstFill
    ib_curStop := ib_zstop
    ib_curTP := f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    ib_beDone := false
if ibBE and not ib_beDone and (ib_f1 or ib_f2) and not ib_closed
    if ib_dir == 1 and high >= ib_rH
        ib_curStop := math.max(ib_curStop, ib_avgPx)
        ib_beDone := true
    if ib_dir == -1 and low <= ib_rL
        ib_curStop := math.min(ib_curStop, ib_avgPx)
        ib_beDone := true
if not na(ib_curStop)
    strategy.exit("IBLx",  from_entry = "IBL",  stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBL2x", from_entry = "IBL2", stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBSx",  from_entry = "IBS",  stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBS2x", from_entry = "IBS2", stop = ib_curStop, limit = ib_curTP)
if (ib_f1 or ib_f2) and not ib_closed and not na(ib_curStop)
    if ib_dir == 1 and (low <= ib_curStop or high >= ib_curTP)
        ib_closed := true
    if ib_dir == -1 and (high >= ib_curStop or low <= ib_curTP)
        ib_closed := true
if ib_closed or flatten or not runIB or (noDbl and ib_oppBroke) or ((not ibWin) and not (ib_f1 or ib_f2))
    strategy.cancel("IBL")
    strategy.cancel("IBL2")
    strategy.cancel("IBS")
    strategy.cancel("IBS2")

// ---------------------------------------------------------------- EOD flatten
if flatten
    strategy.close_all(comment = "EOD flat")

// ---------------------------------------------------------------- Automation: PickMyTrade webhook JSON (net position)
f_pmt(string act, float q, float slp, float tpp) =>
    '{"token":"' + pmtToken + '","account_id":"' + pmtAcct + '","symbol":"' + pmtSym +
      '","action":"' + act + '","quantity":' + str.tostring(q) +
      ',"order_type":"' + pmtType +
      '","sl":' + str.tostring(math.round_to_mintick(slp)) +
      ',"tp":' + str.tostring(math.round_to_mintick(tpp)) + '}'
liveORB  = (or_f1 or or_f2) and not or_closed
autoStop = liveORB ? or_curStop : ib_curStop
autoTP   = liveORB ? or_curTP  : ib_curTP
autoQty  = liveORB ? orbQty : ibQty
buyNow   = strategy.position_size > 0 and (strategy.position_size[1] <= 0 or strategy.position_size > strategy.position_size[1])
sellNow  = strategy.position_size < 0 and (strategy.position_size[1] >= 0 or strategy.position_size < strategy.position_size[1])
closeNow = flatten and strategy.position_size[1] != 0
if autoOn and buyNow
    alert(f_pmt("buy",  autoQty, autoStop, autoTP), alert.freq_once_per_bar)
if autoOn and sellNow
    alert(f_pmt("sell", autoQty, autoStop, autoTP), alert.freq_once_per_bar)
if autoOn and closeNow
    alert(f_pmt("close", 0, 0.0, 0.0), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Break alerts (fire once when each range breaks)
if brkAlerts and runORB and or_dir != 0 and or_broke and not or_broke[1]
    orTPa = f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    alert("ORB BREAK  " + (or_dir == 1 ? "LONG" : "SHORT") +
         "  | broke " + str.tostring(math.round_to_mintick(or_dir == 1 ? or_rH : or_rL)) +
         "  | pullback entry " + str.tostring(math.round_to_mintick(or_e1)) +
         "  | stop " + str.tostring(math.round_to_mintick(or_zstop)) +
         "  | target " + str.tostring(math.round_to_mintick(orTPa)), alert.freq_once_per_bar)
if brkAlerts and runIB and ib_dir != 0 and ib_broke and not ib_broke[1]
    ibTPa = f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    alert("IB BREAK  " + (ib_dir == 1 ? "LONG" : "SHORT") +
         "  | broke " + str.tostring(math.round_to_mintick(ib_dir == 1 ? ib_rH : ib_rL)) +
         "  | pullback entry " + str.tostring(math.round_to_mintick(ib_e1)) +
         "  | stop " + str.tostring(math.round_to_mintick(ib_zstop)) +
         "  | target " + str.tostring(math.round_to_mintick(ibTPa)), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Risk/Reward + fib tool
// Drawn once per setup at the break and PERSIST (oldest evicted at the 500 limit), so every ORB and IB markup
// stays on the chart. Border/line colour identifies the setup: orange = ORB, teal = IB. A 2nd (offset) R/R box
// is added for the average-down unit when it is armed. Fib lines flip labels by direction.
f_drawRR(int d, float ent, float zstop, float ptp, float q, color sigCol, string tag, int xoff) =>
    x1 = bar_index + xoff
    x2 = x1 + rrBars
    riskUsd = math.abs(ent - zstop) * ptVal * q
    rewUsd  = math.abs(ptp - ent) * ptVal * q
    rrr = riskUsd > 0 ? rewUsd / riskUsd : na
    rewTop = d == 1 ? ptp : ent
    rewBot = d == 1 ? ent : ptp
    rskTop = d == 1 ? ent : zstop
    rskBot = d == 1 ? zstop : ent
    box.new(x1, rewTop, x2, rewBot, xloc = xloc.bar_index, border_color = sigCol, border_width = 1, bgcolor = color.new(color.green, 82))
    box.new(x1, rskTop, x2, rskBot, xloc = xloc.bar_index, border_color = sigCol, border_width = 1, bgcolor = color.new(color.red, 82))
    label.new(x2, ent, tag + "  Risk $" + str.tostring(riskUsd, "#") + " | Reward $" + str.tostring(rewUsd, "#") + " (" + str.tostring(rrr, "#.##") + "R, " + str.tostring(q, "#.#") + "x)", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)

f_drawFibs(float rL, float rg, int d, color sigCol, string tag) =>
    x1 = bar_index
    x2 = bar_index + rrBars
    l25 = rL + 0.25*rg
    l50 = rL + 0.50*rg
    l75 = rL + 0.75*rg
    lab75 = d == 1 ? "25%" : "75%"     // long -> 25% retr. near the top ; short -> 25% near the bottom
    lab25 = d == 1 ? "75%" : "25%"
    line.new(x1, l25, x2, l25, xloc = xloc.bar_index, color = color.new(sigCol, 35), style = line.style_dotted, width = 1)
    line.new(x1, l50, x2, l50, xloc = xloc.bar_index, color = color.new(sigCol, 35), style = line.style_dotted, width = 1)
    line.new(x1, l75, x2, l75, xloc = xloc.bar_index, color = color.new(sigCol, 35), style = line.style_dotted, width = 1)
    label.new(x1, l25, tag + " " + lab25, xloc = xloc.bar_index, style = label.style_label_right, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
    label.new(x1, l50, tag + " 50%",      xloc = xloc.bar_index, style = label.style_label_right, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
    label.new(x1, l75, tag + " " + lab75, xloc = xloc.bar_index, style = label.style_label_right, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)

if runORB and or_dir != 0 and or_broke and not or_broke[1] and not na(or_e1) and not na(or_zstop)
    orTP = f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    if showFibs
        f_drawFibs(or_rL, or_rng, or_dir, color.new(color.orange, 0), "ORB")
    if showRR
        f_drawRR(or_dir, or_e1, or_zstop, orTP, orbQty, color.new(color.orange, 0), "ORB", 0)
        if or_useAdd
            f_drawRR(or_dir, or_e2, or_zstop, orTP, orbQty, color.new(color.orange, 0), "ORB avg #2", rrBars)
if runIB and ib_dir != 0 and ib_broke and not ib_broke[1] and not na(ib_e1) and not na(ib_zstop)
    ibTP = f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    if showFibs
        f_drawFibs(ib_rL, ib_rng, ib_dir, color.new(color.teal, 0), "IB")
    if showRR
        f_drawRR(ib_dir, ib_e1, ib_zstop, ibTP, ibQty, color.new(color.teal, 0), "IB", 0)
        if ib_useAdd
            f_drawRR(ib_dir, ib_e2, ib_zstop, ibTP, ibQty, color.new(color.teal, 0), "IB avg #2", rrBars)

// ---------------------------------------------------------------- Visuals
plot(runORB and not na(or_rH) ? or_rH : na, "ORB High", color = color.new(color.orange, 0),  style = plot.style_linebr)
plot(runORB and not na(or_rL) ? or_rL : na, "ORB Low",  color = color.new(color.orange, 45), style = plot.style_linebr)
plot(runORB and or_dir != 0 and not na(or_e1) ? or_e1 : na, "ORB Entry", color = color.new(color.yellow, 0), style = plot.style_linebr)
plot(runIB and not na(ib_rH) ? ib_rH : na, "IB High", color = color.new(color.teal, 0),  style = plot.style_linebr)
plot(runIB and not na(ib_rL) ? ib_rL : na, "IB Low",  color = color.new(color.teal, 45), style = plot.style_linebr)
plot(runIB and ib_dir != 0 and not na(ib_e1) ? ib_e1 : na, "IB Entry", color = color.new(color.aqua, 0), style = plot.style_linebr)
