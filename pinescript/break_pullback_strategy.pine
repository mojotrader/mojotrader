//@version=6
// Break-then-pullback strategy (run on a 5m chart). Merged IB (1-hour) + ORB (15-min) versions.
//   Pick the range with "Range mode":  IB = first hour (09:30-10:30) ; ORB = first 15 min (09:30-09:45).
//   1) At the range close: bias = low-before-high (long) / high-before-low (short), AND the range close in the
//      top half (long) / bottom half (short) of the range.
//   2) The trade ARMS only AFTER the range level breaks (high>range high for longs / low<range low for shorts).
//   3) A LIMIT rests at the fib pullback line: shallow(0-25%)->25% line, deeper(25-50%)->50% line.
//   4) AVERAGE DOWN (optional): shallow setup (first fill at 25%) -> a 2nd same-size unit rests at the 50% line.
//   Stop (best in tests): shallow -> range extreme (100%) ; deeper -> 75% line. Both units share stop / target.
//   Optional breakeven when price reclaims the range level. TP = range level / HOD-LOD / +10% / +30% / +50%.
//   Best-EV defaults: TP long = range level ; TP short = +30% ext. One setup/day, EOD flatten.
//   Capital & leverage limits removed. NOTE: fat-tail / small-sample pattern — validate on more years.
strategy("Break-then-Pullback (IB / ORB)", overlay = true, pyramiding = 2, max_boxes_count = 20, max_labels_count = 50,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)

// ---------------------------------------------------------------- Inputs
mode      = input.string("IB (1 hour)", "Range mode", options = ["IB (1 hour)", "ORB (15 min)"], group = "Strategy",
     tooltip = "IB = first hour (09:30-10:30). ORB = first 15 min (09:30-09:45). Shorts are weak on IB, workable on ORB.")
tz        = input.string("America/New_York", "Timezone", group = "Session")
sess      = input.session("0930-1600", "RTH session", group = "Session")
ibSess    = input.session("0930-1030", "IB window (mode = IB)", group = "Session")
orbSess   = input.session("0930-0945", "ORB window (mode = ORB)", group = "Session")
allowLong = input.bool(true, "Take longs", group = "Strategy")
allowShort= input.bool(true, "Take shorts (weak on IB)", group = "Strategy")
avgDown   = input.bool(true, "Average down: add 2nd unit at 50% (shallow setups)", group = "Strategy")
tpLong    = input.string("Range level", "TP long",  options = ["Range level", "Ext 10%", "Ext 30%", "Ext 50%", "HOD/LOD"], group = "Strategy",
     tooltip = "Best EV in tests: 'Range level' (return to the broken level). Stops: shallow->range extreme (100%), deeper->75% line.")
tpShort   = input.string("Ext 30%",     "TP short", options = ["Range level", "Ext 10%", "Ext 30%", "Ext 50%", "HOD/LOD"], group = "Strategy",
     tooltip = "Best EV in tests: '+30% extension'. ('Range level' had a higher PF but on ~zero losers — a fat-tail red flag.)")
useBE     = input.bool(false, "Breakeven when price reclaims the range level", group = "Strategy")
qty       = input.float(1, "Contracts per unit", minval = 1, group = "Strategy")
cutH      = input.int(15, "Entry cutoff hour",   0, 23, group = "Time")
cutM      = input.int(0,  "Entry cutoff minute", 0, 59, group = "Time")
flatH     = input.int(16, "Flatten hour",   0, 23, group = "Time")
flatM     = input.int(0,  "Flatten minute", 0, 59, group = "Time")

// ---- Automation (PickMyTrade webhook -> Tradovate)
grpA      = "Automation - PickMyTrade"
autoOn    = input.bool(false, "Enable webhook alerts", group = grpA,
     tooltip = "Turn ON, then create ONE alert on this strategy with condition 'alert() function calls only' and paste PickMyTrade's webhook URL. IMPORTANT: verify the JSON fields below match PickMyTrade's current template before trading live; adjust the f_pmt() function if needed. Alerts fire on bar close after a fill, so the broker enters slightly after the simulated fill.")
pmtToken  = input.string("", "PickMyTrade token", group = grpA)
pmtAcct   = input.string("", "Tradovate account id", group = grpA)
pmtSym    = input.string("MNQ1!", "Broker symbol", group = grpA)
pmtType   = input.string("market", "Order type", options = ["market", "limit"], group = grpA)

// ---- Risk/Reward tool
grpRR     = "Risk / Reward tool"
showRR    = input.bool(true, "Show risk/reward box at the break", group = grpRR)
ptVal     = input.float(2.0, "$ per point per contract", group = grpRR, tooltip = "MNQ=2, NQ=20, MES=5, ES=50. Risk/reward $ = points x this x contracts.")
rrBars    = input.int(24, "R/R box width (bars)", 1, 300, group = grpRR)

// ---------------------------------------------------------------- Session / range tracking
rangeSess  = mode == "IB (1 hour)" ? ibSess : orbSess
inSess     = not na(time(timeframe.period, sess, tz))
newSession = inSess and not inSess[1]
inRange    = not na(time(timeframe.period, rangeSess, tz))
rangeDone  = not inRange and inRange[1]

var float rH = na
var float rL = na
var int   rHbar = na
var int   rLbar = na
var float dHigh = na
var float dLow  = na
var int   dir     = 0
var bool  shallow = false
var float entry1  = na
var float entry2  = na
var float zstop   = na
var float rng     = na
var bool  broke   = false
var bool  placed  = false
var bool  wasIn   = false
var bool  done    = false

if newSession
    rH := na
    rL := na
    dHigh := high
    dLow  := low
    dir := 0
    shallow := false
    entry1 := na
    entry2 := na
    zstop := na
    broke := false
    placed := false
    wasIn := false
    done := false
if inRange
    if na(rH) or high > rH
        rH := high
        rHbar := bar_index
    if na(rL) or low < rL
        rL := low
        rLbar := bar_index
if inSess and not newSession
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)

// resolve setup at range close (10:30 for IB, 09:45 for ORB)
if rangeDone and not na(rH) and rH > rL
    rng := rH - rL
    lowFirst = rLbar < rHbar
    pos = (close[1] - rL) / rng
    if allowLong and lowFirst and pos >= 0.5
        dir := 1
        shallow := pos >= 0.75
        entry1 := shallow ? rL + 0.75*rng : rL + 0.5*rng
        entry2 := rL + 0.5*rng                        // 50% line, used only if shallow + avgDown
        zstop := shallow ? rL : rL + 0.25*rng         // shallow -> range low (100%) ; deeper -> 75% line
    else if allowShort and (not lowFirst) and pos <= 0.5
        dir := -1
        shallow := pos <= 0.25
        entry1 := shallow ? rL + 0.25*rng : rL + 0.5*rng
        entry2 := rL + 0.5*rng
        zstop := shallow ? rH : rL + 0.75*rng         // shallow -> range high (100%) ; deeper -> 75% line

useAdd = avgDown and shallow and not na(entry2)

// ---------------------------------------------------------------- Time gates
tod      = hour(time, tz) * 60 + minute(time, tz)
inWindow = inSess and tod <= (cutH*60 + cutM)
flatten  = tod >= (flatH*60 + flatM)

// ---------------------------------------------------------------- Detect break, arm resting limit(s) once
if dir == 1 and high >= rH
    broke := true
if dir == -1 and low <= rL
    broke := true

if dir != 0 and broke and not placed and not done and inWindow and not flatten
    if dir == 1
        strategy.entry("L", strategy.long, qty = qty, limit = entry1)
        if useAdd
            strategy.entry("L2", strategy.long, qty = qty, limit = entry2)
    else
        strategy.entry("S", strategy.short, qty = qty, limit = entry1)
        if useAdd
            strategy.entry("S2", strategy.short, qty = qty, limit = entry2)
    placed := true

wasIn := wasIn or strategy.position_size != 0
if strategy.position_size == 0 and wasIn
    done := true
if done or flatten or not inWindow
    strategy.cancel("L")
    strategy.cancel("L2")
    strategy.cancel("S")
    strategy.cancel("S2")

// ---------------------------------------------------------------- On first fill: set TP / stop
var float curStop = na
var float curTP   = na
var bool  beDone  = false
opened = strategy.position_size != 0 and strategy.position_size[1] == 0
if opened
    curStop := zstop
    if dir == 1
        curTP := tpLong == "HOD/LOD" ? dHigh : tpLong == "Ext 10%" ? rH + 0.10*rng : tpLong == "Ext 30%" ? rH + 0.30*rng : tpLong == "Ext 50%" ? rH + 0.50*rng : rH
    else
        curTP := tpShort == "HOD/LOD" ? dLow : tpShort == "Ext 10%" ? rL - 0.10*rng : tpShort == "Ext 30%" ? rL - 0.30*rng : tpShort == "Ext 50%" ? rL - 0.50*rng : rL
    beDone := false

// ---------------------------------------------------------------- Breakeven (blended avg) when range reclaimed
if useBE and not beDone and strategy.position_size != 0
    if strategy.position_size > 0 and high >= rH
        curStop := math.max(curStop, strategy.position_avg_price)
        beDone  := true
    if strategy.position_size < 0 and low <= rL
        curStop := math.min(curStop, strategy.position_avg_price)
        beDone  := true

// ---------------------------------------------------------------- Exits (both units share stop / target)
if strategy.position_size != 0
    strategy.exit("Lx",  from_entry = "L",  stop = curStop, limit = curTP)
    strategy.exit("L2x", from_entry = "L2", stop = curStop, limit = curTP)
    strategy.exit("Sx",  from_entry = "S",  stop = curStop, limit = curTP)
    strategy.exit("S2x", from_entry = "S2", stop = curStop, limit = curTP)

if flatten
    strategy.close_all(comment = "EOD flat")

// ---------------------------------------------------------------- Automation: PickMyTrade webhook JSON
// VERIFY these field names against PickMyTrade's current alert template and edit here if needed.
f_pmt(string act, float q, float slp, float tpp) =>
    '{"token":"' + pmtToken + '","account_id":"' + pmtAcct + '","symbol":"' + pmtSym +
      '","action":"' + act + '","quantity":' + str.tostring(q) +
      ',"order_type":"' + pmtType +
      '","sl":' + str.tostring(math.round_to_mintick(slp)) +
      ',"tp":' + str.tostring(math.round_to_mintick(tpp)) + '}'

buyNow   = strategy.position_size > 0 and (strategy.position_size[1] <= 0 or strategy.position_size > strategy.position_size[1])
sellNow  = strategy.position_size < 0 and (strategy.position_size[1] >= 0 or strategy.position_size < strategy.position_size[1])
closeNow = flatten and strategy.position_size[1] != 0
if autoOn and buyNow
    alert(f_pmt("buy",  qty, curStop, curTP), alert.freq_once_per_bar)
if autoOn and sellNow
    alert(f_pmt("sell", qty, curStop, curTP), alert.freq_once_per_bar)
if autoOn and closeNow
    alert(f_pmt("close", 0, 0.0, 0.0), alert.freq_once_per_bar)
// Optional: propagate the breakeven stop move (confirm PickMyTrade's SL-update action name)
if autoOn and useBE and beDone and not beDone[1]
    alert(f_pmt("update_sl", 0, curStop, 0.0), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Risk/Reward tool (drawn when the range level breaks)
var box   rrRisk = na
var box   rrRew  = na
var label rrLbl  = na
if newSession
    box.delete(rrRisk)
    box.delete(rrRew)
    label.delete(rrLbl)
if showRR and dir != 0 and broke and not broke[1] and not na(entry1) and not na(zstop)
    ptp = dir == 1 ? (tpLong == "HOD/LOD" ? dHigh : tpLong == "Ext 10%" ? rH + 0.10*rng : tpLong == "Ext 30%" ? rH + 0.30*rng : tpLong == "Ext 50%" ? rH + 0.50*rng : rH) : (tpShort == "HOD/LOD" ? dLow : tpShort == "Ext 10%" ? rL - 0.10*rng : tpShort == "Ext 30%" ? rL - 0.30*rng : tpShort == "Ext 50%" ? rL - 0.50*rng : rL)
    x1 = bar_index
    x2 = bar_index + rrBars
    riskUsd = math.abs(entry1 - zstop) * ptVal * qty
    rewUsd  = math.abs(ptp - entry1) * ptVal * qty
    rrr = riskUsd > 0 ? rewUsd / riskUsd : na
    box.delete(rrRisk)
    box.delete(rrRew)
    label.delete(rrLbl)
    if dir == 1
        rrRew  := box.new(x1, ptp,    x2, entry1, xloc = xloc.bar_index, border_color = color.new(color.green, 100), bgcolor = color.new(color.green, 82))
        rrRisk := box.new(x1, entry1, x2, zstop,  xloc = xloc.bar_index, border_color = color.new(color.red, 100),   bgcolor = color.new(color.red, 82))
    else
        rrRew  := box.new(x1, entry1, x2, ptp,    xloc = xloc.bar_index, border_color = color.new(color.green, 100), bgcolor = color.new(color.green, 82))
        rrRisk := box.new(x1, zstop,  x2, entry1, xloc = xloc.bar_index, border_color = color.new(color.red, 100),   bgcolor = color.new(color.red, 82))
    rrLbl := label.new(x2, entry1, "Risk $" + str.tostring(riskUsd, "#") + "  |  Reward $" + str.tostring(rewUsd, "#") + "  (" + str.tostring(rrr, "#.##") + "R, " + str.tostring(qty, "#.#") + "x)", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)

// ---------------------------------------------------------------- Visuals
plot(not na(rH) ? rH : na, "Range High", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(not na(rL) ? rL : na, "Range Low",  color = color.new(color.red, 0),  style = plot.style_linebr)
plot(dir != 0 and not na(entry1) ? entry1 : na, "Entry 1", color = color.new(color.orange, 0), style = plot.style_linebr)
plot(useAdd and not na(entry2) ? entry2 : na, "Entry 2 (add)", color = color.new(color.yellow, 0), style = plot.style_linebr)
