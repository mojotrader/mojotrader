//@version=6
// Break-then-pullback strategy (run on a 5m chart). Runs ORB FIRST, then IB.
//
// RANGES ARE SELECTABLE (Session & ranges group): both the ORB and the IB window are time inputs, so any pair of
// ranges can be traded - 09:30-09:35 / 09:30-10:00, 09:30-09:45 / 09:30-10:30 (the default), 09:30-10:00 /
// 09:30-11:00, whatever the day calls for. Everything below is measured off whatever ranges are selected.
//
// ARMING (both ranges, identical logic):
//   - No bias, no first-extreme rule, no close-position rule. The moment ONE SIDE of the range is breached the trade
//     is armed in that direction: high breaks -> LONG, low breaks -> SHORT. Break type selectable per range
//     ("Wick (touch)" or "Close beyond"). The first side to break sets the direction for the day.
//
// ENTRY (selectable per range):
//   - "All at 25% pullback"  -> the whole size rests at the 25% retracement of the range (long: 75% line).
//   - "All at 50% pullback"  -> the whole size rests at the 50% line (mid-range).
//   - "Split (avg down)"     -> one unit at the 25% pullback + one unit at the 50% line.
//   Contracts per level are inputs (default 2 / 2 / 1+1); optional %-of-capital or $-per-setup sizing overrides them.
//
// STOP: always the OTHER EDGE of the range (long -> range low, short -> range high), shared by both units.
// TARGET: range edge (0%), or a 10% / 30% / 50% / 100% extension of the range beyond it - long and short separately.
//
// ORB / IB PRIORITY:
//   - If the ORB EXECUTES, the IB is not taken that day - the ORB owns the seat.
//   - If the ORB armed but never filled, its resting limits are CANCELLED and the IB is traded instead. When that
//     hand-over happens is selectable: as soon as the IB range breaks (default), when the IB range completes, or
//     never (the unfilled ORB limit rests to its own cutoff and the IB is simply skipped while it does).
//   - Optional: "Allow the IB after a closed ORB trade" reopens the IB once an ORB trade is done - off by default,
//     so one range trades per day.
//   FILTERS: skip double-break days; skip ORB setups whose range is under the "Min ORB range %" of price.
//
// PROBABILITY TABLE (bottom right) - how often price REACHES each level from a given starting point, walk-forward:
//   - "From FILL" rows: from the entry fill to the EOD flatten, per range-size bucket.
//   - "From 25% PB" / "From 50% PB" rows: from the moment price retraces to that fib - the two entry levels. Two
//     different starting points, two different sets of odds - the deeper pullback is further from the targets, so
//     its numbers move. N is the sample; "Reach" is how often the setup pulls back that far in the first place.
//   Columns are the exit menu itself: TP0 / TP10 / TP30 / TP50 / TP100 and SL (the opposite range edge).
//   The chart itself stays clean - no probability labels. The table tints the row you are currently in instead:
//   the size row of the running setup, and the pullback row for the depth price has reached ("> " marks it).
//
// NOTE: a Pine strategy nets all orders into ONE position (no hedging). The priority rules above mean ORB and IB
//   are never open at the same time, so the netting never merges two different setups' positions.
strategy("Break-then-Pullback (ORB + IB)", overlay = true, pyramiding = 6, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500,
     initial_capital = 30000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)
// NOTE: position sizing uses a FIXED account size (see 'Account size $' input) - it does NOT compound with P&L.

// ---------------------------------------------------------------- Strategy toggles (isolate each for backtesting)
gStrat    = "Strategies (toggle to track each separately)"
runORB    = input.bool(true, "Run ORB strategy", group = gStrat, tooltip = "Turn OFF to backtest the IB strategy alone in the Strategy Tester.")
runIB     = input.bool(true, "Run IB strategy",  group = gStrat, tooltip = "Turn OFF to backtest the ORB strategy alone.")
ibAfterORB = input.bool(false, "Allow the IB after a closed ORB trade", group = gStrat,
     tooltip = "OFF (default): if the ORB executed at all today, the IB is skipped - one range trades per day. ON: once the ORB trade is finished (target or stop) the IB limit still goes in, provided price has not already traded through the IB entry level while the ORB held the seat.")
orbHandOver = input.string("When the IB range breaks", "Cancel an unfilled ORB", options = ["When the IB range breaks", "When the IB range completes", "Never (rest to the ORB cutoff)"], group = gStrat,
     tooltip = "The ORB only keeps the seat if it EXECUTES. An ORB that armed but never filled is cancelled so the IB can trade. 'When the IB range breaks' (default): the ORB limits are pulled the moment the IB arms a setup of its own - a pullback that arrives before that is still taken by the ORB. 'When the IB range completes': the ORB is pulled as soon as the IB range closes, even if the IB has not broken yet. 'Never': the unfilled ORB limit rests until the ORB cutoff and the IB is skipped while it does.")

// ---------------------------------------------------------------- Session & ranges (TIME SELECTOR)
gSess     = "Session & ranges (time selector)"
tz        = input.string("America/New_York", "Timezone", options = ["America/New_York", "America/Chicago", "America/Los_Angeles", "Europe/London", "Europe/Berlin", "Asia/Tokyo", "UTC"], group = gSess)
sess      = input.session("0930-1600", "Trading session", group = gSess, tooltip = "The whole trading day. Ranges, entries and the EOD flatten all live inside it.")
orbSess   = input.session("0930-0945", "ORB range (range 1 - the fast one)", group = gSess,
     tooltip = "Pick ANY window for the first range: 0930-0935, 0930-0940, 0930-0945 (default), 0930-1000 ... The high and low of this window are the range; the trade arms the moment one side of it breaks.")
ibSess    = input.session("0930-1030", "IB range (range 2 - the slow one)", group = gSess,
     tooltip = "Pick ANY window for the second range: 0930-1000, 0930-1030 (default), 0930-1100 ... It should END LATER than the ORB range, since the ORB is the one that gets first refusal.")
orbCutH   = input.int(15, "ORB - stop new entries at (hour)",  0, 23, group = gSess)
orbCutM   = input.int(0,  "ORB - stop new entries at (minute)", 0, 59, group = gSess, tooltip = "After this time the ORB limit is cancelled if it has not filled. An open ORB trade is not touched - it runs to its stop, its target or the EOD flatten.")
ibCutH    = input.int(14, "IB - stop new entries at (hour)",   0, 23, group = gSess)
ibCutM    = input.int(0,  "IB - stop new entries at (minute)",  0, 59, group = gSess)
flatH     = input.int(15, "Flatten everything at (hour)",   0, 23, group = gSess)
flatM     = input.int(30, "Flatten everything at (minute)", 0, 59, group = gSess)

// ---------------------------------------------------------------- Trade-day filters (see which weekday hurts each)
gDayO     = "Trade days - ORB"
orbMon    = input.bool(true, "ORB Monday",    group = gDayO)
orbTue    = input.bool(true, "ORB Tuesday",   group = gDayO)
orbWed    = input.bool(true, "ORB Wednesday", group = gDayO)
orbThu    = input.bool(true, "ORB Thursday",  group = gDayO)
orbFri    = input.bool(true, "ORB Friday",    group = gDayO)
gDayI     = "Trade days - IB"
ibMon     = input.bool(true, "IB Monday",    group = gDayI)
ibTue     = input.bool(true, "IB Tuesday",   group = gDayI)
ibWed     = input.bool(true, "IB Wednesday", group = gDayI)
ibThu     = input.bool(true, "IB Thursday",  group = gDayI)
ibFri     = input.bool(true, "IB Friday",    group = gDayI)

// ---------------------------------------------------------------- ORB setup
gORB      = "ORB setup"
orbLong   = input.bool(true, "ORB longs (arm when the range HIGH breaks)",  group = gORB)
orbShort  = input.bool(true, "ORB shorts (arm when the range LOW breaks)",  group = gORB)
orbBreak  = input.string("Wick (touch)", "ORB break type", options = ["Wick (touch)", "Close beyond"], group = gORB,
     tooltip = "Wick (touch): the setup arms the instant price trades through the level. Close beyond: a bar must CLOSE past it first.")
orbMode   = input.string("Split (avg down): 25% + 50%", "ORB entry", options = ["All at 25% pullback", "All at 50% pullback", "Split (avg down): 25% + 50%"], group = gORB,
     tooltip = "Where the limit(s) rest after the break. 25% pullback = a 25% retracement of the range from the broken edge (long: the 75% line). 50% = mid-range. Split fires one unit at each, so a deeper pullback averages the position down.")
orbQtyAll = input.float(2, "  ORB contracts (single-level modes)", minval = 1, step = 1, group = gORB, tooltip = "Used by 'All at 25%' and 'All at 50%' - the whole setup rests at one level with this many contracts.")
orbQty25  = input.float(1, "  ORB contracts @ 25% (split mode)",   minval = 1, step = 1, group = gORB)
orbQty50  = input.float(1, "  ORB contracts @ 50% (split mode)",   minval = 1, step = 1, group = gORB)
orbTpL    = input.string("Ext 30%", "ORB target - longs",  options = ["Range edge", "Ext 10%", "Ext 30%", "Ext 50%", "Ext 100%", "HOD/LOD"], group = gORB,
     tooltip = "Range edge = the broken level itself (0% extension). Ext X% = X% of the range projected beyond that edge.")
orbTpS    = input.string("Ext 30%", "ORB target - shorts", options = ["Range edge", "Ext 10%", "Ext 30%", "Ext 50%", "Ext 100%", "HOD/LOD"], group = gORB)
orbBE     = input.bool(false, "ORB breakeven once the range edge is reclaimed", group = gORB)

// ---------------------------------------------------------------- IB setup
gIB       = "IB setup"
ibLong    = input.bool(true, "IB longs (arm when the range HIGH breaks)",  group = gIB)
ibShort   = input.bool(true, "IB shorts (arm when the range LOW breaks)",  group = gIB)
ibBreak   = input.string("Wick (touch)", "IB break type", options = ["Wick (touch)", "Close beyond"], group = gIB)
ibMode    = input.string("Split (avg down): 25% + 50%", "IB entry", options = ["All at 25% pullback", "All at 50% pullback", "Split (avg down): 25% + 50%"], group = gIB)
ibQtyAll  = input.float(2, "  IB contracts (single-level modes)", minval = 1, step = 1, group = gIB)
ibQty25   = input.float(1, "  IB contracts @ 25% (split mode)",   minval = 1, step = 1, group = gIB)
ibQty50   = input.float(1, "  IB contracts @ 50% (split mode)",   minval = 1, step = 1, group = gIB)
ibTpL     = input.string("Ext 30%", "IB target - longs",  options = ["Range edge", "Ext 10%", "Ext 30%", "Ext 50%", "Ext 100%", "HOD/LOD"], group = gIB)
ibTpS     = input.string("Ext 30%", "IB target - shorts", options = ["Range edge", "Ext 10%", "Ext 30%", "Ext 50%", "Ext 100%", "HOD/LOD"], group = gIB)
ibBE      = input.bool(false, "IB breakeven once the range edge is reclaimed", group = gIB)

// ---------------------------------------------------------------- Risk sizing (% of a FIXED capital, or a flat $ - no compounding)
gRisk       = "Risk sizing (optional - overrides the contract counts)"
useRiskSize = input.bool(false, "Size by risk (else use the contracts per setup above)", group = gRisk,
     tooltip = "OFF (default): trade exactly the contract counts set in the ORB/IB groups - the R/R tool, the strategy orders and the webhook all use them. ON: ignore those counts and size each entry so the setup's risk equals the per-setup risk below, split across its units.")
acctSize    = input.float(30000, "Account size $ (fixed - NO compounding)", minval = 1, group = gRisk,
     tooltip = "Sizing uses this constant capital every day; it does NOT grow/shrink with P&L. So the dollar risk per trade is the same every day (no compounding).")
riskMode    = input.string("% of capital", "Risk per setup measured in", options = ["% of capital", "$ per setup"], group = gRisk,
     tooltip = "% of capital: the setup risks that percentage of the fixed account size above. $ per setup: the setup risks a flat dollar amount regardless of the account size. Whichever is selected, the other input is ignored.")
riskPct     = input.float(1.0, "  Risk per setup (% of capital)", minval = 0.1, step = 0.1, group = gRisk,
     tooltip = "Used when 'Risk per setup measured in' = % of capital. Total risk for one strategy's setup, split equally between its entry units. 1% on 30k = $300 = $150 per unit in split mode.")
riskDlr     = input.float(300, "  Risk per setup ($)", minval = 1, step = 25, group = gRisk,
     tooltip = "Used when 'Risk per setup measured in' = $ per setup. Total dollar risk for one strategy's setup, split equally between its entry units. The stop distance then decides the contract count.")
maxDayPct   = input.float(2.0, "Daily max loss (% of capital, 0 = off)", minval = 0, step = 0.5, group = gRisk,
     tooltip = "Once the day's loss reaches this % of the day's starting equity, open trades are closed and no new trades are taken until the next day. This one is always a percentage of the account size, independent of how the per-setup risk is expressed.")

// The $ risk a whole setup may lose, however it was expressed. Every sizing calculation below reads
// this, so the two inputs never both apply and switching mode changes nothing else.
setupBudget = riskMode == "$ per setup" ? riskDlr : acctSize * (riskPct / 100.0)

// ---------------------------------------------------------------- Filters
gFilt     = "Filters"
noDbl     = input.bool(true, "Skip double-break days (both range sides break)", group = gFilt,
     tooltip = "If the side OPPOSITE the armed direction also breaks (long: price trades below the range low; short: above the range high), cancel the pending entry and take no trade that day. Note this is the stop level too, so a double break before the fill is a setup that would have stopped out anyway.")
orbMinRngPct = input.float(0.40, "Min ORB range (% of price, 0 = off)", minval = 0, step = 0.05, group = gFilt,
     tooltip = "Skip ORB setups whose range is smaller than this % of price (range / range-low * 100). The segmentation test showed the smallest-range ORB bucket (<~0.4%) is the only unprofitable segment - 36% win, PF 0.71. IB is NOT filtered. Set 0 to disable. Tune to your own data; the test sample was limited.")

// ---------------------------------------------------------------- Automation (PickMyTrade webhook -> Tradovate)
grpA      = "Automation - PickMyTrade"
autoOn    = input.bool(false, "Enable webhook alerts", group = grpA,
     tooltip = "Create ONE alert with condition 'alert() function calls only' and paste PickMyTrade's webhook URL. Verify the JSON fields match PickMyTrade's template. Alerts fire on the NET position; ORB and IB are never open at the same time, so each alert maps to a single setup.")
pmtToken  = input.string("", "PickMyTrade token", group = grpA)
pmtAcct   = input.string("", "Tradovate account id", group = grpA)
pmtSym    = input.string("MNQ1!", "Broker symbol", group = grpA)
pmtType   = input.string("market", "Order type", options = ["market", "limit"], group = grpA)

// ---------------------------------------------------------------- Break alerts (manual trading)
grpBA     = "Break alerts (manual)"
brkAlerts = input.bool(true, "Alert when ORB / IB level breaks", group = grpBA,
     tooltip = "Fires a notification the moment the ORB or IB range breaks, with the direction and the planned entry/stop/target so you can place the trade yourself. Create ONE alert on this strategy with condition 'alert() function calls only'. (Independent of the PickMyTrade automation above.)")

// ---------------------------------------------------------------- Risk/Reward tool
grpRR     = "Risk / Reward tool"
showRR    = input.bool(true, "Show risk/reward box at the break", group = grpRR)
showFibs  = input.bool(true, "Show fib retracement lines (25/50/75)", group = grpRR, tooltip = "Dotted lines only, no text: the 25/50/75 levels of the range. Which one is the entry is shown by the R/R box.")
showInfo  = input.bool(true, "Show strategy rules panel", group = grpRR)
ptVal     = input.float(2.0, "$ per point per contract", group = grpRR, tooltip = "MNQ=2, NQ=20, MES=5, ES=50.")
keepBox   = input.int(0, "Keep R/R boxes for the last N setups (0 = all)", 0, 250, group = grpRR,
     tooltip = "0 keeps every past setup's boxes and fib lines, so you can scroll back and review the risk/reward of each historical setup. Pine caps a script at 500 boxes and 500 lines, so in practice that is the most recent ~250 setups (~166 if the fib lines are on). Set a small number to keep only the newest setups on the chart.")
keepLab   = input.int(3, "Keep R/R labels for the last N setups (0 = all)", 0, 250, group = grpRR,
     tooltip = "The boxes are cheap to look at; the text labels are what makes a chart unreadable when they stack up. This keeps the $ risk/reward label on the newest few setups only, while the boxes stay for the whole history. 0 keeps every label.")

// ---------------------------------------------------------------- Historical probabilities
grpP      = "Historical probabilities"
hiLive    = input.bool(true, "Highlight the live setup in the table", group = grpP,
     tooltip = "Tints the table row you are currently in: the range-size row of the setup that is running, and the pullback row for the depth price has reached so far (25% line, then the 50% line). A > marks the row that is live right now, so the odds you are looking at are the ones that apply. Nothing is drawn on the chart.")
showTable = input.bool(true, "Show probability table", group = grpP)
tblPos    = input.string("Bottom right", "Table position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = grpP)
bMode     = input.string("Auto (equal thirds)", "Size buckets", options = ["Auto (equal thirds)", "Manual (%)"], group = grpP,
     tooltip = "Applies to the size-segmented rows only. Range is measured as % of price (range / range-low * 100) so buckets stay comparable as price drifts over time. Auto: split each strategy's own range-% distribution into three equal-count buckets (S/M/L). Manual: use the fixed % thresholds below.")
orbB1     = input.float(0.25, "Manual ORB small/med split (%)", step = 0.05, group = grpP, tooltip = "Used only in Manual mode. ORB range-% below this = Small; between the two = Medium; at/above the med/large split = Large.")
orbB2     = input.float(0.40, "Manual ORB med/large split (%)", step = 0.05, group = grpP)
ibB1      = input.float(0.50, "Manual IB small/med split (%)",  step = 0.05, group = grpP)
ibB2      = input.float(0.80, "Manual IB med/large split (%)",  step = 0.05, group = grpP)
pbSplit   = input.bool(false, "Split the pullback rows by size too", group = grpP,
     tooltip = "OFF (default): one 'after 25% PB' and one 'after 50% PB' row per strategy, pooled across range sizes - the biggest sample, least noise. ON: those rows are repeated per S/M/L bucket (6 rows per strategy); useful once you have a few hundred days, misleading before that.")
autoMode  = bMode == "Auto (equal thirds)"

// ---------------------------------------------------------------- Shared tracking
inSess     = not na(time(timeframe.period, sess, tz))
newSession = inSess and not inSess[1]
var float dHigh = na
var float dLow  = na
if newSession
    dHigh := high
    dLow  := low
else if inSess
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)
tod     = hour(time, tz) * 60 + minute(time, tz)
flatten = tod >= (flatH*60 + flatM)

// fixed-capital sizing (NO compounding) + daily max-loss halt (today's P&L vs today's start equity)
var float dayStartEq = na
if newSession
    dayStartEq := strategy.equity
dayPnL    = strategy.equity - dayStartEq              // today's P&L incl. open
dailyHalt = maxDayPct > 0 and dayPnL <= -(acctSize * maxDayPct / 100.0)

// day-of-week gates (per strategy)
dow      = dayofweek(time, tz)
orbDayOK = (dow == dayofweek.monday and orbMon) or (dow == dayofweek.tuesday and orbTue) or (dow == dayofweek.wednesday and orbWed) or (dow == dayofweek.thursday and orbThu) or (dow == dayofweek.friday and orbFri)
ibDayOK  = (dow == dayofweek.monday and ibMon)  or (dow == dayofweek.tuesday and ibTue)  or (dow == dayofweek.wednesday and ibWed)  or (dow == dayofweek.thursday and ibThu)  or (dow == dayofweek.friday and ibFri)

or_inR   = not na(time(timeframe.period, orbSess, tz))
or_rDone = not or_inR and or_inR[1]
ib_inR   = not na(time(timeframe.period, ibSess, tz))
ib_rDone = not ib_inR and ib_inR[1]
var bool ibFormed = false
if newSession
    ibFormed := false
if ib_rDone
    ibFormed := true

// position sizer: contracts for a given $ budget and stop distance (points).
// round: fractional <= .5 -> down, > .5 -> up (2.1-2.5 -> 2, >2.5 -> 3). Min 1 when the unit's risk >= 0.5%.
f_size(float budget, float ptDist, float unitPct) =>
    perC = ptDist * ptVal
    raw  = perC > 0 ? budget / perC : 0.0
    fr   = raw - math.floor(raw)
    n = fr > 0.5 ? math.ceil(raw) : math.floor(raw)
    n := (unitPct >= 0.5 and n < 1) ? 1 : n
    n

// TP resolver: "Range edge" is the broken level itself; every "Ext" is that much of the range beyond it.
f_tp(int d, float rH, float rL, float rg, float dHi, float dLo, string tpL, string tpS) =>
    t   = d == 1 ? tpL : tpS
    ext = t == "Ext 10%" ? 0.10 : t == "Ext 30%" ? 0.30 : t == "Ext 50%" ? 0.50 : t == "Ext 100%" ? 1.00 : 0.0
    d == 1 ? (t == "HOD/LOD" ? dHi : rH + ext * rg) : (t == "HOD/LOD" ? dLo : rL - ext * rg)

// the two entry levels of a range, in the armed direction. 25% = a 25% retracement from the broken edge.
f_p25(int d, float rL, float rg) => rL + (d == 1 ? 0.75 : 0.25) * rg
f_p50(float rL, float rg) => rL + 0.50 * rg

// ================================================================ Historical-probability stats
// TWO walk-forward studies are collected (a day is only added to the sample after its EOD flatten, so the numbers
// shown on any bar never contain data from that day or later):
//
//   A) FILL -> EOD, segmented by range size. One record per FILLED trade: did price TOUCH each level between the
//      fill and the EOD flatten? Range is stored as % of price (range / range-low * 100) so the S/M/L buckets stay
//      comparable as price drifts over the years. These are the "size" rows of the table.
//
//   B) PULLBACK -> EOD. One record per SETUP THAT BROKE its range (whether or not the order was actually placed -
//      a day where the IB was skipped behind an ORB trade still tells you what price did). It answers: once price
//      has retraced to the 25% fib, how often does it go on to tag each TP extension? And the same from the 50%
//      fib - i.e. exactly the two entry levels this strategy uses.
//      On the very bar that reaches the pullback, a level counts only if the CLOSE is already beyond it - the last
//      tick of that bar sits past the level, so it was traded after the retrace. From the next bar on, an ordinary
//      wick touch counts. That keeps the ordering honest without throwing away the entry candle.
//      The 50% line can only be reached through the 25% line, so the 50% sample is a subset of the 25% one.
//      Read a cell as: "of the setups that pulled back this far, X% went on to trade that level (by the flatten)".
//      The SL column is the opposite range edge - the stop this strategy actually uses - under the same conditioning,
//      so a row shows the reward AND the risk that follow the pullback.
f_pct(int hit, int n) => n > 0 ? 100.0 * hit / n : na
f_pctStr(int hit, int n) =>
    p = f_pct(hit, n)
    na(p) ? "-" : str.tostring(p, "#") + "%"

// ---- study A: one record per filled trade. Level order: TP0, TP10, TP30, TP50, TP100, SL(opposite edge) -------
var tRng   = array.new_float(0)
var tStrat = array.new_int(0)
var tTP0   = array.new_int(0)
var tTP10  = array.new_int(0)
var tTP30  = array.new_int(0)
var tTP50  = array.new_int(0)
var tTP100 = array.new_int(0)
var tSL    = array.new_int(0)

f_pushTrade(int s, float rng, bool t0, bool t10, bool t30, bool t50, bool t100, bool sl) =>
    array.push(tRng,   rng)
    array.push(tStrat, s)
    array.push(tTP0,   t0   ? 1 : 0)
    array.push(tTP10,  t10  ? 1 : 0)
    array.push(tTP30,  t30  ? 1 : 0)
    array.push(tTP50,  t50  ? 1 : 0)
    array.push(tTP100, t100 ? 1 : 0)
    array.push(tSL,    sl   ? 1 : 0)

// ranges recorded so far for one strategy (walk-forward: only days finalized before now)
f_ranges(int s) =>
    tmp = array.new_float(0)
    if array.size(tRng) > 0
        for i = 0 to array.size(tRng) - 1
            if array.get(tStrat, i) == s
                array.push(tmp, array.get(tRng, i))
    tmp

// tercile boundaries for a strategy (na until >=3 samples); in manual mode the caller passes fixed thresholds
f_b1(array<float> rr) => array.size(rr) < 3 ? na : array.percentile_linear_interpolation(rr, 33.33333)
f_b2(array<float> rr) => array.size(rr) < 3 ? na : array.percentile_linear_interpolation(rr, 66.66667)
f_bkt(float rng, float b1, float b2) => (na(b1) or na(b2)) ? 0 : rng < b1 ? 0 : rng < b2 ? 1 : 2

// counts [n, tp0, tp10, tp30, tp50, tp100, sl] for one strategy+bucket given the boundaries
f_seg(int s, int bkt, float b1, float b2) =>
    nn = 0
    a0 = 0
    a1 = 0
    a2 = 0
    a3 = 0
    a4 = 0
    a5 = 0
    if array.size(tRng) > 0
        for i = 0 to array.size(tRng) - 1
            if array.get(tStrat, i) == s and f_bkt(array.get(tRng, i), b1, b2) == bkt
                nn := nn + 1
                a0 := a0 + array.get(tTP0,   i)
                a1 := a1 + array.get(tTP10,  i)
                a2 := a2 + array.get(tTP30,  i)
                a3 := a3 + array.get(tTP50,  i)
                a4 := a4 + array.get(tTP100, i)
                a5 := a5 + array.get(tSL,    i)
    [nn, a0, a1, a2, a3, a4, a5]

// ---- study B: one record per armed setup, conditioned on how deep the pullback went --------------------------
// Level order used everywhere below: 0 TP0, 1 TP10, 2 TP30, 3 TP50, 4 TP100, 5 SL (the opposite range edge).
var pbStrat = array.new_int(0)
var pbRngP  = array.new_float(0)
var pbR25   = array.new_int(0)      // did price retrace to the 25% fib
var pbR50   = array.new_int(0)      // ... and to the 50% fib
var pb25_0  = array.new_int(0)      // levels reached from the 25% retrace onward
var pb25_1  = array.new_int(0)
var pb25_2  = array.new_int(0)
var pb25_3  = array.new_int(0)
var pb25_4  = array.new_int(0)
var pb25_5  = array.new_int(0)
var pb50_0  = array.new_int(0)      // levels reached from the 50% retrace onward
var pb50_1  = array.new_int(0)
var pb50_2  = array.new_int(0)
var pb50_3  = array.new_int(0)
var pb50_4  = array.new_int(0)
var pb50_5  = array.new_int(0)

f_pbPush(int s, float rngP, bool r25, bool r50, array<bool> h25, array<bool> h50) =>
    array.push(pbStrat, s)
    array.push(pbRngP,  rngP)
    array.push(pbR25,   r25 ? 1 : 0)
    array.push(pbR50,   r50 ? 1 : 0)
    array.push(pb25_0, array.get(h25, 0) ? 1 : 0)
    array.push(pb25_1, array.get(h25, 1) ? 1 : 0)
    array.push(pb25_2, array.get(h25, 2) ? 1 : 0)
    array.push(pb25_3, array.get(h25, 3) ? 1 : 0)
    array.push(pb25_4, array.get(h25, 4) ? 1 : 0)
    array.push(pb25_5, array.get(h25, 5) ? 1 : 0)
    array.push(pb50_0, array.get(h50, 0) ? 1 : 0)
    array.push(pb50_1, array.get(h50, 1) ? 1 : 0)
    array.push(pb50_2, array.get(h50, 2) ? 1 : 0)
    array.push(pb50_3, array.get(h50, 3) ? 1 : 0)
    array.push(pb50_4, array.get(h50, 4) ? 1 : 0)
    array.push(pb50_5, array.get(h50, 5) ? 1 : 0)

// counts for one strategy at one pullback depth. depth 0 = reached the 25% fib, 1 = reached the 50% fib.
// bkt = -1 pools all range sizes; 0/1/2 restricts to the S/M/L bucket defined by b1/b2.
// Returns [setups armed, setups that reached that pullback, then TP0, TP10, TP30, TP50, TP100, SL counts].
f_pbSeg(int s, int depth, int bkt, float b1, float b2) =>
    nAll = 0
    nn   = 0
    h0 = 0
    h1 = 0
    h2 = 0
    h3 = 0
    h4 = 0
    h5 = 0
    if array.size(pbStrat) > 0
        for i = 0 to array.size(pbStrat) - 1
            if array.get(pbStrat, i) == s and (bkt < 0 or f_bkt(array.get(pbRngP, i), b1, b2) == bkt)
                nAll := nAll + 1
                if (depth == 0 ? array.get(pbR25, i) : array.get(pbR50, i)) == 1
                    nn := nn + 1
                    h0 := h0 + (depth == 0 ? array.get(pb25_0, i) : array.get(pb50_0, i))
                    h1 := h1 + (depth == 0 ? array.get(pb25_1, i) : array.get(pb50_1, i))
                    h2 := h2 + (depth == 0 ? array.get(pb25_2, i) : array.get(pb50_2, i))
                    h3 := h3 + (depth == 0 ? array.get(pb25_3, i) : array.get(pb50_3, i))
                    h4 := h4 + (depth == 0 ? array.get(pb25_4, i) : array.get(pb50_4, i))
                    h5 := h5 + (depth == 0 ? array.get(pb25_5, i) : array.get(pb50_5, i))
    [nAll, nn, h0, h1, h2, h3, h4, h5]

// ================================================================ ORB ENGINE (runs first)
var float or_rH = na
var float or_rL = na
var float or_rng = na
var bool  or_rdy = false          // range complete and valid
var int   or_dir = 0
var float or_e1 = na              // primary entry level
var float or_e2 = na              // average-down level (na unless split mode)
var float or_q1 = na
var float or_q2 = na
var float or_zstop = na           // stop = the OTHER edge of the range
var bool  or_broke = false
var bool  or_placed = false
var bool  or_f1 = false
var bool  or_f2 = false
var float or_avgPx = na
var float or_curStop = na
var float or_curTP = na
var bool  or_beDone = false
var bool  or_closed = false
var bool  or_dead = false         // armed but handed the seat to the IB before it filled
var bool  or_oppBroke = false

if newSession
    or_rH := na
    or_rL := na
    or_rng := na
    or_rdy := false
    or_dir := 0
    or_e1 := na
    or_e2 := na
    or_q1 := na
    or_q2 := na
    or_zstop := na
    or_broke := false
    or_placed := false
    or_f1 := false
    or_f2 := false
    or_avgPx := na
    or_curStop := na
    or_curTP := na
    or_beDone := false
    or_closed := false
    or_dead := false
    or_oppBroke := false
if or_inR
    or_rH := na(or_rH) ? high : math.max(or_rH, high)
    or_rL := na(or_rL) ? low  : math.min(or_rL, low)
if or_rDone and not na(or_rH) and or_rH > or_rL
    or_rng := or_rH - or_rL
    or_rdy := true

// ---- ARM: the first side to break sets the direction. No first-extreme rule, no close-position rule. ----
or_brkUp = or_rdy and (orbBreak == "Wick (touch)" ? high >= or_rH : close > or_rH)
or_brkDn = or_rdy and (orbBreak == "Wick (touch)" ? low  <= or_rL : close < or_rL)
if or_rdy and not or_broke and (or_brkUp or or_brkDn)
    // a bar that engulfs the whole range breaks both sides at once - take the side it closed on
    o_d = or_brkUp and or_brkDn ? (close >= or_rL + 0.5 * or_rng ? 1 : -1) : or_brkUp ? 1 : -1
    or_broke := true
    if (o_d == 1 and orbLong) or (o_d == -1 and orbShort)
        or_dir := o_d
        o_p25 = f_p25(o_d, or_rL, or_rng)
        o_p50 = f_p50(or_rL, or_rng)
        o_spl = orbMode == "Split (avg down): 25% + 50%"
        or_e1   := orbMode == "All at 50% pullback" ? o_p50 : o_p25
        or_e2   := o_spl ? o_p50 : na
        or_zstop := o_d == 1 ? or_rL : or_rH          // stop = the other edge of the range
        o_bud  = setupBudget / (o_spl ? 2 : 1)
        o_upct = o_bud / acctSize * 100.0
        or_q1 := useRiskSize ? f_size(o_bud, math.abs(or_e1 - or_zstop), o_upct) : (o_spl ? orbQty25 : orbQtyAll)
        or_q2 := not o_spl ? 0.0 : (useRiskSize ? f_size(o_bud, math.abs(or_e2 - or_zstop), o_upct) : orbQty50)
or_useAdd = or_dir != 0 and not na(or_e2) and or_q2 >= 1
// double-break detection: the opposite range extreme (= the stop level) is violated
if or_dir == 1 and low < or_rL
    or_oppBroke := true
if or_dir == -1 and high > or_rH
    or_oppBroke := true
// entry window: inside the session, on an allowed weekday, before the ORB cutoff, range big enough
orbSizeOK = orbMinRngPct <= 0 or (not na(or_rng) and or_rL > 0 and or_rng / or_rL * 100 >= orbMinRngPct)
orbWin = inSess and orbDayOK and tod <= (orbCutH*60 + orbCutM) and not dailyHalt and orbSizeOK
if runORB and or_dir != 0 and or_broke and not or_placed and not or_closed and not or_dead and orbWin and not flatten and (not noDbl or not or_oppBroke) and or_q1 >= 1
    if or_dir == 1
        strategy.entry("ORL", strategy.long, qty = or_q1, limit = or_e1)
        if or_useAdd
            strategy.entry("ORL2", strategy.long, qty = or_q2, limit = or_e2)
    else
        strategy.entry("ORS", strategy.short, qty = or_q1, limit = or_e1)
        if or_useAdd
            strategy.entry("ORS2", strategy.short, qty = or_q2, limit = or_e2)
    or_placed := true
// fills are tracked from the bar AFTER the limit went in - the broker cannot fill an order on the bar that
// placed it, so a break bar that already dips to the entry level must not be counted as a fill.
if or_placed and or_placed[1] and not or_closed
    if or_dir == 1
        if not or_f1 and low <= or_e1
            or_f1 := true
        if or_useAdd and not or_f2 and low <= or_e2
            or_f2 := true
    if or_dir == -1
        if not or_f1 and high >= or_e1
            or_f1 := true
        if or_useAdd and not or_f2 and high >= or_e2
            or_f2 := true
or_firstFill = (or_f1 or or_f2) and not (or_f1[1] or or_f2[1])
if or_f1 or or_f2
    or_avgPx := or_f1 and or_f2 ? (or_e1 * or_q1 + or_e2 * or_q2) / (or_q1 + or_q2) : or_f1 ? or_e1 : or_e2
if or_firstFill
    or_curStop := or_zstop
    or_curTP := f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    or_beDone := false
if orbBE and not or_beDone and (or_f1 or or_f2) and not or_closed
    if or_dir == 1 and high >= or_rH
        or_curStop := math.max(or_curStop, or_avgPx)
        or_beDone := true
    if or_dir == -1 and low <= or_rL
        or_curStop := math.min(or_curStop, or_avgPx)
        or_beDone := true
if not na(or_curStop)
    strategy.exit("ORLx",  from_entry = "ORL",  stop = or_curStop, limit = or_curTP)
    strategy.exit("ORL2x", from_entry = "ORL2", stop = or_curStop, limit = or_curTP)
    strategy.exit("ORSx",  from_entry = "ORS",  stop = or_curStop, limit = or_curTP)
    strategy.exit("ORS2x", from_entry = "ORS2", stop = or_curStop, limit = or_curTP)
if (or_f1 or or_f2) and not or_closed and not na(or_curStop)
    if or_dir == 1 and (low <= or_curStop or high >= or_curTP)
        or_closed := true
    if or_dir == -1 and (high >= or_curStop or low <= or_curTP)
        or_closed := true
// cancel resting ORB entries once the window closes unfilled, or done/flat/off/double-break.
// (The hand-over to the IB is handled after the IB engine below - ib_broke is not known this early in the bar.)
if or_closed or or_dead or flatten or not runORB or (noDbl and or_oppBroke) or ((not orbWin) and not (or_f1 or or_f2))
    strategy.cancel("ORL")
    strategy.cancel("ORL2")
    strategy.cancel("ORS")
    strategy.cancel("ORS2")

// ---- ORB study A: from the fill to EOD, did price touch each level? ----
var bool  or_trk    = false
var int   or_tdir   = 0
var float orL_tp0   = na
var float orL_tp10  = na
var float orL_tp30  = na
var float orL_tp50  = na
var float orL_tp100 = na
var float orL_sl    = na
var bool  orR_tp0   = false
var bool  orR_tp10  = false
var bool  orR_tp30  = false
var bool  orR_tp50  = false
var bool  orR_tp100 = false
var bool  orR_sl    = false
if newSession
    or_trk := false
if or_firstFill and not na(or_rng)
    or_trk    := true
    or_tdir   := or_dir
    orL_tp0   := or_dir == 1 ? or_rH : or_rL
    orL_tp10  := or_dir == 1 ? or_rH + 0.10*or_rng : or_rL - 0.10*or_rng
    orL_tp30  := or_dir == 1 ? or_rH + 0.30*or_rng : or_rL - 0.30*or_rng
    orL_tp50  := or_dir == 1 ? or_rH + 0.50*or_rng : or_rL - 0.50*or_rng
    orL_tp100 := or_dir == 1 ? or_rH + 1.00*or_rng : or_rL - 1.00*or_rng
    orL_sl    := or_dir == 1 ? or_rL : or_rH
    orR_tp0   := false
    orR_tp10  := false
    orR_tp30  := false
    orR_tp50  := false
    orR_tp100 := false
    orR_sl    := false
if or_trk
    if or_tdir == 1
        orR_tp0   := orR_tp0   or high >= orL_tp0
        orR_tp10  := orR_tp10  or high >= orL_tp10
        orR_tp30  := orR_tp30  or high >= orL_tp30
        orR_tp50  := orR_tp50  or high >= orL_tp50
        orR_tp100 := orR_tp100 or high >= orL_tp100
        orR_sl    := orR_sl    or low  <= orL_sl
    else
        orR_tp0   := orR_tp0   or low  <= orL_tp0
        orR_tp10  := orR_tp10  or low  <= orL_tp10
        orR_tp30  := orR_tp30  or low  <= orL_tp30
        orR_tp50  := orR_tp50  or low  <= orL_tp50
        orR_tp100 := orR_tp100 or low  <= orL_tp100
        orR_sl    := orR_sl    or high >= orL_sl
    if flatten
        f_pushTrade(0, or_rng / or_rL * 100, orR_tp0, orR_tp10, orR_tp30, orR_tp50, orR_tp100, orR_sl)
        or_trk := false

// ---- ORB study B: armed -> 25% / 50% pullback -> which levels print from there, filed at the EOD flatten ----
var bool  orP_act  = false
var int   orP_dir  = 0
var float orP_rngP = na
var float orP_p25  = na
var float orP_p50  = na
var bool  orP_r25  = false
var bool  orP_r50  = false
var orP_lv  = array.new_float(6, na)      // 0 TP0, 1 TP10, 2 TP30, 3 TP50, 4 TP100, 5 SL
var orP_h25 = array.new_bool(6, false)
var orP_h50 = array.new_bool(6, false)
if newSession
    orP_act := false
if or_broke and not or_broke[1] and or_dir != 0 and not na(or_rng) and or_rL > 0
    orP_act  := true
    orP_dir  := or_dir
    orP_rngP := or_rng / or_rL * 100
    orP_p25  := f_p25(or_dir, or_rL, or_rng)
    orP_p50  := f_p50(or_rL, or_rng)
    orP_r25  := false
    orP_r50  := false
    array.set(orP_lv, 0, or_dir == 1 ? or_rH : or_rL)
    array.set(orP_lv, 1, or_dir == 1 ? or_rH + 0.10*or_rng : or_rL - 0.10*or_rng)
    array.set(orP_lv, 2, or_dir == 1 ? or_rH + 0.30*or_rng : or_rL - 0.30*or_rng)
    array.set(orP_lv, 3, or_dir == 1 ? or_rH + 0.50*or_rng : or_rL - 0.50*or_rng)
    array.set(orP_lv, 4, or_dir == 1 ? or_rH + 1.00*or_rng : or_rL - 1.00*or_rng)
    array.set(orP_lv, 5, or_dir == 1 ? or_rL : or_rH)
    for k = 0 to 5
        array.set(orP_h25, k, false)
        array.set(orP_h50, k, false)
if orP_act
    up    = orP_dir == 1
    new25 = false
    new50 = false
    if not orP_r25 and (up ? low <= orP_p25 : high >= orP_p25)
        orP_r25 := true
        new25    := true
    if not orP_r50 and (up ? low <= orP_p50 : high >= orP_p50)
        orP_r50 := true
        new50    := true
    // On the bar that REACHES the pullback the touch must be confirmed by the CLOSE: the last tick of that bar is
    // beyond the level, so it traded there after the retrace low/high. Later bars count an ordinary wick touch.
    for k = 0 to 5
        lv   = array.get(orP_lv, k)
        isTp = k <= 4
        wick = isTp ? (up ? high >= lv : low <= lv) : (up ? low <= lv : high >= lv)
        cls  = isTp ? (up ? close >= lv : close <= lv) : (up ? close <= lv : close >= lv)
        if orP_r25 and (new25 ? cls : wick)
            array.set(orP_h25, k, true)
        if orP_r50 and (new50 ? cls : wick)
            array.set(orP_h50, k, true)
    if flatten
        f_pbPush(0, orP_rngP, orP_r25, orP_r50, orP_h25, orP_h50)
        orP_act := false

// ================================================================ IB ENGINE
var float ib_rH = na
var float ib_rL = na
var float ib_rng = na
var bool  ib_rdy = false
var int   ib_dir = 0
var float ib_e1 = na
var float ib_e2 = na
var float ib_q1 = na
var float ib_q2 = na
var float ib_zstop = na
var bool  ib_broke = false
var bool  ib_placed = false
var bool  ib_f1 = false
var bool  ib_f2 = false
var float ib_avgPx = na
var float ib_curStop = na
var float ib_curTP = na
var bool  ib_beDone = false
var bool  ib_closed = false
var bool  ib_oppBroke = false
var bool  ib_missed = false      // the IB pullback came and went while the ORB held the seat -> skip IB today

if newSession
    ib_rH := na
    ib_rL := na
    ib_rng := na
    ib_rdy := false
    ib_dir := 0
    ib_e1 := na
    ib_e2 := na
    ib_q1 := na
    ib_q2 := na
    ib_zstop := na
    ib_broke := false
    ib_placed := false
    ib_f1 := false
    ib_f2 := false
    ib_avgPx := na
    ib_curStop := na
    ib_curTP := na
    ib_beDone := false
    ib_closed := false
    ib_oppBroke := false
    ib_missed := false
if ib_inR
    ib_rH := na(ib_rH) ? high : math.max(ib_rH, high)
    ib_rL := na(ib_rL) ? low  : math.min(ib_rL, low)
if ib_rDone and not na(ib_rH) and ib_rH > ib_rL
    ib_rng := ib_rH - ib_rL
    ib_rdy := true

// ---- ARM: same rule as the ORB - the first side to break sets the direction ----
ib_brkUp = ib_rdy and (ibBreak == "Wick (touch)" ? high >= ib_rH : close > ib_rH)
ib_brkDn = ib_rdy and (ibBreak == "Wick (touch)" ? low  <= ib_rL : close < ib_rL)
if ib_rdy and not ib_broke and (ib_brkUp or ib_brkDn)
    i_d = ib_brkUp and ib_brkDn ? (close >= ib_rL + 0.5 * ib_rng ? 1 : -1) : ib_brkUp ? 1 : -1
    ib_broke := true
    if (i_d == 1 and ibLong) or (i_d == -1 and ibShort)
        ib_dir := i_d
        i_p25 = f_p25(i_d, ib_rL, ib_rng)
        i_p50 = f_p50(ib_rL, ib_rng)
        i_spl = ibMode == "Split (avg down): 25% + 50%"
        ib_e1   := ibMode == "All at 50% pullback" ? i_p50 : i_p25
        ib_e2   := i_spl ? i_p50 : na
        ib_zstop := i_d == 1 ? ib_rL : ib_rH          // stop = the other edge of the range
        i_bud  = setupBudget / (i_spl ? 2 : 1)
        i_upct = i_bud / acctSize * 100.0
        ib_q1 := useRiskSize ? f_size(i_bud, math.abs(ib_e1 - ib_zstop), i_upct) : (i_spl ? ibQty25 : ibQtyAll)
        ib_q2 := not i_spl ? 0.0 : (useRiskSize ? f_size(i_bud, math.abs(ib_e2 - ib_zstop), i_upct) : ibQty50)
ib_useAdd = ib_dir != 0 and not na(ib_e2) and ib_q2 >= 1
if ib_dir == 1 and low < ib_rL
    ib_oppBroke := true
if ib_dir == -1 and high > ib_rH
    ib_oppBroke := true

// PRIORITY: the ORB owns the day the moment it EXECUTES. While an ORB trade is open - and, by default, for the
// rest of the day once it has traded at all - the IB is not taken. With "Allow the IB after a closed ORB trade"
// on, the IB comes back once the ORB is finished, unless its entry level already traded through in the meantime,
// in which case that pullback was missed and the IB is done for the day. An ORB that armed but never filled does
// NOT block anything: it is cancelled below and the IB trades in its place.
orbTraded = runORB and (or_f1 or or_f2)
orbLive   = orbTraded and not or_closed
ibBlocked = orbLive or (orbTraded and not ibAfterORB)
ibWin = inSess and ibDayOK and tod <= (ibCutH*60 + ibCutM) and not dailyHalt
if runIB and ib_dir != 0 and ib_broke and not ib_placed and not ib_closed and orbLive and ibAfterORB and not na(ib_e1)
    if (ib_dir == 1 and low <= ib_e1) or (ib_dir == -1 and high >= ib_e1)
        ib_missed := true
if runIB and ib_dir != 0 and ib_broke and not ib_placed and not ib_closed and ibWin and not flatten and (not noDbl or not ib_oppBroke) and ib_q1 >= 1 and not ibBlocked and not ib_missed
    if ib_dir == 1
        strategy.entry("IBL", strategy.long, qty = ib_q1, limit = ib_e1)
        if ib_useAdd
            strategy.entry("IBL2", strategy.long, qty = ib_q2, limit = ib_e2)
    else
        strategy.entry("IBS", strategy.short, qty = ib_q1, limit = ib_e1)
        if ib_useAdd
            strategy.entry("IBS2", strategy.short, qty = ib_q2, limit = ib_e2)
    ib_placed := true
// same as the ORB: a limit only becomes fillable on the bar after it was placed
if ib_placed and ib_placed[1] and not ib_closed
    if ib_dir == 1
        if not ib_f1 and low <= ib_e1
            ib_f1 := true
        if ib_useAdd and not ib_f2 and low <= ib_e2
            ib_f2 := true
    if ib_dir == -1
        if not ib_f1 and high >= ib_e1
            ib_f1 := true
        if ib_useAdd and not ib_f2 and high >= ib_e2
            ib_f2 := true
ib_firstFill = (ib_f1 or ib_f2) and not (ib_f1[1] or ib_f2[1])
if ib_f1 or ib_f2
    ib_avgPx := ib_f1 and ib_f2 ? (ib_e1 * ib_q1 + ib_e2 * ib_q2) / (ib_q1 + ib_q2) : ib_f1 ? ib_e1 : ib_e2
if ib_firstFill
    ib_curStop := ib_zstop
    ib_curTP := f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    ib_beDone := false
if ibBE and not ib_beDone and (ib_f1 or ib_f2) and not ib_closed
    if ib_dir == 1 and high >= ib_rH
        ib_curStop := math.max(ib_curStop, ib_avgPx)
        ib_beDone := true
    if ib_dir == -1 and low <= ib_rL
        ib_curStop := math.min(ib_curStop, ib_avgPx)
        ib_beDone := true
if not na(ib_curStop)
    strategy.exit("IBLx",  from_entry = "IBL",  stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBL2x", from_entry = "IBL2", stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBSx",  from_entry = "IBS",  stop = ib_curStop, limit = ib_curTP)
    strategy.exit("IBS2x", from_entry = "IBS2", stop = ib_curStop, limit = ib_curTP)
if (ib_f1 or ib_f2) and not ib_closed and not na(ib_curStop)
    if ib_dir == 1 and (low <= ib_curStop or high >= ib_curTP)
        ib_closed := true
    if ib_dir == -1 and (high >= ib_curStop or low <= ib_curTP)
        ib_closed := true
if ib_closed or flatten or not runIB or (noDbl and ib_oppBroke) or ((not ibWin) and not (ib_f1 or ib_f2))
    strategy.cancel("IBL")
    strategy.cancel("IBL2")
    strategy.cancel("IBS")
    strategy.cancel("IBS2")

// ---- HAND-OVER: an ORB that armed but never executed gives the seat to the IB ----
// The ORB only keeps the day if it FILLED. Unfilled, its limits are pulled at the moment selected in the
// Strategies group - when the IB arms (default), when the IB range completes, or never - and the IB takes over.
orbGiveWay = orbHandOver == "When the IB range breaks" ? (ib_dir != 0 and ib_broke) : orbHandOver == "When the IB range completes" ? ibFormed : false
if runORB and runIB and orbGiveWay and not or_closed and not or_dead and not (or_f1 or or_f2)
    strategy.cancel("ORL")
    strategy.cancel("ORL2")
    strategy.cancel("ORS")
    strategy.cancel("ORS2")
    or_dead := true

// ---- IB study A: from the fill to EOD, did price touch each level? ----
var bool  ib_trk    = false
var int   ib_tdir   = 0
var float ibL_tp0   = na
var float ibL_tp10  = na
var float ibL_tp30  = na
var float ibL_tp50  = na
var float ibL_tp100 = na
var float ibL_sl    = na
var bool  ibR_tp0   = false
var bool  ibR_tp10  = false
var bool  ibR_tp30  = false
var bool  ibR_tp50  = false
var bool  ibR_tp100 = false
var bool  ibR_sl    = false
if newSession
    ib_trk := false
if ib_firstFill and not na(ib_rng)
    ib_trk    := true
    ib_tdir   := ib_dir
    ibL_tp0   := ib_dir == 1 ? ib_rH : ib_rL
    ibL_tp10  := ib_dir == 1 ? ib_rH + 0.10*ib_rng : ib_rL - 0.10*ib_rng
    ibL_tp30  := ib_dir == 1 ? ib_rH + 0.30*ib_rng : ib_rL - 0.30*ib_rng
    ibL_tp50  := ib_dir == 1 ? ib_rH + 0.50*ib_rng : ib_rL - 0.50*ib_rng
    ibL_tp100 := ib_dir == 1 ? ib_rH + 1.00*ib_rng : ib_rL - 1.00*ib_rng
    ibL_sl    := ib_dir == 1 ? ib_rL : ib_rH
    ibR_tp0   := false
    ibR_tp10  := false
    ibR_tp30  := false
    ibR_tp50  := false
    ibR_tp100 := false
    ibR_sl    := false
if ib_trk
    if ib_tdir == 1
        ibR_tp0   := ibR_tp0   or high >= ibL_tp0
        ibR_tp10  := ibR_tp10  or high >= ibL_tp10
        ibR_tp30  := ibR_tp30  or high >= ibL_tp30
        ibR_tp50  := ibR_tp50  or high >= ibL_tp50
        ibR_tp100 := ibR_tp100 or high >= ibL_tp100
        ibR_sl    := ibR_sl    or low  <= ibL_sl
    else
        ibR_tp0   := ibR_tp0   or low  <= ibL_tp0
        ibR_tp10  := ibR_tp10  or low  <= ibL_tp10
        ibR_tp30  := ibR_tp30  or low  <= ibL_tp30
        ibR_tp50  := ibR_tp50  or low  <= ibL_tp50
        ibR_tp100 := ibR_tp100 or low  <= ibL_tp100
        ibR_sl    := ibR_sl    or high >= ibL_sl
    if flatten
        f_pushTrade(1, ib_rng / ib_rL * 100, ibR_tp0, ibR_tp10, ibR_tp30, ibR_tp50, ibR_tp100, ibR_sl)
        ib_trk := false

// ---- IB study B: armed -> 25% / 50% pullback -> which levels print from there, filed at the EOD flatten ----
var bool  ibP_act  = false
var int   ibP_dir  = 0
var float ibP_rngP = na
var float ibP_p25  = na
var float ibP_p50  = na
var bool  ibP_r25  = false
var bool  ibP_r50  = false
var ibP_lv  = array.new_float(6, na)      // 0 TP0, 1 TP10, 2 TP30, 3 TP50, 4 TP100, 5 SL
var ibP_h25 = array.new_bool(6, false)
var ibP_h50 = array.new_bool(6, false)
if newSession
    ibP_act := false
if ib_broke and not ib_broke[1] and ib_dir != 0 and not na(ib_rng) and ib_rL > 0
    ibP_act  := true
    ibP_dir  := ib_dir
    ibP_rngP := ib_rng / ib_rL * 100
    ibP_p25  := f_p25(ib_dir, ib_rL, ib_rng)
    ibP_p50  := f_p50(ib_rL, ib_rng)
    ibP_r25  := false
    ibP_r50  := false
    array.set(ibP_lv, 0, ib_dir == 1 ? ib_rH : ib_rL)
    array.set(ibP_lv, 1, ib_dir == 1 ? ib_rH + 0.10*ib_rng : ib_rL - 0.10*ib_rng)
    array.set(ibP_lv, 2, ib_dir == 1 ? ib_rH + 0.30*ib_rng : ib_rL - 0.30*ib_rng)
    array.set(ibP_lv, 3, ib_dir == 1 ? ib_rH + 0.50*ib_rng : ib_rL - 0.50*ib_rng)
    array.set(ibP_lv, 4, ib_dir == 1 ? ib_rH + 1.00*ib_rng : ib_rL - 1.00*ib_rng)
    array.set(ibP_lv, 5, ib_dir == 1 ? ib_rL : ib_rH)
    for k = 0 to 5
        array.set(ibP_h25, k, false)
        array.set(ibP_h50, k, false)
if ibP_act
    up    = ibP_dir == 1
    new25 = false
    new50 = false
    if not ibP_r25 and (up ? low <= ibP_p25 : high >= ibP_p25)
        ibP_r25 := true
        new25    := true
    if not ibP_r50 and (up ? low <= ibP_p50 : high >= ibP_p50)
        ibP_r50 := true
        new50    := true
    // On the bar that REACHES the pullback the touch must be confirmed by the CLOSE: the last tick of that bar is
    // beyond the level, so it traded there after the retrace low/high. Later bars count an ordinary wick touch.
    for k = 0 to 5
        lv   = array.get(ibP_lv, k)
        isTp = k <= 4
        wick = isTp ? (up ? high >= lv : low <= lv) : (up ? low <= lv : high >= lv)
        cls  = isTp ? (up ? close >= lv : close <= lv) : (up ? close <= lv : close >= lv)
        if ibP_r25 and (new25 ? cls : wick)
            array.set(ibP_h25, k, true)
        if ibP_r50 and (new50 ? cls : wick)
            array.set(ibP_h50, k, true)
    if flatten
        f_pbPush(1, ibP_rngP, ibP_r25, ibP_r50, ibP_h25, ibP_h50)
        ibP_act := false

// ---------------------------------------------------------------- EOD flatten + daily max-loss halt
if flatten
    strategy.close_all(comment = "EOD flat")
if dailyHalt
    strategy.close_all(comment = "Daily max loss")
    strategy.cancel_all()

// ---------------------------------------------------------------- Automation: PickMyTrade webhook JSON (net position)
f_pmt(string act, float q, float slp, float tpp) =>
    '{"token":"' + pmtToken + '","account_id":"' + pmtAcct + '","symbol":"' + pmtSym +
      '","action":"' + act + '","quantity":' + str.tostring(q) +
      ',"order_type":"' + pmtType +
      '","sl":' + str.tostring(math.round_to_mintick(slp)) +
      ',"tp":' + str.tostring(math.round_to_mintick(tpp)) + '}'
liveORB  = (or_f1 or or_f2) and not or_closed
autoStop = liveORB ? or_curStop : ib_curStop
autoTP   = liveORB ? or_curTP  : ib_curTP
autoQty  = math.abs(strategy.position_size)   // actual net contracts (respects % sizing)
buyNow   = strategy.position_size > 0 and (strategy.position_size[1] <= 0 or strategy.position_size > strategy.position_size[1])
sellNow  = strategy.position_size < 0 and (strategy.position_size[1] >= 0 or strategy.position_size < strategy.position_size[1])
closeNow = flatten and strategy.position_size[1] != 0
if autoOn and buyNow
    alert(f_pmt("buy",  autoQty, autoStop, autoTP), alert.freq_once_per_bar)
if autoOn and sellNow
    alert(f_pmt("sell", autoQty, autoStop, autoTP), alert.freq_once_per_bar)
if autoOn and closeNow
    alert(f_pmt("close", 0, 0.0, 0.0), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Break alerts (fire once when each range breaks)
if brkAlerts and runORB and or_dir != 0 and or_broke and not or_broke[1]
    orTPa = f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    alert("ORB BREAK  " + (or_dir == 1 ? "LONG" : "SHORT") +
         "  | broke " + str.tostring(math.round_to_mintick(or_dir == 1 ? or_rH : or_rL)) +
         "  | entry " + str.tostring(math.round_to_mintick(or_e1)) + " x" + str.tostring(or_q1, "#.#") +
         (or_useAdd ? "  + " + str.tostring(math.round_to_mintick(or_e2)) + " x" + str.tostring(or_q2, "#.#") : "") +
         "  | stop " + str.tostring(math.round_to_mintick(or_zstop)) +
         "  | target " + str.tostring(math.round_to_mintick(orTPa)), alert.freq_once_per_bar)
if brkAlerts and runIB and ib_dir != 0 and ib_broke and not ib_broke[1]
    ibTPa = f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    alert("IB BREAK  " + (ib_dir == 1 ? "LONG" : "SHORT") +
         "  | broke " + str.tostring(math.round_to_mintick(ib_dir == 1 ? ib_rH : ib_rL)) +
         "  | entry " + str.tostring(math.round_to_mintick(ib_e1)) + " x" + str.tostring(ib_q1, "#.#") +
         (ib_useAdd ? "  + " + str.tostring(math.round_to_mintick(ib_e2)) + " x" + str.tostring(ib_q2, "#.#") : "") +
         "  | stop " + str.tostring(math.round_to_mintick(ib_zstop)) +
         "  | target " + str.tostring(math.round_to_mintick(ibTPa)), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Risk/Reward + fib tool
// Drawn when the ENTRY ORDER IS ACTUALLY PLACED (or_placed / ib_placed), so a break that any filter rejects -
// wrong weekday, range too small, past the cutoff, double-break day, daily loss halt, sizing under one contract,
// or an IB skipped because the ORB traded - draws nothing at all.
// ANCHORING: y is price and x is BAR INDEX, both fixed at creation. The box is one bar wide to begin with and its
// right edge is extended bar by bar while the setup is live, so it always covers real bars - it never projects
// into empty space past the last bar and never stretches across a session gap. Nothing moves when you pan or zoom.
// HISTORY: every valid setup keeps its boxes and fib lines, so you can scroll back and read the risk/reward of
// any past setup at the price levels it actually had. Only the text labels are capped (newest few by default),
// since those are what turn a long history into noise. Both limits are inputs; 0 on either means keep everything.
var array<box>   dBox = array.new<box>()
var array<line>  dLin = array.new<line>()
var array<label> dLab = array.new<label>()

f_trimDraws() =>
    if keepBox > 0
        while array.size(dBox) > keepBox * 2
            box.delete(array.shift(dBox))
        while array.size(dLin) > keepBox * 3
            line.delete(array.shift(dLin))
    if keepLab > 0
        while array.size(dLab) > keepLab
            label.delete(array.shift(dLab))

// q = contracts on this entry. ent2/q2 describe the average-down unit when one is armed - it gets no box of its
// own, its numbers ride along in the label so the chart stays readable.
f_drawRR(int d, float ent, float zstop, float ptp, float q, color sigCol, string tag, float ent2, float q2) =>
    riskUsd = math.abs(ent - zstop) * ptVal * q
    rewUsd  = math.abs(ptp - ent) * ptVal * q
    risk1   = math.abs(ent - zstop) * ptVal
    rew1    = math.abs(ptp - ent) * ptVal
    rrr = riskUsd > 0 ? rewUsd / riskUsd : na
    bw = box.new(bar_index, d == 1 ? ptp : ent, bar_index + 1, d == 1 ? ent : ptp, xloc = xloc.bar_index, border_color = sigCol, border_width = 1, bgcolor = color.new(color.green, 82))
    br = box.new(bar_index, d == 1 ? ent : zstop, bar_index + 1, d == 1 ? zstop : ent, xloc = xloc.bar_index, border_color = sigCol, border_width = 1, bgcolor = color.new(color.red, 82))
    txt = tag + "  " + str.tostring(q, "#.#") + " contract" + (q == 1 ? "" : "s") +
         "  Risk $" + str.tostring(riskUsd, "#") + " | Reward $" + str.tostring(rewUsd, "#") + " (" + str.tostring(rrr, "#.##") + "R)" +
         "\n1 contract: Risk $" + str.tostring(risk1, "#") + " | Reward $" + str.tostring(rew1, "#")
    if not na(ent2) and q2 > 0
        totR = riskUsd + math.abs(ent2 - zstop) * ptVal * q2
        totW = rewUsd  + math.abs(ptp - ent2)  * ptVal * q2
        txt := txt + "\n+ avg-down " + str.tostring(q2, "#.#") + " @ " + str.tostring(math.round_to_mintick(ent2)) +
             "  ->  setup total Risk $" + str.tostring(totR, "#") + " | Reward $" + str.tostring(totW, "#") +
             " (" + str.tostring(totR > 0 ? totW / totR : na, "#.##") + "R)"
    lb = label.new(bar_index + 1, ent, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)
    array.push(dBox, bw)
    array.push(dBox, br)
    array.push(dLab, lb)
    [bw, br, lb]

f_drawFibs(float rL, float rg, color sigCol, array<line> dest) =>
    array.clear(dest)
    for i = 1 to 3
        y = rL + i * 0.25 * rg
        ln = line.new(bar_index, y, bar_index + 1, y, xloc = xloc.bar_index, color = color.new(sigCol, 35), style = line.style_dotted, width = 1)
        array.push(dest, ln)
        array.push(dLin, ln)

// stretch the live setup's drawings to the current bar; prices stay exactly where they were set
f_grow(box bw, box br, label lb, array<line> fib) =>
    if not na(bw)
        box.set_right(bw, bar_index)
        box.set_right(br, bar_index)
        label.set_x(lb, bar_index)
    if array.size(fib) > 0
        for i = 0 to array.size(fib) - 1
            line.set_x2(array.get(fib, i), bar_index)

var box   orbBw = na
var box   orbBr = na
var label orbLb = na
var bool  orbGrow = false
var array<line> orbFib = array.new<line>()
if runORB and or_placed and not or_placed[1] and not na(or_e1) and not na(or_zstop)
    orTP = f_tp(or_dir, or_rH, or_rL, or_rng, dHigh, dLow, orbTpL, orbTpS)
    orbBw := na
    orbBr := na
    orbLb := na
    if showFibs
        f_drawFibs(or_rL, or_rng, color.new(color.orange, 0), orbFib)
    if showRR
        [bw, br, lb] = f_drawRR(or_dir, or_e1, or_zstop, orTP, or_q1, color.new(color.orange, 0), "ORB", or_useAdd ? or_e2 : na, or_useAdd ? or_q2 : 0)
        orbBw := bw
        orbBr := br
        orbLb := lb
    orbGrow := true
    f_trimDraws()
if orbGrow
    f_grow(orbBw, orbBr, orbLb, orbFib)
    if or_closed or or_dead or flatten or (not (or_f1 or or_f2) and not orbWin)
        orbGrow := false

var box   ibBw = na
var box   ibBr = na
var label ibLb = na
var bool  ibGrow = false
var array<line> ibFib = array.new<line>()
if runIB and ib_placed and not ib_placed[1] and not na(ib_e1) and not na(ib_zstop)
    ibTP = f_tp(ib_dir, ib_rH, ib_rL, ib_rng, dHigh, dLow, ibTpL, ibTpS)
    ibBw := na
    ibBr := na
    ibLb := na
    if showFibs
        f_drawFibs(ib_rL, ib_rng, color.new(color.teal, 0), ibFib)
    if showRR
        [bw2, br2, lb2] = f_drawRR(ib_dir, ib_e1, ib_zstop, ibTP, ib_q1, color.new(color.teal, 0), "IB", ib_useAdd ? ib_e2 : na, ib_useAdd ? ib_q2 : 0)
        ibBw := bw2
        ibBr := br2
        ibLb := lb2
    ibGrow := true
    f_trimDraws()
if ibGrow
    f_grow(ibBw, ibBr, ibLb, ibFib)
    if ib_closed or flatten or (not (ib_f1 or ib_f2) and not ibWin)
        ibGrow := false

// ---------------------------------------------------------------- Strategy rules panel (top-right)
var table info = na
if showInfo and barstate.islast
    orbTxt = orbMode == "All at 25% pullback" ? str.tostring(orbQtyAll, "#.#") + " @ 25%" : orbMode == "All at 50% pullback" ? str.tostring(orbQtyAll, "#.#") + " @ 50%" : str.tostring(orbQty25, "#.#") + " @ 25% + " + str.tostring(orbQty50, "#.#") + " @ 50%"
    ibTxt  = ibMode  == "All at 25% pullback" ? str.tostring(ibQtyAll,  "#.#") + " @ 25%" : ibMode  == "All at 50% pullback" ? str.tostring(ibQtyAll,  "#.#") + " @ 50%" : str.tostring(ibQty25,  "#.#") + " @ 25% + " + str.tostring(ibQty50,  "#.#") + " @ 50%"
    info := table.new(position.top_right, 1, 13, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 50), border_width = 1)
    table.cell(info, 0, 0,  "BREAK-THEN-PULLBACK  (ORB + IB)",                       text_color = color.aqua,   text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 1,  "Ranges: ORB " + orbSess + " | IB " + ibSess + "  (" + tz + ")", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 2,  "ARM on the break: high breaks = LONG, low = SHORT",     text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 3,  "  (no first/last extreme rule - first side to break)",  text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 4,  "ORB entry: " + orbTxt,                                  text_color = color.orange, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 5,  "IB entry:  " + ibTxt,                                   text_color = color.teal,   text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 6,  "Stop: the OTHER edge of the range (both units)",        text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 7,  "Target ORB: L " + orbTpL + " / S " + orbTpS,            text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 8,  "Target IB:  L " + ibTpL  + " / S " + ibTpS,             text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 9,  "ORB executes -> no IB today" + (ibAfterORB ? " (unless it closes)" : ""), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 10, "ORB unfilled -> cancel " + str.lower(orbHandOver) + " -> IB trades", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 11, (noDbl ? "Skip double-break days | " : "") + "Flatten " + str.tostring(flatH) + ":" + (flatM < 10 ? "0" : "") + str.tostring(flatM), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 0, 12, "Odds live in the table; > marks where price is now",    text_color = color.aqua,   text_size = size.small, text_halign = text.align_left)

// ---------------------------------------------------------------- Probability table
// Columns: N = sample size, Reach = how often that starting point is even reached, then the odds of price trading
// to each level from that starting point, before the EOD flatten.
//   "From FILL" rows     : start = the entry fill, split by range size. Reach is n/a (the trade filled by definition).
//   "From 25% PB" rows   : start = the moment price retraces to the 25% fib. Reach = share of armed setups that
//                          pull back that far. This is the number to read when your limit at the 25% line fills.
//   "From 50% PB" rows   : same from the 50% line - a deeper pullback, a different (usually lower) set of odds, and
//                          a smaller sample since price must pass the 25% line to get there.
//   SL column            : the opposite range edge - the stop this strategy uses.
tPos  = tblPos == "Top right" ? position.top_right : tblPos == "Bottom left" ? position.bottom_left : tblPos == "Top left" ? position.top_left : position.bottom_right
tRows = 8 + (pbSplit ? 12 : 4)

var table probTbl = na

f_tblRow(int row, string lbl, int nn, string reach, int t0, int t1, int t2, int t3, int t4, int sl, color txt, color bg) =>
    table.cell(probTbl, 0, row, lbl,               text_color = txt,          bgcolor = bg, text_size = size.normal, text_halign = text.align_left)
    table.cell(probTbl, 1, row, str.tostring(nn),  text_color = color.white,  bgcolor = bg, text_size = size.normal)
    table.cell(probTbl, 2, row, reach,             text_color = color.silver, bgcolor = bg, text_size = size.normal)
    table.cell(probTbl, 3, row, f_pctStr(t0, nn),  text_color = color.lime,   bgcolor = bg, text_size = size.normal)
    table.cell(probTbl, 4, row, f_pctStr(t1, nn),  text_color = color.lime,   bgcolor = bg, text_size = size.normal)
    table.cell(probTbl, 5, row, f_pctStr(t2, nn),  text_color = color.lime,   bgcolor = bg, text_size = size.normal)
    table.cell(probTbl, 6, row, f_pctStr(t3, nn),  text_color = color.lime,   bgcolor = bg, text_size = size.normal)
    table.cell(probTbl, 7, row, f_pctStr(t4, nn),  text_color = color.lime,   bgcolor = bg, text_size = size.normal)
    table.cell(probTbl, 8, row, f_pctStr(sl, nn),  text_color = color.red,    bgcolor = bg, text_size = size.normal)

// where we are right now, used to tint the row that applies (nothing is drawn on the chart)
cNow = color.new(color.blue, 40)      // the row that is live on this bar
cWas = color.new(color.blue, 78)      // a depth price has already passed through
cOff = color.black

if showTable and barstate.islast
    if na(probTbl)
        probTbl := table.new(tPos, 9, tRows, bgcolor = color.black, border_color = color.new(color.white, 70), border_width = 1, frame_color = color.white, frame_width = 1)
    // live state per strategy: 0 = not in play, 1 = broke, 2 = at the 25% pullback, 3 = at the 50% pullback
    stA  = array.from(orP_act ? (orP_r50 ? 3 : orP_r25 ? 2 : 1) : 0, ibP_act ? (ibP_r50 ? 3 : ibP_r25 ? 2 : 1) : 0)
    rgA  = array.from(orP_act ? orP_rngP : na, ibP_act ? ibP_rngP : na)
    filA = array.from(((or_f1 or or_f2) and not or_closed) ? 1 : 0, ((ib_f1 or ib_f2) and not ib_closed) ? 1 : 0)
    hdr  = array.from("From FILL - by range size", "N", "Reach", "TP0", "TP10", "TP30", "TP50", "TP100", "SL")
    for c = 0 to 8
        table.cell(probTbl, c, 0, array.get(hdr, c), text_color = color.black, bgcolor = color.white, text_size = size.normal, text_halign = c == 0 ? text.align_left : text.align_center)
    // ---- section 1: from the fill, segmented by range size ----
    for s = 0 to 1
        rr = f_ranges(s)
        b1 = autoMode ? f_b1(rr) : (s == 0 ? orbB1 : ibB1)
        b2 = autoMode ? f_b2(rr) : (s == 0 ? orbB2 : ibB2)
        nm = s == 0 ? "ORB" : "IB"
        s1 = na(b1) ? "?" : str.tostring(b1, "#.##") + "%"
        s2 = na(b2) ? "?" : str.tostring(b2, "#.##") + "%"
        for bkt = 0 to 2
            [nn, a0, a1, a2, a3, a4, a5] = f_seg(s, bkt, b1, b2)
            here = hiLive and array.get(stA, s) > 0 and not na(array.get(rgA, s)) and f_bkt(array.get(rgA, s), b1, b2) == bkt
            inTr = here and array.get(filA, s) == 1
            lbl  = (inTr ? "> " : "") + (bkt == 0 ? nm + " S <" + s1 : bkt == 1 ? nm + " M " + s1 + "-" + s2 : nm + " L >=" + s2)
            f_tblRow(s * 3 + bkt + 1, lbl, nn, "-", a0, a1, a2, a3, a4, a5, color.white, inTr ? cNow : here ? cWas : cOff)
    // ---- section 2: from the 25% / 50% pullback (the two entry levels) ----
    hdr2 = array.from("From PULLBACK", "N", "Reach", "TP0", "TP10", "TP30", "TP50", "TP100", "SL")
    for c = 0 to 8
        table.cell(probTbl, c, 7, array.get(hdr2, c), text_color = color.black, bgcolor = color.new(color.aqua, 20), text_size = size.normal, text_halign = c == 0 ? text.align_left : text.align_center)
    for s = 0 to 1
        rr2 = f_ranges(s)
        c1  = autoMode ? f_b1(rr2) : (s == 0 ? orbB1 : ibB1)
        c2  = autoMode ? f_b2(rr2) : (s == 0 ? orbB2 : ibB2)
        nm2 = s == 0 ? "ORB" : "IB"
        st  = array.get(stA, s)
        for d = 0 to 1
            // the deepest pullback price has reached is "now"; a shallower one it already passed is tinted faintly
            depthOn = hiLive and (d == 0 ? st >= 2 : st >= 3)
            isNow   = hiLive and (d == 0 ? st == 2 : st == 3)
            if pbSplit
                for bkt = 0 to 2
                    [nAll, nn, h0, h1, h2, h3, h4, h5] = f_pbSeg(s, d, bkt, c1, c2)
                    same = depthOn and not na(array.get(rgA, s)) and f_bkt(array.get(rgA, s), c1, c2) == bkt
                    szn  = bkt == 0 ? "S" : bkt == 1 ? "M" : "L"
                    lbl  = ((same and isNow) ? "> " : "") + nm2 + " " + szn + " from " + (d == 0 ? "25%" : "50%") + " PB"
                    f_tblRow(8 + s * 6 + bkt * 2 + d, lbl, nn, f_pctStr(nn, nAll), h0, h1, h2, h3, h4, h5, d == 0 ? color.aqua : color.yellow, (same and isNow) ? cNow : same ? cWas : cOff)
            else
                [nAll, nn, h0, h1, h2, h3, h4, h5] = f_pbSeg(s, d, -1, c1, c2)
                lbl = (isNow ? "> " : "") + nm2 + " from " + (d == 0 ? "25%" : "50%") + " pullback"
                f_tblRow(8 + s * 2 + d, lbl, nn, f_pctStr(nn, nAll), h0, h1, h2, h3, h4, h5, d == 0 ? color.aqua : color.yellow, isNow ? cNow : depthOn ? cWas : cOff)

// ---------------------------------------------------------------- Visuals
plot(runORB and not na(or_rH) ? or_rH : na, "ORB High", color = color.new(color.orange, 0),  style = plot.style_linebr)
plot(runORB and not na(or_rL) ? or_rL : na, "ORB Low",  color = color.new(color.orange, 45), style = plot.style_linebr)
plot(runORB and or_dir != 0 and not na(or_e1) ? or_e1 : na, "ORB Entry",     color = color.new(color.yellow, 0),  style = plot.style_linebr)
plot(runORB and or_useAdd ? or_e2 : na,                     "ORB Entry 2",   color = color.new(color.yellow, 40), style = plot.style_linebr)
plot(runIB and not na(ib_rH) ? ib_rH : na, "IB High", color = color.new(color.teal, 0),  style = plot.style_linebr)
plot(runIB and not na(ib_rL) ? ib_rL : na, "IB Low",  color = color.new(color.teal, 45), style = plot.style_linebr)
plot(runIB and ib_dir != 0 and not na(ib_e1) ? ib_e1 : na, "IB Entry",       color = color.new(color.aqua, 0),  style = plot.style_linebr)
plot(runIB and ib_useAdd ? ib_e2 : na,                     "IB Entry 2",     color = color.new(color.aqua, 40), style = plot.style_linebr)
