//@version=6
// IB break-then-pullback (run on a 5m chart).
//   1) First hour (09:30-10:30) sets the IB. At 10:30: bias = low-before-high (long) / high-before-low (short),
//      and the 10:30 close in the top half (long) / bottom half (short) of the IB range.
//   2) The trade ARMS only AFTER the IB level breaks (high>IB high for longs / low<IB low for shorts).
//   3) A LIMIT rests at the fib pullback line: shallow(0-25%)->25% line, deeper(25-50%)->50% line.
//   4) AVERAGE DOWN (optional): on a shallow setup (first fill at 25%), a 2nd same-size unit rests at the 50% line.
//   Stop = zone (shallow: IB low ; deeper: 75% line) — shared by both units. Optional breakeven when price
//   reclaims the IB level. TP = IB level / HOD-LOD / +10% / +30%. One setup/day, EOD flatten.
//   Capital & leverage limits removed (margin 0, big initial capital) so trades never get skipped on a small acct.
strategy("IB Break-then-Pullback", overlay = true, pyramiding = 2,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)

// ---------------------------------------------------------------- Inputs
tz        = input.string("America/New_York", "Timezone", group = "Session")
sess      = input.session("0930-1600", "RTH session", group = "Session")
ibSess    = input.session("0930-1030", "Initial Balance window", group = "Session")
allowLong = input.bool(true,  "Take longs", group = "Strategy")
allowShort= input.bool(false, "Take shorts (weak in tests)", group = "Strategy")
avgDown   = input.bool(true,  "Average down: add 2nd unit at 50% (shallow setups)", group = "Strategy")
tpMethod  = input.string("IB level", "Take profit", options = ["IB level", "HOD/LOD", "Ext 10%", "Ext 30%"], group = "Strategy")
useBE     = input.bool(false, "Breakeven when price reclaims the IB level", group = "Strategy")
qty       = input.float(1, "Contracts per unit", minval = 1, group = "Strategy")
cutH      = input.int(15, "Entry cutoff hour",   0, 23, group = "Time")
cutM      = input.int(0,  "Entry cutoff minute", 0, 59, group = "Time")
flatH     = input.int(16, "Flatten hour",   0, 23, group = "Time")
flatM     = input.int(0,  "Flatten minute", 0, 59, group = "Time")

// ---------------------------------------------------------------- Session / IB tracking
inSess     = not na(time(timeframe.period, sess, tz))
newSession = inSess and not inSess[1]
inIB       = not na(time(timeframe.period, ibSess, tz))
ibDone     = not inIB and inIB[1]

var float ibH = na
var float ibL = na
var int   ibHbar = na
var int   ibLbar = na
var float dHigh = na
var float dLow  = na
var int   dir     = 0
var bool  shallow = false
var float entry1  = na
var float entry2  = na
var float zstop   = na
var float rng     = na
var bool  broke   = false
var bool  placed  = false
var bool  wasIn   = false
var bool  done    = false

if newSession
    ibH := na
    ibL := na
    dHigh := high
    dLow  := low
    dir := 0
    shallow := false
    entry1 := na
    entry2 := na
    zstop := na
    broke := false
    placed := false
    wasIn := false
    done := false
if inIB
    if na(ibH) or high > ibH
        ibH := high
        ibHbar := bar_index
    if na(ibL) or low < ibL
        ibL := low
        ibLbar := bar_index
if inSess and not newSession
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)

// resolve setup at 10:30
if ibDone and not na(ibH) and ibH > ibL
    rng := ibH - ibL
    lowFirst = ibLbar < ibHbar
    pos = (close[1] - ibL) / rng
    if allowLong and lowFirst and pos >= 0.5
        dir := 1
        shallow := pos >= 0.75
        entry1 := shallow ? ibL + 0.75*rng : ibL + 0.5*rng
        entry2 := ibL + 0.5*rng                     // 50% line, used only if shallow + avgDown
        zstop := shallow ? ibL : ibL + 0.25*rng
    else if allowShort and (not lowFirst) and pos <= 0.5
        dir := -1
        shallow := pos <= 0.25
        entry1 := shallow ? ibL + 0.25*rng : ibL + 0.5*rng
        entry2 := ibL + 0.5*rng
        zstop := shallow ? ibH : ibL + 0.75*rng

useAdd = avgDown and shallow and not na(entry2)

// ---------------------------------------------------------------- Time gates
tod      = hour(time, tz) * 60 + minute(time, tz)
inWindow = inSess and tod <= (cutH*60 + cutM)
flatten  = tod >= (flatH*60 + flatM)

// ---------------------------------------------------------------- Detect break, then arm the resting limit(s) once
if dir == 1 and high >= ibH
    broke := true
if dir == -1 and low <= ibL
    broke := true

if dir != 0 and broke and not placed and not done and inWindow and not flatten
    if dir == 1
        strategy.entry("L", strategy.long, qty = qty, limit = entry1)
        if useAdd
            strategy.entry("L2", strategy.long, qty = qty, limit = entry2)
    else
        strategy.entry("S", strategy.short, qty = qty, limit = entry1)
        if useAdd
            strategy.entry("S2", strategy.short, qty = qty, limit = entry2)
    placed := true

// setup finished (position opened then closed) -> stop for the day
wasIn := wasIn or strategy.position_size != 0
if strategy.position_size == 0 and wasIn
    done := true
if done or flatten or not inWindow
    strategy.cancel("L")
    strategy.cancel("L2")
    strategy.cancel("S")
    strategy.cancel("S2")

// ---------------------------------------------------------------- On first fill: set TP / stop
var float curStop = na
var float curTP   = na
var bool  beDone  = false
opened = strategy.position_size != 0 and strategy.position_size[1] == 0
if opened
    curStop := zstop
    if dir == 1
        curTP := tpMethod == "HOD/LOD" ? dHigh : tpMethod == "Ext 10%" ? ibH + 0.10*rng : tpMethod == "Ext 30%" ? ibH + 0.30*rng : ibH
    else
        curTP := tpMethod == "HOD/LOD" ? dLow  : tpMethod == "Ext 10%" ? ibL - 0.10*rng : tpMethod == "Ext 30%" ? ibL - 0.30*rng : ibL
    beDone := false

// ---------------------------------------------------------------- Breakeven (uses blended avg price) when IB reclaimed
if useBE and not beDone and strategy.position_size != 0
    if strategy.position_size > 0 and high >= ibH
        curStop := math.max(curStop, strategy.position_avg_price)
        beDone  := true
    if strategy.position_size < 0 and low <= ibL
        curStop := math.min(curStop, strategy.position_avg_price)
        beDone  := true

// ---------------------------------------------------------------- Exits (both units share stop / target)
if strategy.position_size != 0
    strategy.exit("Lx",  from_entry = "L",  stop = curStop, limit = curTP)
    strategy.exit("L2x", from_entry = "L2", stop = curStop, limit = curTP)
    strategy.exit("Sx",  from_entry = "S",  stop = curStop, limit = curTP)
    strategy.exit("S2x", from_entry = "S2", stop = curStop, limit = curTP)

if flatten
    strategy.close_all(comment = "EOD flat")

// ---------------------------------------------------------------- Visuals
plot(not na(ibH) ? ibH : na, "IB High", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(not na(ibL) ? ibL : na, "IB Low",  color = color.new(color.red, 0),  style = plot.style_linebr)
plot(dir != 0 and not na(entry1) ? entry1 : na, "Entry 1", color = color.new(color.orange, 0), style = plot.style_linebr)
plot(useAdd and not na(entry2) ? entry2 : na, "Entry 2 (add)", color = color.new(color.yellow, 0), style = plot.style_linebr)
