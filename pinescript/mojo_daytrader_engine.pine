//@version=6
// ============================================================================
// MojoTrader Day-Trading Engine — NQ / ES index futures, intraday
// ============================================================================
// WHY THIS EXISTS
//   This repo has 18 separate strategy scripts. Each one re-implements its own
//   session handling, sizing, stops and exits — so their Strategy Tester numbers
//   are NOT comparable to each other. A better-looking profit factor might just
//   be a different stop rule or a different contract count, not a better edge.
//   This script runs ONE setup at a time through ONE shared risk / exit /
//   reporting engine, so setups can finally be compared head to head.
//
// WHY ONE SETUP AT A TIME
//   Pine nets every order into a single position — there is no hedging. Running
//   several setups at once lets them silently overwrite each other's stops and
//   targets, and the equity curve stops meaning anything. Selecting one keeps
//   each backtest clean. (break_pullback_strategy.pine takes the other valid
//   route — explicit ORB→IB priority rules — and that is why it is 568 lines.)
//
// THE COST PANEL — the actual point of this script
//   Zarattini & Aziz's 5-minute ORB on QQQ posts Sharpe 1.06 before costs and
//   0.23 after 2 cents/share of slippage. The edge lived inside the spread.
//   The on-chart panel reports gross P&L, commission paid, and estimated
//   slippage cost, so you can see how much of a result is real.
//
//   HOW TO USE IT: raise "Slippage (ticks)" and re-read the panel. The tick
//   count at which net profit crosses zero is the strategy's margin of safety.
//   A setup that only works at 0 ticks is not tradable. On NQ, 1 tick = 0.25pt
//   = $5/contract; on MNQ = $0.50. Getting filled at your exact stop price on a
//   fast breakout is optimistic — test at 2 ticks and up before believing it.
//
// SETUPS INCLUDED
//   1. OR15 Breakout       — 09:30–09:45 range, stop-order break of either side
//   2. IB Breakout (bias)  — 09:30–10:30 range, direction from where the IB
//                            closes inside its own range (the nqstats rule)
//   3. PDH/PDL Breakout    — prior-day high/low, ATR-based stop and target
//   4. VWAP Mean-Reversion — fade a stretched VWAP band back to VWAP
//
// Run on a 5m chart. One trade per day, flat before the close.
// ============================================================================

strategy("MojoTrader Day-Trading Engine", overlay = true, pyramiding = 0,
     max_boxes_count = 200, max_labels_count = 200, max_lines_count = 200,
     initial_capital = 30000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = input.float(0.62, "Commission $ per contract per side", minval = 0, step = 0.01, group = "1. Costs",
         tooltip = "Round turn is roughly double this. 0.62 is a typical retail MNQ/MES rate; NQ/ES is usually 2.00-2.50."),
     slippage      = input.int(2, "Slippage (ticks)", minval = 0, maxval = 20, group = "1. Costs",
         tooltip = "THE MOST IMPORTANT INPUT HERE. Applied to every entry and exit fill. Sweep it upward and watch the cost panel: the value where net profit hits zero is your margin of safety. Breakout entries are stop orders, which slip most in fast markets - 0 ticks is fantasy."))

// Pine cannot read back the slippage set in the declaration above, so the cost
// panel needs it repeated. Keep the two in sync or the panel's estimate is wrong.
slipMirror = input.int(2, "^ Repeat the slippage value here", minval = 0, maxval = 20, group = "1. Costs",
     tooltip = "MUST EQUAL the slippage above. Used only to estimate the dollar cost of slippage in the panel - Pine bakes slippage into fill prices and never reports it separately.")

// ---------------------------------------------------------------- Setup select
gSetup   = "2. Setup"
setupSel = input.string("IB Breakout (bias)", "Setup to run", group = gSetup,
     options = ["OR15 Breakout", "IB Breakout (bias)", "PDH/PDL Breakout", "VWAP Mean-Reversion"],
     tooltip = "One at a time, on purpose. Pine nets all orders into a single position, so two setups running together corrupt each other's stops and targets.")
dirMode  = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = gSetup)

// ---------------------------------------------------------------- Session
gSess  = "3. Session"
tz     = input.string("America/New_York", "Timezone", group = gSess)
sess   = input.session("0930-1600", "RTH session", group = gSess)
orSess = input.session("0930-0945", "Opening range window", group = gSess)
ibSess = input.session("0930-1030", "Initial Balance window", group = gSess)
cutH   = input.int(15, "Entry cutoff hour",   0, 23, group = gSess)
cutM   = input.int(0,  "Entry cutoff minute", 0, 59, group = gSess)
flatH  = input.int(15, "Flatten hour",   0, 23, group = gSess)
flatM  = input.int(55, "Flatten minute", 0, 59, group = gSess,
     tooltip = "Flatten a few minutes before the cash close. Exiting exactly at 16:00 assumes a fill in the least liquid print of the day.")

// ---------------------------------------------------------------- Weekday filter
gDay = "4. Trade days"
dMon = input.bool(true, "Monday",    group = gDay)
dTue = input.bool(true, "Tuesday",   group = gDay)
dWed = input.bool(true, "Wednesday", group = gDay)
dThu = input.bool(true, "Thursday",  group = gDay)
dFri = input.bool(true, "Friday",    group = gDay)

// ---------------------------------------------------------------- Risk sizing
gRisk   = "5. Risk"
useRisk = input.bool(true, "Size by % risk (else fixed contracts)", group = gRisk)
acctSz  = input.float(30000, "Account size $ (fixed — NO compounding)", minval = 1, group = gRisk,
     tooltip = "Sizing uses this constant every day; it does not grow or shrink with P&L. Dollar risk per trade stays flat, so the equity curve shows the EDGE rather than the compounding.")
riskPct = input.float(1.0, "Risk per trade (% of capital)", minval = 0.1, step = 0.1, group = gRisk)
fixQty  = input.float(1, "Fixed contracts (when % risk is off)", minval = 1, group = gRisk)
maxCtr  = input.int(50, "Max contracts (safety cap)", minval = 1, group = gRisk,
     tooltip = "Stops a very tight stop distance from sizing into an absurd position.")
maxDay  = input.float(2.0, "Daily max loss (% of capital, 0 = off)", minval = 0, step = 0.5, group = gRisk)
ptValIn = input.float(0, "$ per point override (0 = auto)", minval = 0, group = gRisk,
     tooltip = "Auto reads the symbol. Override if it is wrong. NQ=20, MNQ=2, ES=50, MES=5.")

// ---------------------------------------------------------------- Exits
gExit    = "6. Exits"
tgtMult  = input.float(1.5, "Target = N x range beyond the break", minval = 0.25, step = 0.25, group = gExit)
useBE    = input.bool(false, "Move stop to breakeven at +1R", group = gExit,
     tooltip = "Cuts drawdown, and usually cuts expectancy too. Test it, do not assume it.")
atrLen   = input.int(14, "ATR length (PDH/PDL setup)", minval = 1, group = gExit)
atrStop  = input.float(1.0, "PDH/PDL stop = N x ATR",   minval = 0.1, step = 0.1, group = gExit)
atrTgt   = input.float(2.0, "PDH/PDL target = N x ATR", minval = 0.1, step = 0.1, group = gExit)
ibZone   = input.string("Quartile (25%)", "IB bias zone", options = ["Quartile (25%)", "Half (50%)"], group = gExit,
     tooltip = "Quartile: only trade when the IB closes in the extreme 25% of its range - fewer, stronger signals.")
vwapMult = input.float(2.0, "VWAP entry band (std dev)", minval = 0.5, step = 0.25, group = gExit)
vwapStop = input.float(3.0, "VWAP stop band (std dev)",  minval = 0.5, step = 0.25, group = gExit)

// ---------------------------------------------------------------- Display
gShow     = "7. Display"
showPanel = input.bool(true, "Show cost panel", group = gShow)
showLvls  = input.bool(true, "Show levels on chart", group = gShow)

// ============================================================================
// Helpers (global scope — Pine does not allow functions inside if-blocks)
// ============================================================================
f_ptVal() =>
    ptValIn > 0 ? ptValIn : syminfo.pointvalue

// Contracts = dollars at risk / (stop distance in points x $ per point).
// Rounded DOWN, so realised risk is always <= the stated risk, never over.
f_size(float ptDist) =>
    float ptv    = f_ptVal()
    float budget = acctSz * (riskPct / 100.0)
    float raw    = ptDist > 0 and ptv > 0 ? budget / (ptDist * ptv) : 0.0
    int   n      = math.max(1, int(math.floor(raw)))
    math.min(n, maxCtr)

f_row(table tb, int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c,          text_size = size.small, text_halign = text.align_right)

// ============================================================================
// Session tracking
// ============================================================================
inSess     = not na(time(timeframe.period, sess,   tz))
newSession = inSess and not inSess[1]
inOR       = not na(time(timeframe.period, orSess, tz))
orDone     = not inOR and inOR[1]
inIB       = not na(time(timeframe.period, ibSess, tz))
ibDone     = not inIB and inIB[1]

dow   = dayofweek(time, tz)
okDay = (dow == dayofweek.monday and dMon) or (dow == dayofweek.tuesday and dTue) or (dow == dayofweek.wednesday and dWed) or (dow == dayofweek.thursday and dThu) or (dow == dayofweek.friday and dFri)

tod       = hour(time, tz) * 60 + minute(time, tz)
beforeCut = tod <= (cutH * 60 + cutM)
flatten   = tod >= (flatH * 60 + flatM)

allowLong  = dirMode != "Short only"
allowShort = dirMode != "Long only"

// ============================================================================
// Per-day state
// ============================================================================
var float orH      = na
var float orL      = na
var float ibH      = na
var float ibL      = na
var int   dir      = 0      // +1 long, -1 short, 0 none / undecided
var float entryLvl = na
var float stopLvl  = na
var float tgtLvl   = na
var float curStop  = na
var bool  isLimit  = false  // true = resting limit entry, false = stop-order break
var bool  armed    = false
var bool  traded   = false
var bool  wasIn    = false
var bool  beDone   = false
var float dayStart = na

if newSession
    orH := na
    orL := na
    ibH := na
    ibL := na
    dir := 0
    entryLvl := na
    stopLvl := na
    tgtLvl := na
    curStop := na
    isLimit := false
    armed := false
    traded := false
    wasIn := false
    beDone := false
    dayStart := strategy.equity

if inOR
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low  : math.min(orL, low)
if inIB
    ibH := na(ibH) ? high : math.max(ibH, high)
    ibL := na(ibL) ? low  : math.min(ibL, low)

dayPnL    = na(dayStart) ? 0.0 : strategy.equity - dayStart
dailyHalt = maxDay > 0 and dayPnL <= -(acctSz * maxDay / 100.0)

// Reference data
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdL = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
atr = ta.atr(atrLen)
[vwapV, vwapUp, vwapDn] = ta.vwap(hlc3, newSession, vwapMult)
[vwapV2, vwapSU, vwapSD] = ta.vwap(hlc3, newSession, vwapStop)

// ============================================================================
// SETUP 1 — OR15 Breakout
//   The first 15 minutes set the range. Whichever side breaks first takes the
//   trade; stop at the opposite extreme, target a multiple of the range.
//   Both sides rest as stop orders, so direction is only known on the fill.
// ============================================================================
if setupSel == "OR15 Breakout" and orDone and not armed and not na(orH) and orH > orL
    armed := true

// ============================================================================
// SETUP 2 — IB Breakout with bias (the nqstats rule)
//   Where the first hour CLOSES inside its own range predicts which extreme
//   breaks. Close in the top quartile -> the high tends to go; bottom quartile
//   -> the low. The middle of the range is a coin flip, so stand aside.
// ============================================================================
if setupSel == "IB Breakout (bias)" and ibDone and not armed and not na(ibH) and ibH > ibL
    float rng   = ibH - ibL
    float pos   = (close[1] - ibL) / rng
    float upThr = ibZone == "Quartile (25%)" ? 0.75 : 0.5
    float dnThr = ibZone == "Quartile (25%)" ? 0.25 : 0.5
    if allowLong and pos >= upThr
        dir := 1
        entryLvl := ibH
        stopLvl := ibL
        tgtLvl := ibH + tgtMult * rng
        armed := true
    else if allowShort and pos <= dnThr
        dir := -1
        entryLvl := ibL
        stopLvl := ibH
        tgtLvl := ibL - tgtMult * rng
        armed := true

// ============================================================================
// SETUP 3 — PDH/PDL Breakout
//   Prior-day high and low are the most-watched levels on the chart. A break of
//   either arms a trade, sized off ATR rather than off the level distance, so
//   position size does not explode on a quiet day.
// ============================================================================
if setupSel == "PDH/PDL Breakout" and newSession and not na(pdH) and not na(pdL)
    armed := true

// ============================================================================
// SETUP 4 — VWAP Mean-Reversion
//   Fade price stretched N std devs from session VWAP, targeting VWAP itself.
//   The one setup that arms dynamically — its trigger can fire at any point in
//   the session rather than at a fixed clock time.
// ============================================================================
if setupSel == "VWAP Mean-Reversion" and inSess and not traded and not armed and not na(vwapV)
    if allowLong and low <= vwapDn
        dir := 1
        entryLvl := vwapDn
        stopLvl := vwapSD
        tgtLvl := vwapV
        isLimit := true
        armed := true
    else if allowShort and high >= vwapUp
        dir := -1
        entryLvl := vwapUp
        stopLvl := vwapSU
        tgtLvl := vwapV
        isLimit := true
        armed := true

// ============================================================================
// Order placement
// ============================================================================
canTrade  = okDay and inSess and beforeCut and not flatten and not traded and not dailyHalt and armed
twoSided  = setupSel == "OR15 Breakout" or setupSel == "PDH/PDL Breakout"
oneSided  = setupSel == "IB Breakout (bias)" or setupSel == "VWAP Mean-Reversion"

// --- Two-sided: rest both stop orders, first fill wins
if canTrade and twoSided and strategy.position_size == 0
    float hiLvl = setupSel == "OR15 Breakout" ? orH : pdH
    float loLvl = setupSel == "OR15 Breakout" ? orL : pdL
    bool  ready = not na(hiLvl) and not na(loLvl) and hiLvl > loLvl and (setupSel == "OR15 Breakout" or not na(atr))
    if ready
        float lRisk = setupSel == "OR15 Breakout" ? hiLvl - loLvl : atrStop * atr
        float sRisk = setupSel == "OR15 Breakout" ? hiLvl - loLvl : atrStop * atr
        if allowLong
            strategy.entry("L", strategy.long,  qty = useRisk ? f_size(lRisk) : fixQty, stop = hiLvl)
        if allowShort
            strategy.entry("S", strategy.short, qty = useRisk ? f_size(sRisk) : fixQty, stop = loLvl)

// --- One-sided: a single directional order
if canTrade and oneSided and strategy.position_size == 0 and dir != 0 and not na(entryLvl) and not na(stopLvl)
    float q = useRisk ? f_size(math.abs(entryLvl - stopLvl)) : fixQty
    if dir == 1 and isLimit
        strategy.entry("L", strategy.long, qty = q, limit = entryLvl)
    else if dir == 1
        strategy.entry("L", strategy.long, qty = q, stop = entryLvl)
    else if dir == -1 and isLimit
        strategy.entry("S", strategy.short, qty = q, limit = entryLvl)
    else
        strategy.entry("S", strategy.short, qty = q, stop = entryLvl)

// ============================================================================
// Exit management
//   For the two-sided setups the levels can only be resolved AFTER the fill,
//   because which side filled is not known until then.
// ============================================================================
justFilled = strategy.position_size != 0 and strategy.position_size[1] == 0

if justFilled and twoSided
    bool  isLong = strategy.position_size > 0
    float hiLvl  = setupSel == "OR15 Breakout" ? orH : pdH
    float loLvl  = setupSel == "OR15 Breakout" ? orL : pdL
    float rng    = hiLvl - loLvl
    dir      := isLong ? 1 : -1
    entryLvl := isLong ? hiLvl : loLvl
    if setupSel == "OR15 Breakout"
        stopLvl := isLong ? loLvl : hiLvl
        tgtLvl  := isLong ? hiLvl + tgtMult * rng : loLvl - tgtMult * rng
    else
        stopLvl := isLong ? hiLvl - atrStop * atr : loLvl + atrStop * atr
        tgtLvl  := isLong ? hiLvl + atrTgt  * atr : loLvl - atrTgt  * atr
    curStop := stopLvl
    strategy.cancel(isLong ? "S" : "L")

if justFilled and oneSided
    curStop := stopLvl

// Breakeven
if useBE and not beDone and strategy.position_size != 0 and not na(entryLvl) and not na(stopLvl)
    float R = math.abs(entryLvl - stopLvl)
    if dir == 1 and high >= entryLvl + R
        curStop := math.max(nz(curStop, stopLvl), entryLvl)
        beDone  := true
    if dir == -1 and low <= entryLvl - R
        curStop := math.min(nz(curStop, stopLvl), entryLvl)
        beDone  := true

if strategy.position_size != 0 and not na(curStop) and not na(tgtLvl)
    strategy.exit("Lx", from_entry = "L", stop = curStop, limit = tgtLvl)
    strategy.exit("Sx", from_entry = "S", stop = curStop, limit = tgtLvl)

// One trade per day
wasIn := wasIn or strategy.position_size != 0
if strategy.position_size == 0 and wasIn
    traded := true

// Housekeeping
if traded or flatten or not beforeCut or dailyHalt or not okDay
    strategy.cancel("L")
    strategy.cancel("S")
if flatten and strategy.position_size != 0
    strategy.close_all(comment = "EOD flat")
if dailyHalt and strategy.position_size != 0
    strategy.close_all(comment = "Daily loss halt")

// ============================================================================
// Cost panel
//   Commission comes straight from the closed-trade log. Slippage is NOT
//   reported by Pine — it is baked into fill prices — so it is estimated as
//   contracts x ticks x tick value x 2 sides. Gross = net + both costs.
// ============================================================================
var table t = table.new(position.top_right, 2, 10, border_width = 1)

if showPanel and barstate.islast
    float commTot   = 0.0
    float contracts = 0.0
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            commTot   += strategy.closedtrades.commission(i)
            contracts += math.abs(strategy.closedtrades.size(i))
    float slipTot = contracts * slipMirror * syminfo.mintick * f_ptVal() * 2
    float net     = strategy.netprofit
    float gross   = net + commTot + slipTot
    int   n       = strategy.closedtrades
    float wr      = n > 0 ? strategy.wintrades / n * 100 : na
    float pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    float costPct = gross != 0 ? (commTot + slipTot) / math.abs(gross) * 100 : na

    table.cell(t, 0, 0, setupSel, text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 40))
    table.cell(t, 1, 0, str.tostring(n) + " trades", text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 40))
    f_row(t, 1, "Gross P&L",        "$"  + str.tostring(gross,   "#"), gross > 0 ? color.teal : color.red)
    f_row(t, 2, "  Commission",     "-$" + str.tostring(commTot, "#"), color.orange)
    f_row(t, 3, "  Slippage (est)", "-$" + str.tostring(slipTot, "#"), color.orange)
    f_row(t, 4, "NET P&L",          "$"  + str.tostring(net,     "#"), net > 0 ? color.teal : color.red)
    f_row(t, 5, "Costs / gross",    na(costPct) ? "-" : str.tostring(costPct, "#") + "%", costPct > 50 ? color.red : color.gray)
    f_row(t, 6, "Profit factor",    na(pf) ? "-" : str.tostring(pf, "#.##"), pf > 1 ? color.teal : color.red)
    f_row(t, 7, "Win rate",         na(wr) ? "-" : str.tostring(wr, "#") + "%", color.gray)
    f_row(t, 8, "Max drawdown",     "$"  + str.tostring(strategy.max_drawdown, "#"), color.red)
    f_row(t, 9, net > 0 ? "SURVIVES COSTS" : "FAILS AFTER COSTS", "", net > 0 ? color.teal : color.red)

// ============================================================================
// Chart levels
// ============================================================================
isOR   = setupSel == "OR15 Breakout"
isIB   = setupSel == "IB Breakout (bias)"
isPD   = setupSel == "PDH/PDL Breakout"
isVW   = setupSel == "VWAP Mean-Reversion"

plot(showLvls and isOR and not na(orH) ? orH : na, "OR High", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(showLvls and isOR and not na(orL) ? orL : na, "OR Low",  color = color.new(color.red,  0), style = plot.style_linebr)
plot(showLvls and isIB and not na(ibH) ? ibH : na, "IB High", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(showLvls and isIB and not na(ibL) ? ibL : na, "IB Low",  color = color.new(color.red,  0), style = plot.style_linebr)
plot(showLvls and isPD and inSess ? pdH : na, "PDH", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(showLvls and isPD and inSess ? pdL : na, "PDL", color = color.new(color.red,  0), style = plot.style_linebr)
plot(showLvls and isVW and inSess ? vwapV  : na, "VWAP",    color = color.new(color.blue, 0), style = plot.style_linebr)
plot(showLvls and isVW and inSess ? vwapUp : na, "Band up", color = color.new(color.gray, 40), style = plot.style_linebr)
plot(showLvls and isVW and inSess ? vwapDn : na, "Band dn", color = color.new(color.gray, 40), style = plot.style_linebr)
plot(showLvls and strategy.position_size != 0 and not na(tgtLvl)  ? tgtLvl  : na, "Target", color = color.new(color.green, 0), style = plot.style_linebr)
plot(showLvls and strategy.position_size != 0 and not na(curStop) ? curStop : na, "Stop",   color = color.new(color.red,   0), style = plot.style_linebr)
