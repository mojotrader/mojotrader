//@version=6
// MTF 10:00 Sweep — run on a 1-MINUTE chart. One shot per day, inside the 10:00-14:00 ET 4h candle.
//
//   1) BIAS — set by the 4h candle that CLOSES AT 10:00 ET, judged against the 4h candle before it:
//        close ABOVE the previous 4h HIGH                -> long   (breakout)
//        close BELOW the previous 4h LOW                 -> short  (breakout)
//        took the previous LOW but FAILED to close below -> long   (failed breakdown)
//        took the previous HIGH but FAILED to close above-> short  (failed breakout)
//        inside candle (took neither side) -> no trade. Took BOTH sides and closed inside -> tie-break input.
//   2) SWEEP — during 10:00-14:00, a 15m candle spikes through the previous 15m high (short) or low
//        (long) and trades back inside. The 15m candle is aggregated from the 1m bars, so the spike is
//        caught while it happens. Only the sweep matching the 10:00 bias arms.
//   3) CONFIRMATION — inside that spiking 15m candle, on the 1m: a Fair Value Gap in the trade
//        direction plus a Market Structure Shift (first 1m close through the last swing low/high).
//
//   ENTRY : market on the trigger bar (or a limit inside the 1m FVG).
//   TARGET: HOD for longs, LOD for shorts.
//   STOP  : the SAME distance on the other side of the entry — a forced 1:1. Risk is therefore set by
//           how far the day's extreme is, so the point stop can be large. Guard it with the min/max
//           stop inputs and size with % risk rather than fixed contracts.
//   Entries stop at 14:00 ET and everything is flattened at 14:00 ET — the end of that 4h candle.
//   Validate before trading; this is an idea to backtest.

strategy("MTF 10:00 Sweep — 4h bias + 15m sweep + 1m FVG/MSS", overlay = true,
     pyramiding = 1, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 200,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)

// ---------------------------------------------------------------- Inputs
gT    = "Session / timing"
tz    = input.string("America/New_York", "Timezone", group = gT)
anchH = input.int(10, "Bias 4h candle closes at - hour",   0, 23, group = gT,
     tooltip = "The 4h close that sets the bias and opens the trade window. 10:00 ET on CME futures, where 4h candles run 18:00 / 22:00 / 02:00 / 06:00 / 10:00 / 14:00.")
anchM = input.int(0,  "Bias 4h candle closes at - minute", 0, 59, group = gT)
cutH  = input.int(14, "Stop new entries at - hour",   0, 23, group = gT)
cutM  = input.int(0,  "Stop new entries at - minute", 0, 59, group = gT)
flatH = input.int(14, "Flatten everything at - hour",   0, 23, group = gT)
flatM = input.int(0,  "Flatten everything at - minute", 0, 59, group = gT)
strictAnchor = input.bool(true, "Only trade if the last closed 4h candle really closed at that time", group = gT,
     tooltip = "Protects against a chart whose 4h candles are not aligned to the futures session (extended hours off, or a non-futures symbol). Off = always use the last closed 4h candle.")

gB    = "1) 4h bias (10:00 close)"
allowLong  = input.bool(true, "Take longs",  group = gB)
allowShort = input.bool(true, "Take shorts", group = gB)
tieMode    = input.string("No trade", "If the 4h candle took BOTH sides and closed inside",
     options = ["No trade", "Close in top/bottom half decides", "Bigger sweep wins"], group = gB,
     tooltip = "Bigger sweep wins: the side that was rejected harder sets the bias (a deeper poke above the high -> short).")

gM        = "2) 15m sweep"
mtfTf     = input.timeframe("15", "Sweep timeframe", group = gM)
reqBack   = input.bool(true, "Price must be back inside the swept level at the trigger", group = gM)
graceBars = input.int(0, "Allow confirmation N bars after the sweep candle closes", 0, 60, group = gM,
     tooltip = "0 = the FVG and the MSS must both land inside the spiking 15m candle.")

gL      = "3) 1m confirmation"
swLeft  = input.int(1, "Swing pivot — left bars",  1, 10, group = gL)
swRight = input.int(1, "Swing pivot — right bars", 1, 10, group = gL)
mssLook = input.int(20, "Broken swing must be at most N bars old", 1, 200, group = gL)
swInWin = input.bool(false, "Broken swing must have formed inside the sweep candle", group = gL)
ordMode = input.string("Any order", "Required order", options = ["Any order", "FVG then MSS", "MSS then FVG"], group = gL)

gE       = "Entry / exit"
entMode  = input.string("Market at trigger", "Entry", options = ["Market at trigger", "Limit in the 1m FVG"], group = gE)
fvgAt    = input.string("50%", "  FVG limit level", options = ["Near edge", "50%", "Far edge"], group = gE,
     tooltip = "Only used by the limit entry. Near edge fills often; far edge is the full gap fill.")
hlMode   = input.string("Trading day (18:00 ET start)", "HOD / LOD measured from",
     options = ["Trading day (18:00 ET start)", "RTH (09:30 ET start)", "The 4h candle open (10:00)"], group = gE,
     tooltip = "Which high/low the target uses. The trading-day extreme is the literal HOD/LOD but can sit far away, which forces a large 1:1 stop; the tighter anchors keep risk smaller.")
trailTgt = input.bool(false, "Let the target follow a new HOD / LOD", group = gE,
     tooltip = "Off (default): the target is fixed at entry, so the trade is a clean 1:1. On: the target extends with the day but the stop stays put, so R:R drifts above 1:1.")
minStop  = input.float(5,  "Minimum stop distance (points)", 0, group = gE,
     tooltip = "Skips the trade when the day's extreme is already too close to bother.")
maxStop  = input.float(0,  "Maximum stop distance (points, 0 = no cap)", 0, group = gE)
maxTrades= input.int(1, "Max trades per day", 1, 5, group = gE)

gS          = "Position sizing"
useRiskSize = input.bool(false, "Size by % of account risked", group = gS)
acctSize    = input.float(100000, "Account size ($)", minval = 1, group = gS,
     tooltip = "Fixed — the sizer does not compound.")
riskPct     = input.float(0.5, "Risk per trade (%)", minval = 0.01, step = 0.05, group = gS)
qtyFixed    = input.float(1, "Contracts (fixed sizing)", minval = 1, group = gS)
ptVal       = input.float(2.0, "$ per point per contract", group = gS, tooltip = "MNQ=2, NQ=20, MES=5, ES=50.")

gV       = "Visuals"
showSet  = input.bool(true, "Draw the sweep / FVG / MSS", group = gV)
showRR   = input.bool(true, "Show the risk/reward box",   group = gV)
rrBars   = input.int(60, "R/R box width (bars)", 1, 600, group = gV)
extBars  = input.int(20, "Extend setup drawings right (bars)", 0, 200, group = gV)
longCol  = input.color(color.new(#26a69a, 0), "Long color",  group = gV)
shortCol = input.color(color.new(#ef5350, 0), "Short color", group = gV)

// ---------------------------------------------------------------- Clock / day
tod      = hour(time, tz) * 60 + minute(time, tz)
winStart = anchH * 60 + anchM
winEnd   = cutH  * 60 + cutM
inWindow = tod >= winStart and tod < winEnd     // assumes the window does not cross midnight
winOpen  = inWindow and not inWindow[1]
flatten  = tod >= flatH * 60 + flatM

// ================================================================ 1) 4h BIAS AT THE 10:00 CLOSE
// Non-repaint idiom: read the HTF offset by one bar with lookahead_on, so history and realtime both
// return the last FULLY CLOSED 4h candle. Suffix 1 = that candle (the 10:00 close), 2 = the one before.
[c1, h1, l1, h2, l2, tc1] = request.security(syminfo.tickerid, "240",
     [close[1], high[1], low[1], high[2], low[2], time_close[1]], lookahead = barmerge.lookahead_on)

// +1s so a feed that stamps the close one tick early (09:59:59.999) still reads as the 10:00 close
tcAdj    = tc1 + 1000
anchorOK = not na(tc1) and hour(tcAdj, tz) * 60 + minute(tcAdj, tz) == anchH * 60 + anchM

f_bias4h(float cc1, float hh1, float ll1, float hh2, float ll2) =>
    int b = 0
    if not na(cc1) and not na(hh2) and not na(ll2)
        brkUp   = cc1 > hh2                     // closed above the previous 4h high
        brkDn   = cc1 < ll2                     // closed below the previous 4h low
        failLow = ll1 < ll2 and cc1 >= ll2      // took the previous low, failed to close below -> long
        failHi  = hh1 > hh2 and cc1 <= hh2      // took the previous high, failed to close above -> short
        if brkUp
            b := 1
        else if brkDn
            b := -1
        else if failLow and failHi
            if tieMode == "Close in top/bottom half decides"
                b := cc1 > (hh2 + ll2) / 2 ? 1 : -1
            else if tieMode == "Bigger sweep wins"
                b := (hh1 - hh2) > (ll2 - ll1) ? -1 : 1
        else if failLow
            b := 1
        else if failHi
            b := -1
    b

var int   dayBias   = 0
var int   nTrades   = 0
if winOpen
    dayBias := (anchorOK or not strictAnchor) ? f_bias4h(c1, h1, l1, h2, l2) : 0
    if dayBias == 1 and not allowLong
        dayBias := 0
    if dayBias == -1 and not allowShort
        dayBias := 0
    nTrades := 0

// ---------------------------------------------------------------- HOD / LOD
f_sessStart(string s) =>
    inS = not na(time(timeframe.period, s, tz))
    inS and not inS[1]

dayStart = f_sessStart("1800-1700")
rthStart = f_sessStart("0930-1600")
resetHL  = hlMode == "RTH (09:30 ET start)" ? rthStart : hlMode == "The 4h candle open (10:00)" ? winOpen : dayStart

var float dHigh = na
var float dLow  = na
if resetHL
    dHigh := high
    dLow  := low
else
    dHigh := na(dHigh) ? high : math.max(dHigh, high)
    dLow  := na(dLow)  ? low  : math.min(dLow, low)

// ================================================================ 2) 15m SWEEP
// The 15m candle is aggregated from the 1m bars so the DEVELOPING candle is readable and the spike is
// detected on the 1m bar that makes it. Aggregation runs all session; only ARMING is gated to the window.
mtfT   = time(mtfTf)
newMtf = not na(mtfT) and (na(mtfT[1]) or mtfT != mtfT[1])

var float curH     = na
var float curL     = na
var bool  curValid = false
var float prevH    = na
var float prevL    = na
var bool  havePrev = false

var int   swpDir  = 0        // -1 = took the previous 15m high (short), 1 = took the previous low (long)
var float swpLvl  = na
var int   swpBar  = na
var int   swpEnd  = na       // last bar_index the window stays open (na while the 15m candle is still open)
var bool  fvgOk   = false
var int   fvgBar  = na
var float fvgTop  = na
var float fvgBot  = na
var bool  mssOk   = false
var int   mssBar  = na
var float mssLvl  = na
var bool  fired   = false

if newMtf
    if curValid
        prevH    := curH
        prevL    := curL
        havePrev := true
    if swpDir != 0 and na(swpEnd)
        swpEnd := bar_index - 1 + graceBars
    curH     := high
    curL     := low
    curValid := not barstate.isfirst
else
    curH := na(curH) ? high : math.max(curH, high)
    curL := na(curL) ? low  : math.min(curL, low)

sweepLive = swpDir != 0 and (na(swpEnd) or bar_index <= swpEnd)

// ---- arm a sweep in the bias direction, only inside the trade window
bool armedNow = false
if not sweepLive and havePrev and inWindow and not flatten and dayBias != 0 and nTrades < maxTrades
    canShort = dayBias == -1 and not na(prevH) and curH > prevH
    canLong  = dayBias ==  1 and not na(prevL) and curL < prevL
    if canShort or canLong
        swpDir   := canShort ? -1 : 1
        swpLvl   := canShort ? prevH : prevL
        swpBar   := bar_index
        swpEnd   := na
        fvgOk    := false
        fvgBar   := na
        mssOk    := false
        mssBar   := na
        fired    := false
        armedNow := true
    sweepLive := swpDir != 0 and (na(swpEnd) or bar_index <= swpEnd)

// ================================================================ 3) 1m CONFIRMATION
bearFVG = low[2]  > high
bullFVG = high[2] < low

bool fvgNow = false
if sweepLive and not fvgOk and bar_index >= swpBar
    if swpDir == -1 and bearFVG
        fvgOk  := true
        fvgBar := bar_index
        fvgTop := low[2]
        fvgBot := high
        fvgNow := true
    else if swpDir == 1 and bullFVG
        fvgOk  := true
        fvgBar := bar_index
        fvgTop := low
        fvgBot := high[2]
        fvgNow := true

ph = ta.pivothigh(swLeft, swRight)
pl = ta.pivotlow(swLeft, swRight)

var float swH       = na
var int   swHBar    = na
var bool  swHBroken = false
var float swL       = na
var int   swLBar    = na
var bool  swLBroken = false

if not na(ph)
    swH       := ph
    swHBar    := bar_index - swRight
    swHBroken := false
if not na(pl)
    swL       := pl
    swLBar    := bar_index - swRight
    swLBroken := false

bool  mssNow   = false
float mssPrice = na
if swpDir == -1 and not na(swL) and not swLBroken and close < swL
    mssNow   := bar_index - swLBar <= mssLook and (not swInWin or swLBar >= swpBar)
    mssPrice := swL
else if swpDir == 1 and not na(swH) and not swHBroken and close > swH
    mssNow   := bar_index - swHBar <= mssLook and (not swInWin or swHBar >= swpBar)
    mssPrice := swH

if not na(swL) and close < swL
    swLBroken := true
if not na(swH) and close > swH
    swHBroken := true

bool mssDrawn = false
if sweepLive and not mssOk and mssNow and bar_index >= swpBar
    mssOk    := true
    mssBar   := bar_index
    mssLvl   := mssPrice
    mssDrawn := true

// ================================================================ ORDERS
// contracts for a $ budget and a stop distance in points. Fractional <= .5 rounds down, > .5 rounds up.
f_size(float budget, float ptDist) =>
    perC = ptDist * ptVal
    raw  = perC > 0 ? budget / perC : 0.0
    fr   = raw - math.floor(raw)
    n = fr > 0.5 ? math.ceil(raw) : math.floor(raw)
    n := riskPct >= 0.5 and n < 1 ? 1 : n
    n

f_fvgLvl(int d) =>
    d == -1 ? (fvgAt == "Near edge" ? fvgBot : fvgAt == "Far edge" ? fvgTop : (fvgTop + fvgBot) / 2) : (fvgAt == "Near edge" ? fvgTop : fvgAt == "Far edge" ? fvgBot : (fvgTop + fvgBot) / 2)

var int   tDir     = 0        // direction of the live/pending trade
var float tpLvl    = na       // target latched at the trigger
var float slLvl    = na       // stop, set from the real fill
var float refEnt   = na       // reference entry used for the R/R box
var float refRisk  = na
var bool  exitsSet = false
var bool  pending  = false    // a limit order is resting

bool trigNow = false
if sweepLive and not fired and fvgOk and mssOk and inWindow and not flatten and nTrades < maxTrades and strategy.position_size == 0 and not pending
    orderOk = ordMode == "Any order" ? true : ordMode == "FVG then MSS" ? fvgBar <= mssBar : mssBar <= fvgBar
    backOk  = not reqBack or (swpDir == -1 ? close < swpLvl : close > swpLvl)
    if orderOk and backOk
        // target first — the stop is a mirror of it, so the target decides whether the trade is viable
        float tgt = swpDir == 1 ? dHigh : dLow
        float ent = entMode == "Limit in the 1m FVG" ? f_fvgLvl(swpDir) : close
        float rsk = swpDir == 1 ? tgt - ent : ent - tgt
        okDist  = rsk >= minStop and (maxStop <= 0 or rsk <= maxStop)
        // size before committing: a stop too far to afford even one contract is a skip, not a trade
        float q = useRiskSize ? f_size(acctSize * riskPct / 100.0, rsk) : qtyFixed
        if okDist and q >= 1
            fired    := true
            trigNow  := true
            tDir     := swpDir
            tpLvl    := tgt
            refEnt   := ent
            refRisk  := rsk
            exitsSet := false
            nTrades  := nTrades + 1
            if entMode == "Limit in the 1m FVG"
                strategy.entry(tDir == 1 ? "MTFL" : "MTFS", tDir == 1 ? strategy.long : strategy.short, qty = q, limit = ent)
                pending := true
            else
                strategy.entry(tDir == 1 ? "MTFL" : "MTFS", tDir == 1 ? strategy.long : strategy.short, qty = q)

// ---- exits: stop is the mirror of the target around the ACTUAL fill, so the trade is a true 1:1
inPos = strategy.position_size != 0
if inPos and not exitsSet
    ent = strategy.position_avg_price
    // the fill can gap past the target that was latched at the trigger, which would leave no trade
    // to make — bail rather than hold a position whose target sits on the wrong side of the entry
    if tDir == 1 ? tpLvl <= ent : tpLvl >= ent
        strategy.close_all(comment = "target gapped through")
        pending := false
    else
        risk = math.abs(tpLvl - ent)
        slLvl    := tDir == 1 ? ent - risk : ent + risk
        refEnt   := ent
        refRisk  := risk
        exitsSet := true
        pending  := false
if inPos and exitsSet
    tgt = trailTgt ? (tDir == 1 ? math.max(tpLvl, dHigh) : math.min(tpLvl, dLow)) : tpLvl
    strategy.exit("MTFLx", from_entry = "MTFL", stop = slLvl, limit = tgt)
    strategy.exit("MTFSx", from_entry = "MTFS", stop = slLvl, limit = tgt)
if not inPos and inPos[1]
    exitsSet := false
    tDir     := 0

// ---- cancel an unfilled limit once the window closes, and flatten at 14:00
if pending and (not inWindow or flatten)
    strategy.cancel("MTFL")
    strategy.cancel("MTFS")
    pending := false
if flatten
    strategy.close_all(comment = "14:00 flat")

// ================================================================ VISUALS
sigCol = (tDir != 0 ? tDir : swpDir) == 1 ? longCol : shortCol

if showSet and armedNow
    line.new(bar_index, swpLvl, bar_index + extBars, swpLvl, xloc = xloc.bar_index,
         color = sigCol, width = 2, style = line.style_dotted)
    label.new(bar_index, swpLvl, swpDir == -1 ? "sweep ▲ prev " + mtfTf + " H" : "sweep ▼ prev " + mtfTf + " L",
         xloc = xloc.bar_index, style = swpDir == -1 ? label.style_label_down : label.style_label_up,
         color = color.new(sigCol, 85), textcolor = sigCol, size = size.tiny)

if showSet and fvgNow
    box.new(fvgBar - 2, fvgTop, fvgBar + extBars, fvgBot, xloc = xloc.bar_index,
         border_color = color.new(sigCol, 40), border_width = 1, bgcolor = color.new(sigCol, 82))

if showSet and mssDrawn
    int mssFrom = swpDir == -1 ? swLBar : swHBar
    line.new(mssFrom, mssLvl, mssBar + math.min(extBars, 5), mssLvl, xloc = xloc.bar_index,
         color = sigCol, width = 1, style = line.style_dashed)
    label.new(mssBar, mssLvl, "MSS", xloc = xloc.bar_index,
         style = swpDir == -1 ? label.style_label_up : label.style_label_down,
         color = color.new(sigCol, 85), textcolor = sigCol, size = size.tiny)

if showRR and trigNow
    float sl = tDir == 1 ? refEnt - refRisk : refEnt + refRisk
    x2 = bar_index + rrBars
    box.new(bar_index, tDir == 1 ? tpLvl : refEnt, x2, tDir == 1 ? refEnt : tpLvl, xloc = xloc.bar_index,
         border_color = color.new(sigCol, 60), border_width = 1, bgcolor = color.new(color.green, 85))
    box.new(bar_index, tDir == 1 ? refEnt : sl, x2, tDir == 1 ? sl : refEnt, xloc = xloc.bar_index,
         border_color = color.new(sigCol, 60), border_width = 1, bgcolor = color.new(color.red, 85))
    label.new(x2, refEnt, (tDir == 1 ? "LONG  " : "SHORT  ") + str.tostring(refRisk, "#.##") + " pts risk @ 1:1",
         xloc = xloc.bar_index, style = label.style_label_left,
         color = color.new(color.gray, 15), textcolor = color.white, size = size.small)

plot(inWindow and dayBias != 0 ? dHigh : na, "HOD", color = color.new(color.gray, 20), style = plot.style_linebr)
plot(inWindow and dayBias != 0 ? dLow  : na, "LOD", color = color.new(color.gray, 20), style = plot.style_linebr)
bgcolor(inWindow and dayBias != 0 ? color.new(dayBias == 1 ? longCol : shortCol, 95) : na, title = "Trade window")
