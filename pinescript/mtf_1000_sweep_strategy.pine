//@version=6
// MTF 10:00 Sweep — run on a 1-MINUTE chart. One shot per day, inside the 10:00-14:00 ET 4h candle.
//
//   1) BIAS — set by the 4h candle that CLOSES AT 10:00 ET (06:00-10:00), judged against the 4h
//      candle before it (02:00-06:00):
//        close ABOVE the previous 4h HIGH                 -> long   (breakout)
//        close BELOW the previous 4h LOW                  -> short  (breakout)
//        took the previous LOW but FAILED to close below  -> long   (failed breakdown)
//        took the previous HIGH but FAILED to close above -> short  (failed breakout)
//        inside candle -> no trade. Took BOTH sides and closed inside -> tie-break input.
//      Both candles are AGGREGATED FROM THE CHART BARS around the anchor time, not requested from
//      the 4h series, so this does not care whether the chart's own 4h grid lands on 10:00.
//   2) SWEEP — during 10:00-14:00, in the 10:00 bias direction. A sweep is TWO things, and the
//      second is what makes it a sweep rather than just a poke:
//        short: the 15m candle trades ABOVE the previous 15m HIGH *and CLOSES BACK UNDER IT*
//        long : the 15m candle trades BELOW the previous 15m LOW  *and CLOSES BACK OVER IT*
//      The candle is aggregated from the 1m bars, so the poke is seen as it happens, but nothing
//      counts as a sweep until the close confirms it. A candle that pokes and closes BEYOND the
//      level is a break, not a sweep, and is discarded.
//   3) CONFIRMATION — once that candle has closed, drop to the 1m: a Fair Value Gap in the trade
//      direction is enough to trigger. The trade therefore fires on the first 1m bar after the 15m
//      close, the FVG having formed inside the candle. A Market Structure Shift is tracked and
//      drawn as well, but only gates the entry if "Also require a market structure shift" is on.
//
//   ENTRY : market on the trigger bar (or a limit inside the 1m FVG).
//   TARGET: the FAR side of the swept 15m candle — its HIGH for a long, its LOW for a short.
//           (HOD / LOD is selectable instead, but sits far away and forces a much bigger stop.)
//   STOP  : the SAME distance on the other side of the fill — a forced 1:1.
//   Entries stop at 14:00 ET and everything is flattened at 14:00 ET — the end of that 4h candle.
//
//   The DRAWINGS follow whatever chart you open: a 4h chart gets the bias shading only (green long
//   / red short), a 15m chart adds the sweep, a 1m chart adds the FVG, MSS and R/R box. Trading
//   still requires the 1m chart — the layering only affects what is drawn.
//
//   THIS SETUP IS RARE. The bottom-right panel shows a day-by-day funnel (days -> bias -> sweep ->
//   FVG -> MSS -> trigger -> trade) plus today's live state, so when nothing fires you can see the
//   exact step it stops at instead of staring at an empty chart. NEEDS EXTENDED-HOURS (ETH) DATA:
//   the bias candles are built from 02:00-10:00 ET bars, which an RTH-only chart does not have.
//   Validate before trading; this is an idea to backtest.

strategy("MTF 10:00 Sweep — 4h bias + 15m sweep + 1m FVG/MSS", overlay = true,
     pyramiding = 1, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 200,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)

// ---------------------------------------------------------------- Inputs
gT    = "Session / timing"
tz    = input.string("America/New_York", "Timezone", group = gT)
anchH = input.int(10, "Bias 4h candle closes at - hour",   0, 23, group = gT,
     tooltip = "The 4h close that sets the bias and opens the trade window. 10:00 ET on CME futures.")
anchM = input.int(0,  "Bias 4h candle closes at - minute", 0, 59, group = gT)
htfMin= input.int(240, "Bias candle length (minutes)", 5, 1440, group = gT,
     tooltip = "240 = 4h. The bias candle spans the 240 minutes before the anchor; the candle it is compared against spans the 240 before that.")
cutH  = input.int(14, "Stop new entries at - hour",   0, 23, group = gT)
cutM  = input.int(0,  "Stop new entries at - minute", 0, 59, group = gT)
flatH = input.int(14, "Flatten everything at - hour",   0, 23, group = gT)
flatM = input.int(0,  "Flatten everything at - minute", 0, 59, group = gT)

gB    = "1) 4h bias"
allowLong  = input.bool(true, "Take longs",  group = gB)
allowShort = input.bool(true, "Take shorts", group = gB)
tieMode    = input.string("No trade", "If the bias candle took BOTH sides and closed inside",
     options = ["No trade", "Close in top/bottom half decides", "Bigger sweep wins"], group = gB,
     tooltip = "Bigger sweep wins: the side rejected harder sets the bias (a deeper poke above the high -> short).")

gM        = "2) 15m sweep"
mtfTf     = input.timeframe("15", "Sweep timeframe", group = gM)
sweepConf = input.string("15m candle must close back inside", "Sweep confirmed by",
     options = ["15m candle must close back inside", "Any 1m close back inside (live)"], group = gM,
     tooltip = "Default: the spiking candle has to CLOSE back inside the level before it counts as a sweep, so the setup triggers just after that candle closes. A candle that pokes and closes beyond the level is a break, not a sweep, and is discarded. Live: the first 1m close back inside confirms it, which triggers earlier but can still be undone by the 15m close.")
reqBack   = input.bool(true, "Price must still be inside the swept level at the trigger", group = gM)
graceBars = input.int(0, "Allow confirmation N bars after the sweep candle closes", 0, 60, group = gM,
     tooltip = "0 = the FVG and the MSS must both land inside the spiking 15m candle. Raising this is the single biggest loosener if the setup never completes.")

gL      = "3) 1m confirmation"
entryTrig= input.string("1m gap after the sweep", "Take the trade on",
     options = ["1m gap after the sweep", "The 15m sweep close alone"], group = gL,
     tooltip = "1m gap after the sweep (default): once the sweep is confirmed, wait for a 1m FVG (and the MSS if required). The 15m sweep close alone: enter as soon as the sweeping 15m candle closes back inside, without looking at the 1m chart at all — step 3 is skipped and the FVG/MSS are drawn but gate nothing. Entry is market in that mode, since there is no gap to rest a limit in.")
reqMss  = input.bool(false, "Also require a market structure shift", group = gL,
     tooltip = "Off (default): once the sweep is confirmed, a 1m FVG in the trade direction is enough to trigger. On: the FVG must be joined by a 1m close through the last swing low/high. The MSS is tracked and drawn either way — this only decides whether it gates the entry.")
fvgPick = input.string("Most recent before the trigger", "Which FVG to trade",
     options = ["Most recent before the trigger", "First one after the sweep"], group = gL,
     tooltip = "Several FVGs can form inside one sweep candle. Most recent (default): keep updating to the latest, so when a market structure shift gates the entry you get the gap in the displacement leg that broke structure rather than an older one further back. First one: lock onto the earliest and ignore the rest.")
swLeft  = input.int(1, "Swing pivot — left bars",  1, 10, group = gL)
swRight = input.int(1, "Swing pivot — right bars", 1, 10, group = gL)
mssLook = input.int(20, "Broken swing must be at most N bars old", 1, 200, group = gL)
swInWin = input.bool(false, "Broken swing must have formed inside the sweep candle", group = gL)
ordMode = input.string("Any order", "Required order", options = ["Any order", "FVG then MSS", "MSS then FVG"], group = gL,
     tooltip = "Only applies when the market structure shift is required.")

gE       = "Entry / exit"
entMode  = input.string("Market at trigger", "Entry", options = ["Market at trigger", "Limit in the 1m FVG"], group = gE)
fvgAt    = input.string("50%", "  FVG limit level", options = ["Near edge", "50%", "Far edge"], group = gE)
tpMode   = input.string("Swept 15m candle extreme", "Target",
     options = ["Swept 15m candle extreme", "HOD / LOD"], group = gE,
     tooltip = "Swept 15m candle extreme (default): the far side of the candle whose level was swept — its HIGH for a long, its LOW for a short. HOD / LOD: the day's extreme, which sits much further away and so forces a much larger 1:1 stop.")
hlMode   = input.string("Trading day (18:00 ET start)", "  HOD / LOD measured from",
     options = ["Trading day (18:00 ET start)", "RTH (09:30 ET start)", "The 4h candle open"], group = gE,
     tooltip = "Which high/low the target uses. The trading-day extreme is the literal HOD/LOD but can sit far away, which forces a large 1:1 stop; the tighter anchors keep risk smaller.")
trailTgt = input.bool(false, "Let the target follow a new HOD / LOD", group = gE,
     tooltip = "Off: the target is fixed at entry, so the trade is a clean 1:1. On: the target extends with the day but the stop stays put, so R:R drifts above 1:1.")
minStop  = input.float(5,  "Minimum stop distance (points)", 0, group = gE)
maxStop  = input.float(0,  "Maximum stop distance (points, 0 = no cap)", 0, group = gE)
maxTrades= input.int(1, "Max trades per day", 1, 5, group = gE)

gS          = "Position sizing"
useRiskSize = input.bool(false, "Size by % of account risked", group = gS)
acctSize    = input.float(100000, "Account size ($)", minval = 1, group = gS, tooltip = "Fixed — the sizer does not compound.")
riskPct     = input.float(0.5, "Risk per trade (%)", minval = 0.01, step = 0.05, group = gS)
qtyFixed    = input.float(1, "Contracts (fixed sizing)", minval = 1, group = gS)
ptVal       = input.float(2.0, "$ per point per contract", group = gS, tooltip = "MNQ=2, NQ=20, MES=5, ES=50.")

gV       = "Visuals"
detail   = input.string("Auto (match the chart timeframe)", "Drawing detail",
     options = ["Auto (match the chart timeframe)", "Everything"], group = gV,
     tooltip = "Auto: each chart shows only the layer that belongs to it. On the 4h chart just the bias shading; on the 15m chart the bias shading plus the sweep; on the 1m chart all of that plus the FVG, MSS and the R/R box. Everything: draw every layer regardless of chart. NOTE this only affects DRAWINGS — the strategy still has to run on a 1m chart to trade correctly.")
showDiag = input.bool(true, "Show the diagnostics panel", group = gV,
     tooltip = "Day-by-day funnel plus today's live state. Turn this off only once the strategy is behaving.")
showBias = input.bool(true, "Draw the bias candle levels", group = gV)
showSet  = input.bool(true, "Draw the sweep / FVG / MSS",  group = gV)
showRR   = input.bool(true, "Show the risk/reward box",    group = gV)
rrBars   = input.int(60, "R/R box width (bars)", 1, 600, group = gV)
extBars  = input.int(20, "Extend setup drawings right (bars)", 0, 200, group = gV)
longCol  = input.color(color.new(#26a69a, 0), "Long color",  group = gV)
shortCol = input.color(color.new(#ef5350, 0), "Short color", group = gV)

// ---------------------------------------------------------------- Clock
tod      = hour(time, tz) * 60 + minute(time, tz)
winStart = anchH * 60 + anchM
winEnd   = cutH  * 60 + cutM
inWindow = winStart <= winEnd ? (tod >= winStart and tod < winEnd) : (tod >= winStart or tod < winEnd)
winOpen  = inWindow and not inWindow[1]
flatten  = tod >= flatH * 60 + flatM

// true while the clock sits in [fromMin, toMin), wrapping over midnight if needed
f_inSpan(int fromMin, int toMin) =>
    f = (fromMin % 1440 + 1440) % 1440
    t = (toMin   % 1440 + 1440) % 1440
    f <= t ? (tod >= f and tod < t) : (tod >= f or tod < t)

// ================================================================ 1) 4h BIAS AT THE ANCHOR CLOSE
// Both bias candles are built from the CHART's own bars over a fixed clock span. This is immune to
// how TradingView happens to align its 4h grid (session start, RTH vs ETH, non-futures symbols) —
// the earlier request.security version silently produced no bias whenever that grid missed 10:00.
spanCur = f_inSpan(winStart - htfMin,     winStart)              // the candle that closes at the anchor
spanPrv = f_inSpan(winStart - 2 * htfMin, winStart - htfMin)     // the one before it

var float curBH = na
var float curBL = na
var float curBC = na
var float prvBH = na
var float prvBL = na
var bool  curSeen = false
var bool  prvSeen = false

if spanPrv
    if not spanPrv[1]
        prvBH := high
        prvBL := low
        prvSeen := true
        curSeen := false        // a fresh cycle: the anchor candle has not started yet
    else
        prvBH := math.max(prvBH, high)
        prvBL := math.min(prvBL, low)
if spanCur
    if not spanCur[1]
        curBH := high
        curBL := low
        curSeen := true
    else
        curBH := math.max(curBH, high)
        curBL := math.min(curBL, low)
    curBC := close              // last close inside the span = that candle's close

f_bias4h(float cc, float ch, float cl, float ph, float pl) =>
    int b = 0
    failLow = cl < pl and cc >= pl      // took the previous low, failed to close below  -> long
    failHi  = ch > ph and cc <= ph      // took the previous high, failed to close above -> short
    if cc > ph
        b := 1
    else if cc < pl
        b := -1
    else if failLow and failHi
        if tieMode == "Close in top/bottom half decides"
            b := cc > (ph + pl) / 2 ? 1 : -1
        else if tieMode == "Bigger sweep wins"
            b := (ch - ph) > (pl - cl) ? -1 : 1
    else if failLow
        b := 1
    else if failHi
        b := -1
    b

f_biasWhy(float cc, float ch, float cl, float ph, float pl) =>
    failLow = cl < pl and cc >= pl
    failHi  = ch > ph and cc <= ph
    cc > ph ? "closed above prev high" : cc < pl ? "closed below prev low" : failLow and failHi ? "took both sides" : failLow ? "failed breakdown" : failHi ? "failed breakout" : "inside candle"

var int    dayBias = 0
var int    nTrades = 0
var string biasWhy = "—"
var bool   haveData = false

if winOpen
    haveData := curSeen and prvSeen and not na(curBC) and not na(prvBH) and not na(prvBL)
    if haveData
        dayBias := f_bias4h(curBC, curBH, curBL, prvBH, prvBL)
        biasWhy := f_biasWhy(curBC, curBH, curBL, prvBH, prvBL)
        if dayBias == 1 and not allowLong
            dayBias := 0
            biasWhy := "long blocked"
        if dayBias == -1 and not allowShort
            dayBias := 0
            biasWhy := "short blocked"
    else
        dayBias := 0
        biasWhy := "no bias-candle data (needs ETH)"
    nTrades := 0
    curSeen := false
    prvSeen := false

// ---------------------------------------------------------------- HOD / LOD
// Reset on a day boundary anchored to the chosen hour: shift the clock so that hour becomes midnight,
// then a change of calendar date is the reset. Works even when the chart has no bar at that exact
// time (RTH-only data, holidays, gaps) — unlike a session-string start, which simply never fires.
hlAnchorMin = hlMode == "RTH (09:30 ET start)" ? 570 : hlMode == "The 4h candle open" ? winStart - htfMin : 1080
shifted     = time - hlAnchorMin * 60000
dayKey      = year(shifted, tz) * 10000 + month(shifted, tz) * 100 + dayofmonth(shifted, tz)
resetHL     = na(dayKey[1]) or dayKey != dayKey[1]

var float dHigh = na
var float dLow  = na
if resetHL
    dHigh := high
    dLow  := low
else
    dHigh := na(dHigh) ? high : math.max(dHigh, high)
    dLow  := na(dLow)  ? low  : math.min(dLow, low)

// ================================================================ 2) 15m SWEEP
mtfT   = time(mtfTf)
newMtf = not na(mtfT) and (na(mtfT[1]) or mtfT != mtfT[1])

var float curH     = na
var float curL     = na
var bool  curValid = false
var float prevH    = na
var float prevL    = na
var float prevC    = na
var bool  havePrev = false
var int   mtfCurStart = na   // first bar_index of the developing MTF candle
var int   mtfPrvStart = na   // first bar_index of the candle that produced prevH / prevL

// Sweep lifecycle: a POKE through the previous extreme starts a watch; only a CLOSE back inside
// promotes it to a SWEEP. A candle that pokes and closes beyond the level is a break, not a sweep.
var int   swpDir     = 0     // -1 = poked the previous 15m high (short), 1 = poked the previous low (long)
var float swpLvl     = na    // the level that was swept
var float swpOpp     = na    // the FAR side of that same candle — the target
var int   swpBar     = na
var int   swpFrom    = na    // first bar of the candle that made the level
var int   swpState   = 0     // 0 = poked, awaiting the close | 1 = confirmed sweep | -1 = failed
var int   collectEnd = na    // last bar_index that may add an FVG / MSS
var int   triggerEnd = na    // last bar_index the setup may trigger on
var bool  fvgOk      = false
var int   fvgBar     = na
var float fvgTop     = na
var float fvgBot     = na
var bool  mssOk      = false
var int   mssBar     = na
var float mssLvl     = na
var bool  fired      = false

bool confirmedNow = false
bool failedNow    = false

if newMtf
    if curValid
        prevH    := curH
        prevL    := curL
        prevC    := close[1]
        mtfPrvStart := mtfCurStart     // first bar of a new candle -> close[1] is the old candle's close
        havePrev := true
    // the spiking candle has closed: did it close back inside the level it poked?
    if swpDir != 0 and na(collectEnd) and havePrev
        if swpState == 0
            back = swpDir == -1 ? prevC < swpLvl : prevC > swpLvl
            swpState := back ? 1 : -1
            confirmedNow := back
            failedNow    := not back
        collectEnd := bar_index - 1 + graceBars
        triggerEnd := math.max(bar_index, collectEnd)
    curH     := high
    curL     := low
    mtfCurStart := bar_index
    curValid := not barstate.isfirst
else
    curH := na(curH) ? high : math.max(curH, high)
    curL := na(curL) ? low  : math.min(curL, low)

busy = swpDir != 0 and swpState != -1 and not fired and (na(triggerEnd) or bar_index <= triggerEnd)

bool pokedNow = false
if not busy and havePrev and inWindow and not flatten and dayBias != 0 and nTrades < maxTrades
    canShort = dayBias == -1 and not na(prevH) and curH > prevH
    canLong  = dayBias ==  1 and not na(prevL) and curL < prevL
    if canShort or canLong
        swpDir     := canShort ? -1 : 1
        swpLvl     := canShort ? prevH : prevL
        swpOpp     := canShort ? prevL : prevH   // long sweeps the low -> target that candle's high
        swpBar     := bar_index
        swpFrom    := na(mtfPrvStart) ? bar_index - 1 : mtfPrvStart
        swpState   := 0
        collectEnd := na
        triggerEnd := na
        fvgOk      := false
        fvgBar     := na
        mssOk      := false
        mssBar     := na
        fired      := false
        pokedNow   := true
        busy       := true

// live mode: the first 1m close back inside confirms without waiting for the 15m close
if busy and swpState == 0 and sweepConf == "Any 1m close back inside (live)" and (swpDir == -1 ? close < swpLvl : close > swpLvl)
    swpState     := 1
    confirmedNow := true

collecting = busy and (swpState == 0 or na(collectEnd) or bar_index <= collectEnd)
triggerOk  = busy and swpState == 1 and (na(triggerEnd) or bar_index <= triggerEnd)

// ================================================================ 3) 1m CONFIRMATION
bearFVG = low[2]  > high
bullFVG = high[2] < low

bool fvgNow = false
if collecting and bar_index >= swpBar and (not fvgOk or fvgPick == "Most recent before the trigger")
    if swpDir == -1 and bearFVG
        fvgOk  := true
        fvgBar := bar_index
        fvgTop := low[2]
        fvgBot := high
        fvgNow := true
    else if swpDir == 1 and bullFVG
        fvgOk  := true
        fvgBar := bar_index
        fvgTop := low
        fvgBot := high[2]
        fvgNow := true

ph = ta.pivothigh(swLeft, swRight)
pl = ta.pivotlow(swLeft, swRight)

var float swH       = na
var int   swHBar    = na
var bool  swHBroken = false
var float swL       = na
var int   swLBar    = na
var bool  swLBroken = false

if not na(ph)
    swH       := ph
    swHBar    := bar_index - swRight
    swHBroken := false
if not na(pl)
    swL       := pl
    swLBar    := bar_index - swRight
    swLBroken := false

bool  mssNow   = false
float mssPrice = na
if swpDir == -1 and not na(swL) and not swLBroken and close < swL
    mssNow   := bar_index - swLBar <= mssLook and (not swInWin or swLBar >= swpBar)
    mssPrice := swL
else if swpDir == 1 and not na(swH) and not swHBroken and close > swH
    mssNow   := bar_index - swHBar <= mssLook and (not swInWin or swHBar >= swpBar)
    mssPrice := swH

if not na(swL) and close < swL
    swLBroken := true
if not na(swH) and close > swH
    swHBroken := true

bool mssDrawn = false
if collecting and not mssOk and mssNow and bar_index >= swpBar
    mssOk    := true
    mssBar   := bar_index
    mssLvl   := mssPrice
    mssDrawn := true

// ================================================================ ORDERS
// contracts for a $ budget and a stop distance in points. Fractional <= .5 rounds down, > .5 rounds up.
f_size(float budget, float ptDist) =>
    perC = ptDist * ptVal
    raw  = perC > 0 ? budget / perC : 0.0
    fr   = raw - math.floor(raw)
    n = fr > 0.5 ? math.ceil(raw) : math.floor(raw)
    n := riskPct >= 0.5 and n < 1 ? 1 : n
    n

f_fvgLvl(int d) =>
    d == -1 ? (fvgAt == "Near edge" ? fvgBot : fvgAt == "Far edge" ? fvgTop : (fvgTop + fvgBot) / 2) : (fvgAt == "Near edge" ? fvgTop : fvgAt == "Far edge" ? fvgBot : (fvgTop + fvgBot) / 2)

var int    tDir     = 0
var float  tpLvl    = na
var float  slLvl    = na
var float  refEnt   = na
var float  refRisk  = na
var bool   exitsSet = false
var bool   pending  = false
var string lastSkip = "—"

sweepOnly = entryTrig == "The 15m sweep close alone"

bool trigNow = false
confOk = sweepOnly or (fvgOk and (not reqMss or mssOk))
if triggerOk and not fired and confOk and inWindow and not flatten and nTrades < maxTrades and strategy.position_size == 0 and not pending
    orderOk = sweepOnly or not reqMss or (ordMode == "Any order" ? true : ordMode == "FVG then MSS" ? fvgBar <= mssBar : mssBar <= fvgBar)
    backOk  = not reqBack or (swpDir == -1 ? close < swpLvl : close > swpLvl)
    if orderOk and backOk
        // target first — the stop mirrors it, so the target decides whether the trade is viable
        float tgt = tpMode == "HOD / LOD" ? (swpDir == 1 ? dHigh : dLow) : swpOpp
        useLimit  = entMode == "Limit in the 1m FVG" and fvgOk and not sweepOnly
        float ent = useLimit ? f_fvgLvl(swpDir) : close
        float rsk = swpDir == 1 ? tgt - ent : ent - tgt
        float q   = useRiskSize ? f_size(acctSize * riskPct / 100.0, rsk) : qtyFixed
        if na(rsk) or rsk < minStop
            lastSkip := "stop " + str.tostring(rsk, "#.#") + " < min " + str.tostring(minStop, "#.#")
        else if maxStop > 0 and rsk > maxStop
            lastSkip := "stop " + str.tostring(rsk, "#.#") + " > max " + str.tostring(maxStop, "#.#")
        else if q < 1
            lastSkip := "size < 1 contract"
        else
            fired    := true
            trigNow  := true
            tDir     := swpDir
            tpLvl    := tgt
            refEnt   := ent
            refRisk  := rsk
            exitsSet := false
            nTrades  := nTrades + 1
            lastSkip := "—"
            if useLimit
                strategy.entry(tDir == 1 ? "MTFL" : "MTFS", tDir == 1 ? strategy.long : strategy.short, qty = q, limit = ent)
                pending := true
            else
                strategy.entry(tDir == 1 ? "MTFL" : "MTFS", tDir == 1 ? strategy.long : strategy.short, qty = q)

// ---- exits: stop is the mirror of the target around the ACTUAL fill, so the trade is a true 1:1
inPos = strategy.position_size != 0
if inPos and not exitsSet
    ent = strategy.position_avg_price
    // the fill can gap past the target latched at the trigger, leaving no trade to make
    if tDir == 1 ? tpLvl <= ent : tpLvl >= ent
        strategy.close_all(comment = "target gapped through")
        pending := false
    else
        risk = math.abs(tpLvl - ent)
        slLvl    := tDir == 1 ? ent - risk : ent + risk
        refEnt   := ent
        refRisk  := risk
        exitsSet := true
        pending  := false
if inPos and exitsSet
    // trailing only makes sense against the day's extreme; a candle extreme is a fixed level
    tgt = trailTgt and tpMode == "HOD / LOD" ? (tDir == 1 ? math.max(tpLvl, dHigh) : math.min(tpLvl, dLow)) : tpLvl
    strategy.exit("MTFLx", from_entry = "MTFL", stop = slLvl, limit = tgt)
    strategy.exit("MTFSx", from_entry = "MTFS", stop = slLvl, limit = tgt)
if not inPos and inPos[1]
    exitsSet := false
    tDir     := 0

if pending and (not inWindow or flatten)
    strategy.cancel("MTFL")
    strategy.cancel("MTFS")
    pending := false
if flatten
    strategy.close_all(comment = "flat")

if failedNow
    lastSkip := "poke closed beyond the level — a break, not a sweep"

// ================================================================ FUNNEL (how far each day gets)
var int nDays  = 0
var int nBias  = 0
var int nPoke  = 0
var int nSweep = 0
var int nFvg   = 0
var int nMss   = 0
var int nTrig  = 0
var bool dPoke  = false
var bool dSweep = false
var bool dFvg   = false
var bool dMss   = false

if winOpen
    nDays  += 1
    dPoke  := false
    dSweep := false
    dFvg   := false
    dMss   := false
    if dayBias != 0
        nBias += 1
// pokes and confirmed sweeps are counted separately — the gap between them is how often the
// spiking candle closed BEYOND the level instead of back inside, which is a break, not a sweep
if pokedNow and not dPoke
    nPoke += 1
    dPoke := true
if confirmedNow and not dSweep
    nSweep += 1
    dSweep := true
if fvgNow and not dFvg
    nFvg += 1
    dFvg := true
if mssDrawn and not dMss
    nMss += 1
    dMss := true
if trigNow
    nTrig += 1

// ================================================================ VISUALS
// Each layer belongs to a timeframe: the bias to the 4h, the sweep to the 15m, the FVG/MSS/RR to
// the 1m. On "Auto" a chart draws only the layers at or below its own resolution, so a 4h chart is
// left with the bias shading alone instead of annotations it cannot resolve.
autoDet = detail == "Auto (match the chart timeframe)"
tierMtf = not autoDet or timeframe.in_seconds() <  htfMin * 60                   // sweep layer
tierLtf = not autoDet or timeframe.in_seconds() <  timeframe.in_seconds(mtfTf)   // FVG / MSS / RR

sigCol = (tDir != 0 ? tDir : swpDir) == 1 ? longCol : shortCol

// the bias is carried by the window shading; only the reason gets a label
if tierMtf and showBias and winOpen and haveData
    label.new(bar_index, dayBias == 1 ? prvBL : prvBH,
         (dayBias == 1 ? "LONG bias — " : dayBias == -1 ? "SHORT bias — " : "no bias — ") + biasWhy,
         xloc = xloc.bar_index, style = dayBias == 1 ? label.style_label_up : label.style_label_down,
         color = color.new(dayBias == 1 ? longCol : dayBias == -1 ? shortCol : color.gray, 25),
         textcolor = color.white, size = size.small)

// The level runs from the candle that MADE it to the bar that TOOK it, and stops there — a swept
// level is spent. Nothing is drawn for a poke; only a confirmed sweep gets a line.
if tierMtf and showSet and confirmedNow
    line.new(swpFrom, swpLvl, swpBar, swpLvl, xloc = xloc.bar_index,
         color = sigCol, width = 2, style = line.style_dashed)
    label.new(swpBar, swpLvl, swpDir == -1 ? "sweep ▲ prev " + mtfTf + " H" : "sweep ▼ prev " + mtfTf + " L",
         xloc = xloc.bar_index, style = swpDir == -1 ? label.style_label_down : label.style_label_up,
         color = color.new(sigCol, 85), textcolor = sigCol, size = size.tiny)

if tierLtf and showSet and fvgNow
    box.new(fvgBar - 2, fvgTop, fvgBar + extBars, fvgBot, xloc = xloc.bar_index,
         border_color = color.new(sigCol, 40), border_width = 1, bgcolor = color.new(sigCol, 82))

if tierLtf and showSet and mssDrawn
    int mssFrom = swpDir == -1 ? swLBar : swHBar
    line.new(mssFrom, mssLvl, mssBar + math.min(extBars, 5), mssLvl, xloc = xloc.bar_index,
         color = sigCol, width = 1, style = line.style_dashed)
    label.new(mssBar, mssLvl, "MSS", xloc = xloc.bar_index,
         style = swpDir == -1 ? label.style_label_up : label.style_label_down,
         color = color.new(sigCol, 85), textcolor = sigCol, size = size.tiny)

if tierLtf and showRR and trigNow
    float sl = tDir == 1 ? refEnt - refRisk : refEnt + refRisk
    x2 = bar_index + rrBars
    box.new(bar_index, tDir == 1 ? tpLvl : refEnt, x2, tDir == 1 ? refEnt : tpLvl, xloc = xloc.bar_index,
         border_color = color.new(sigCol, 60), border_width = 1, bgcolor = color.new(color.green, 85))
    box.new(bar_index, tDir == 1 ? refEnt : sl, x2, tDir == 1 ? sl : refEnt, xloc = xloc.bar_index,
         border_color = color.new(sigCol, 60), border_width = 1, bgcolor = color.new(color.red, 85))
    label.new(x2, refEnt, (tDir == 1 ? "LONG  " : "SHORT  ") + str.tostring(refRisk, "#.##") + " pts risk @ 1:1",
         xloc = xloc.bar_index, style = label.style_label_left,
         color = color.new(color.gray, 15), textcolor = color.white, size = size.small)

plot(tierLtf and inWindow ? dHigh : na, "HOD", color = color.new(color.gray, 10), style = plot.style_linebr)
plot(tierLtf and inWindow ? dLow  : na, "LOD", color = color.new(color.gray, 10), style = plot.style_linebr)
bgcolor(inWindow ? color.new(dayBias == 1 ? longCol : dayBias == -1 ? shortCol : color.gray, 88) : na, title = "Trade window (green long / red short bias)")

// ---------------------------------------------------------------- Diagnostics panel
f_yn(bool b) => b ? "✔" : "—"
var table dg = table.new(position.bottom_right, 2, 10, border_width = 1)
if showDiag and barstate.islast
    string swpTxt = "none yet"
    if swpDir != 0
        side = swpDir == -1 ? "▲ prev H" : "▼ prev L"
        swpTxt := swpState == 1 ? "swept " + side + (busy ? "" : " (expired)") : swpState == 0 ? "poked " + side + ", awaiting close" : "poke failed (closed beyond)"
    posTxt = strategy.position_size != 0 ? "in trade" : pending ? "limit resting" : nTrades > 0 ? "done (" + str.tostring(nTrades) + ")" : "flat"
    table.cell(dg, 0, 0, "MTF 10:00", text_color = color.white, bgcolor = color.new(color.gray, 20))
    table.cell(dg, 1, 0, "state",     text_color = color.white, bgcolor = color.new(color.gray, 20))
    table.cell(dg, 0, 1, "bias", text_color = color.white)
    table.cell(dg, 1, 1, (dayBias == 1 ? "▲ long — " : dayBias == -1 ? "▼ short — " : "none — ") + biasWhy,
         text_color = dayBias == 1 ? longCol : dayBias == -1 ? shortCol : color.gray)
    table.cell(dg, 0, 2, "window", text_color = color.white)
    table.cell(dg, 1, 2, inWindow ? "OPEN" : "closed", text_color = inWindow ? color.yellow : color.gray)
    table.cell(dg, 0, 3, "sweep", text_color = color.white)
    table.cell(dg, 1, 3, swpTxt, text_color = swpDir == 0 ? color.gray : swpState == 1 ? sigCol : color.orange)
    table.cell(dg, 0, 4, sweepOnly ? "FVG / MSS (ignored)" : reqMss ? "FVG / MSS" : "FVG / (MSS)", text_color = color.white)
    table.cell(dg, 1, 4, f_yn(fvgOk and busy) + "  /  " + f_yn(mssOk and busy) + (reqMss ? "" : "  MSS not required"), text_color = color.white)
    table.cell(dg, 0, 5, "position", text_color = color.white)
    table.cell(dg, 1, 5, posTxt, text_color = color.white)
    table.cell(dg, 0, 6, "last skip", text_color = color.white)
    table.cell(dg, 1, 6, lastSkip, text_color = color.orange)
    table.cell(dg, 0, 7, "funnel", text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(dg, 1, 7, "day/bias/poke/swept", text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(dg, 0, 8, str.tostring(nDays) + " / " + str.tostring(nBias) + " / " + str.tostring(nPoke) + " / " + str.tostring(nSweep), text_color = color.yellow)
    table.cell(dg, 1, 8, "fvg " + str.tostring(nFvg) + " · mss " + str.tostring(nMss) + " · trig " + str.tostring(nTrig), text_color = color.yellow)
    table.cell(dg, 0, 9, "drawing", text_color = color.gray)
    table.cell(dg, 1, 9, not autoDet ? "all layers" : tierLtf ? "bias + sweep + FVG/MSS" : tierMtf ? "bias + sweep" : "bias only", text_color = color.gray)
