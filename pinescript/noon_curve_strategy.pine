//@version=6
// Noon Curve (run on a 5m chart). Range window = 08:00-11:00 ET by default (set 0800-1200 for the full noon window).
//   PREMISE: through the late-morning window the tape often traces a CURVE. If the LOW prints FIRST and the HIGH
//            after it (down-then-up), the afternoon tends to extend the HIGH -> the HIGH OF DAY is made after noon.
//            Mirror for high-first (up-then-down) -> the LOW OF DAY comes later. The order of the two window
//            extremes sets the direction: low-first = long, high-first = short.
//   ENTRY  : once the window closes, a resting LIMIT at a pullback from the directional extreme (the "anchor"):
//            25% / 38.2% / 50% / 61.8% of the window range.  long: anchor - depth*range ; short: anchor + depth*range.
//   DEEP   : if the window CLOSES already retraced deeper than a threshold (default 50%), the pullback has happened
//            without us -> take it LONG/SHORT at market on the window close (11:00), stop at the far range edge, same
//            target. Between the entry depth and that threshold the limit sits behind price: skip the day (default)
//            or leave the order to fill at market next bar.
//   STOP   : 50% / 75% / opposite edge (100%) of the range, measured from the SAME anchor, so the stop is always
//            a fixed fraction of the range beyond the entry. A stop that does not sit beyond the entry skips the day.
//   TARGET : the anchor itself (Ext 0% = the new HOD/LOD touch) or a 10% / 30% / 50% extension beyond it.
//   ANCHOR : "Range extreme (fixed)" freezes the 11:00 high/low. "Day extreme (running)" re-anchors as the day's
//            extreme extends, so a late pullback is measured from the newest high/low instead of the 11:00 one.
//   One trade/day, EOD flatten.  The premise is UNVALIDATED here - backtest the sequence stats before trusting it.
strategy("Noon Curve", overlay = true, pyramiding = 1, max_boxes_count = 200, max_labels_count = 200,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)

// ---------------------------------------------------------------- Inputs
tz        = input.string("America/New_York", "Timezone", group = "Session")
sess      = input.session("0800-1600", "Trading session", group = "Session",
     tooltip = "Bars outside this session are ignored for entries. Must cover the curve window and the afternoon.")
rngSess   = input.session("0800-1100", "Curve range window", group = "Session",
     tooltip = "The window whose two extremes define the curve. 0800-1100 leaves the noon hour to trade; 0800-1200 uses the full window and trades only the afternoon.")

grpC      = "Curve"
allowLong = input.bool(true,  "Longs (low first -> HOD later)",  group = grpC)
allowShort= input.bool(true,  "Shorts (high first -> LOD later)", group = grpC)
minSepMin = input.int(30, "Min minutes between the two extremes", 0, 600, group = grpC,
     tooltip = "Rejects a 'curve' where the high and the low print back-to-back. 30m on a 3h window keeps only real down-then-up (or up-then-down) shapes.")
useCloseF = input.bool(false, "Require window close in the direction half", group = grpC,
     tooltip = "Long only if the window closes in the upper half of the range (short: lower half) - i.e. the second leg is still in control at 11:00.")

grpE      = "Entry"
pbSel     = input.string("50%", "Pullback depth", options = ["25%", "38.2%", "50%", "61.8%"], group = grpE,
     tooltip = "Retrace from the anchor extreme, in % of the window range. 25% = shallow (fewer fills, more follow-through), 61.8% = deep (more fills, weaker premise).")
anchorSel = input.string("Range extreme (fixed)", "Pullback anchor", options = ["Range extreme (fixed)", "Day extreme (running)"], group = grpE,
     tooltip = "Fixed = measure from the 11:00 high/low. Running = re-measure from the day's extreme as it extends, so the limit trails a continuing move.")
mktSel    = input.string("50%", "Market entry if the window-close pullback is deeper than",
     options = ["Off", "25%", "38.2%", "50%", "61.8%"], group = grpE,
     tooltip = "Measured at 11:00 as a retrace from the directional extreme. Deeper than this and the pullback has ALREADY happened, " +
       "so the trade is taken at market on the window close instead of resting a limit, with the stop at the far range edge " +
       "(a 50%+ retrace leaves no room for the 50%/75% stop lines). Off = never enter at market.")
deepSel   = input.string("Skip day", "If past the limit but shallower than that threshold",
     options = ["Skip day", "Place the limit anyway"], group = grpE,
     tooltip = "Only bites when the market threshold is deeper than the entry depth (e.g. 25% entry, 50% threshold, price 35% retraced at 11:00): " +
       "the limit is behind price but the move is not deep enough to buy at market. Skip = stand down. " +
       "Limit anyway = leave the order, which fills at market on the next bar with the configured stop.")
skipBroke = input.bool(true, "Skip if the target side breaks before the fill", group = grpE,
     tooltip = "Fixed anchor only: if the anchor extreme is taken out before the pullback fills, the move went without us - stand down. Ignored with a running anchor.")

grpX      = "Exit"
slSel     = input.string("Opposite edge (100%)", "Stop loss", options = ["50% line", "75% line", "Opposite edge (100%)"], group = grpX,
     tooltip = "Fraction of the range beyond the anchor, same measure as the pullback. Must be deeper than the pullback depth or the day is skipped.")
tpSel     = input.string("Ext 10%", "Target", options = ["Ext 0% (new HOD/LOD)", "Ext 10%", "Ext 30%", "Ext 50%"], group = grpX,
     tooltip = "Ext 0% = a touch of the anchor extreme (the new HOD/LOD itself). Extensions are % of the range beyond it.")
useBE     = input.bool(false, "Breakeven at +1R", group = grpX)
qty       = input.float(1, "Contracts", minval = 1, group = grpX)

grpT      = "Time"
entH      = input.int(11, "Entries allowed from - hour",   0, 23, group = grpT,
     tooltip = "Earliest fill time. 11 = trade the noon hour too; set 12 to only take the post-noon leg.")
entM      = input.int(0,  "Entries allowed from - minute", 0, 59, group = grpT)
cutH      = input.int(15, "Stop new entries after - hour",   0, 23, group = grpT)
cutM      = input.int(0,  "Stop new entries after - minute", 0, 59, group = grpT)
flatH     = input.int(16, "Force-close all trades - hour",   0, 23, group = grpT)
flatM     = input.int(0,  "Force-close all trades - minute", 0, 59, group = grpT)

grpD      = "Trade days"
dMon      = input.bool(true, "Monday",    group = grpD, inline = "d")
dTue      = input.bool(true, "Tuesday",   group = grpD, inline = "d")
dWed      = input.bool(true, "Wednesday", group = grpD, inline = "d")
dThu      = input.bool(true, "Thursday",  group = grpD, inline = "d")
dFri      = input.bool(true, "Friday",    group = grpD, inline = "d")

grpA      = "Automation - PickMyTrade"
autoOn    = input.bool(false, "Enable webhook alerts", group = grpA,
     tooltip = "One alert, 'alert() function calls only'. Verify the JSON matches PickMyTrade's template.")
pmtToken  = input.string("", "PickMyTrade token", group = grpA)
pmtAcct   = input.string("", "Tradovate account id", group = grpA)
pmtSym    = input.string("MNQ1!", "Broker symbol", group = grpA)
pmtType   = input.string("market", "Order type", options = ["market", "limit"], group = grpA)

grpBA     = "Setup alert (manual)"
setAlerts = input.bool(true, "Alert when the curve resolves", group = grpBA)

grpRR     = "Risk / Reward tool"
showRR    = input.bool(true, "Show risk/reward box", group = grpRR)
showBox   = input.bool(true, "Shade the curve window", group = grpRR)
showInfo  = input.bool(true, "Show status table", group = grpRR)
ptVal     = input.float(2.0, "$ per point per contract", group = grpRR, tooltip = "MNQ=2, NQ=20, MES=5, ES=50.")
rrBars    = input.int(24, "R/R box width (bars)", 1, 300, group = grpRR)

mktOn     = mktSel != "Off"
mktF      = mktSel == "25%" ? 0.25 : mktSel == "38.2%" ? 0.382 : mktSel == "50%" ? 0.50 : 0.618
deepSkip  = deepSel == "Skip day"

pbF  = pbSel == "25%" ? 0.25 : pbSel == "38.2%" ? 0.382 : pbSel == "50%" ? 0.50 : 0.618
slF  = slSel == "50% line" ? 0.50 : slSel == "75% line" ? 0.75 : 1.0
extF = tpSel == "Ext 0% (new HOD/LOD)" ? 0.0 : tpSel == "Ext 10%" ? 0.10 : tpSel == "Ext 30%" ? 0.30 : 0.50
runAnchor = anchorSel == "Day extreme (running)"

// ---------------------------------------------------------------- Session / window tracking
inSess  = not na(time(timeframe.period, sess, tz))
inRng   = not na(time(timeframe.period, rngSess, tz))
rngDone = not inRng and inRng[1]
dom     = dayofmonth(time, tz)
newDay  = dom != nz(dom[1], -1)

dow   = dayofweek(time, tz)
dayOK = (dow == dayofweek.monday and dMon) or (dow == dayofweek.tuesday and dTue) or (dow == dayofweek.wednesday and dWed) or (dow == dayofweek.thursday and dThu) or (dow == dayofweek.friday and dFri)

var float rH     = na       // curve-window high / low and when each printed
var float rL     = na
var int   rHbar  = na
var int   rLbar  = na
var int   rHtime = na
var int   rLtime = na
var int   rStart = na       // bar_index at the window open (for the shading box)
var float rng    = na
var float anchor = na       // extreme the pullback is measured from
var float pbDepth = na      // retrace already done when the window closed, in % of range
var int   dir    = 0
var float entryLvl = na
var float stopLvl  = na
var float tpLvl    = na
var bool  lowFirst = false
var bool  isMkt    = false  // deep-pullback day: take it at market instead of resting a limit
var bool  placed   = false
var bool  beDone   = false
var bool  wasIn    = false
var bool  done     = false

if newDay
    rH := na
    rL := na
    rHbar := na
    rLbar := na
    rHtime := na
    rLtime := na
    rStart := na
    rng := na
    anchor := na
    pbDepth := na
    dir := 0
    entryLvl := na
    stopLvl := na
    tpLvl := na
    lowFirst := false
    isMkt := false
    placed := false
    beDone := false
    wasIn := false
    done := false

if inRng
    if na(rStart)
        rStart := bar_index
    if na(rH) or high > rH
        rH := high
        rHbar := bar_index
        rHtime := time
    if na(rL) or low < rL
        rL := low
        rLbar := bar_index
        rLtime := time

// running anchor tracks the day's extreme from the window open onward
var float dayH = na
var float dayL = na
if newDay
    dayH := na
    dayL := na
if inRng or (not na(rStart) and inSess)
    dayH := na(dayH) ? high : math.max(dayH, high)
    dayL := na(dayL) ? low  : math.min(dayL, low)

// ---------------------------------------------------------------- Level helpers (all direction-relative to the anchor)
f_ent(int d, float a, float rg) => d == 1 ? a - pbF*rg  : a + pbF*rg
f_stp(int d, float a, float rg) => d == 1 ? a - slF*rg  : a + slF*rg
f_tgt(int d, float a, float rg) => d == 1 ? a + extF*rg : a - extF*rg

// ---------------------------------------------------------------- Resolve the curve at the window close
if rngDone and dayOK and not na(rH) and not na(rL) and rH > rL and rHbar != rLbar
    rng := rH - rL
    lowFirst := rLtime < rHtime
    sepOK = math.abs(rHtime - rLtime) >= minSepMin * 60000
    pos   = (close[1] - rL) / rng                                       // where the window closed inside the range
    if sepOK
        if allowLong and lowFirst and (not useCloseF or pos >= 0.5)
            dir := 1
        else if allowShort and (not lowFirst) and (not useCloseF or pos <= 0.5)
            dir := -1
    if dir != 0
        anchor := dir == 1 ? rH : rL
        entryLvl := f_ent(dir, anchor, rng)
        stopLvl  := f_stp(dir, anchor, rng)
        tpLvl    := f_tgt(dir, anchor, rng)
        pbDepth := dir == 1 ? (anchor - close[1]) / rng : (close[1] - anchor) / rng  // retrace already done at the close
        if mktOn and pbDepth >= mktF
            // deeper than the threshold at the window close: that IS the pullback - take it now, stop at the range edge
            isMkt := true
            entryLvl := close[1]                                        // reference price only - the fill is at market
            stopLvl  := dir == 1 ? rL : rH
            if math.abs(entryLvl - stopLvl) < 2 * syminfo.mintick
                dir := 0                                                // sitting on the edge -> no room for a stop
                isMkt := false
        else if slF <= pbF
            dir := 0                                                    // stop not beyond the limit entry -> skip
        else if pbDepth >= pbF and deepSkip
            dir := 0                                                    // past the limit, too shallow to buy at market -> skip

// ---------------------------------------------------------------- Time gates
tod      = hour(time, tz) * 60 + minute(time, tz)
canEnter = inSess and dayOK and tod >= (entH*60 + entM) and tod <= (cutH*60 + cutM)
flatten  = tod >= (flatH*60 + flatM)

// ---------------------------------------------------------------- Re-anchor on a running extreme (while still flat)
if runAnchor and not isMkt and dir != 0 and not done and strategy.position_size == 0 and not na(rng)
    newAnchor = dir == 1 ? math.max(nz(anchor, rH), nz(dayH, rH)) : math.min(nz(anchor, rL), nz(dayL, rL))
    if newAnchor != anchor
        anchor := newAnchor
        entryLvl := f_ent(dir, anchor, rng)
        stopLvl  := f_stp(dir, anchor, rng)
        tpLvl    := f_tgt(dir, anchor, rng)

// ---------------------------------------------------------------- Arm the entry: market (deep day) or resting LIMIT
armOK = dir != 0 and not done and canEnter and not flatten and strategy.position_size == 0 and not na(entryLvl)
// a buy limit must sit below price (sell limit above), else it fills instantly at market
lvlOK = isMkt or (dir == 1 ? entryLvl < close : entryLvl > close)
if armOK and lvlOK
    if isMkt
        if not placed                                                   // market goes once, at the window close
            if dir == 1
                strategy.entry("L", strategy.long,  qty = qty)
            else
                strategy.entry("S", strategy.short, qty = qty)
            placed := true
    else
        if dir == 1                                                     // re-issued each bar so a running anchor can move it
            strategy.entry("L", strategy.long,  qty = qty, limit = entryLvl)
        else
            strategy.entry("S", strategy.short, qty = qty, limit = entryLvl)

// ---------------------------------------------------------------- Stand down if the move goes without us (fixed anchor)
var bool everFilled = false
if newDay
    everFilled := false
everFilled := everFilled or strategy.position_size != 0
if skipBroke and not runAnchor and not isMkt and dir != 0 and not everFilled and not na(anchor)
    if (dir == 1 and high > anchor) or (dir == -1 and low < anchor)
        done := true

// ---------------------------------------------------------------- Manage the position
var float mgStop = na
var float mgTP   = na
opened = strategy.position_size != 0 and strategy.position_size[1] == 0
if opened
    mgStop := stopLvl
    mgTP   := tpLvl
    beDone := false
if useBE and not beDone and strategy.position_size != 0 and not na(mgStop)
    epx = strategy.position_avg_price
    R   = math.abs(epx - mgStop)
    if dir == 1 and high >= epx + R
        mgStop := math.max(mgStop, epx)
        beDone := true
    if dir == -1 and low <= epx - R
        mgStop := math.min(mgStop, epx)
        beDone := true
if strategy.position_size != 0
    strategy.exit("Lx", from_entry = "L", stop = mgStop, limit = mgTP)
    strategy.exit("Sx", from_entry = "S", stop = mgStop, limit = mgTP)

wasIn := wasIn or strategy.position_size != 0
if strategy.position_size == 0 and wasIn
    done := true                                                        // one trade per day
if done or flatten or not canEnter
    strategy.cancel("L")
    strategy.cancel("S")
if flatten
    strategy.close_all(comment = "Force close")

// ---------------------------------------------------------------- Automation
f_pmt(string act, float q, float slp, float tpp) =>
    '{"token":"' + pmtToken + '","account_id":"' + pmtAcct + '","symbol":"' + pmtSym +
      '","action":"' + act + '","quantity":' + str.tostring(q) +
      ',"order_type":"' + pmtType +
      '","sl":' + str.tostring(math.round_to_mintick(slp)) +
      ',"tp":' + str.tostring(math.round_to_mintick(tpp)) + '}'
buyNow   = strategy.position_size > 0 and strategy.position_size[1] <= 0
sellNow  = strategy.position_size < 0 and strategy.position_size[1] >= 0
closeNow = flatten and strategy.position_size[1] != 0
if autoOn and buyNow
    alert(f_pmt("buy",  qty, mgStop, mgTP), alert.freq_once_per_bar)
if autoOn and sellNow
    alert(f_pmt("sell", qty, mgStop, mgTP), alert.freq_once_per_bar)
if autoOn and closeNow
    alert(f_pmt("close", 0, 0.0, 0.0), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Manual alert at the window close
if setAlerts and rngDone and dir != 0
    alert("NOON CURVE  " + (dir == 1 ? "LONG (low first -> HOD later)" : "SHORT (high first -> LOD later)") +
         (isMkt ? "  | MARKET now (deep pullback)" : "  | limit " + str.tostring(math.round_to_mintick(entryLvl))) +
         "  | stop "  + str.tostring(math.round_to_mintick(stopLvl)) +
         "  | target " + str.tostring(math.round_to_mintick(tpLvl)), alert.freq_once_per_bar)

// ---------------------------------------------------------------- Curve window shading
if showBox and rngDone and not na(rStart) and not na(rH) and not na(rL)
    box.new(rStart, rH, bar_index, rL, xloc = xloc.bar_index,
         border_color = color.new(color.gray, 40), border_width = 1, bgcolor = color.new(color.blue, 92))
    label.new(bar_index, rH, dir == 0 ? "no curve" : (dir == 1 ? "curve down-up: LONG" : "curve up-down: SHORT"),
         xloc = xloc.bar_index, style = label.style_label_down, size = size.tiny,
         color = color.new(dir == 1 ? color.green : dir == -1 ? color.red : color.gray, 25), textcolor = color.white)

// ---------------------------------------------------------------- R/R box (at the window close)
if showRR and rngDone and dir != 0 and not na(entryLvl) and not na(stopLvl) and not na(tpLvl)
    x1 = bar_index
    x2 = bar_index + rrBars
    riskUsd = math.abs(entryLvl - stopLvl) * ptVal * qty
    rewUsd  = math.abs(tpLvl - entryLvl) * ptVal * qty
    rrr = riskUsd > 0 ? rewUsd / riskUsd : na
    rewTop = dir == 1 ? tpLvl : entryLvl
    rewBot = dir == 1 ? entryLvl : tpLvl
    rskTop = dir == 1 ? entryLvl : stopLvl
    rskBot = dir == 1 ? stopLvl : entryLvl
    box.new(x1, rewTop, x2, rewBot, xloc = xloc.bar_index, border_color = color.new(color.green, 0), border_width = 1, bgcolor = color.new(color.green, 82))
    box.new(x1, rskTop, x2, rskBot, xloc = xloc.bar_index, border_color = color.new(color.red, 0),   border_width = 1, bgcolor = color.new(color.red, 82))
    label.new(x2, entryLvl, "Risk $" + str.tostring(riskUsd, "#") + " | Reward $" + str.tostring(rewUsd, "#") + " (" + str.tostring(rrr, "#.##") + "R)",
         xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)

// ---------------------------------------------------------------- Status table
var table info = table.new(position.top_right, 2, 8, border_width = 1)
if showInfo and barstate.islast
    st = dir == 0 ? (na(rng) ? "waiting for window" : "no setup today") : done ? "done" : strategy.position_size != 0 ? "in trade" : isMkt ? "market armed" : "limit resting"
    table.cell(info, 0, 0, "Noon Curve", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 0, st,           text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 0, 1, "Window hi/lo", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 1, na(rH) ? "-" : str.tostring(math.round_to_mintick(rH)) + " / " + str.tostring(math.round_to_mintick(rL)), text_color = color.silver, text_size = size.small)
    table.cell(info, 0, 2, "Sequence", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 2, na(rng) ? "-" : (lowFirst ? "low first" : "high first"), text_color = color.silver, text_size = size.small)
    table.cell(info, 0, 3, "Direction", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 3, dir == 1 ? "LONG" : dir == -1 ? "SHORT" : "-", text_color = dir == 1 ? color.lime : dir == -1 ? color.red : color.silver, text_size = size.small)
    table.cell(info, 0, 7, "Close depth", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 7, na(pbDepth) ? "-" : str.tostring(pbDepth * 100, "#.#") + "%" + (isMkt ? " (market)" : ""), text_color = color.silver, text_size = size.small)
    table.cell(info, 0, 4, "Entry (" + (isMkt ? "market, deep" : pbSel) + ")", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 4, dir == 0 or na(entryLvl) ? "-" : str.tostring(math.round_to_mintick(entryLvl)), text_color = color.orange, text_size = size.small)
    table.cell(info, 0, 5, "Stop", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 5, dir == 0 or na(stopLvl) ? "-" : str.tostring(math.round_to_mintick(stopLvl)), text_color = color.red, text_size = size.small)
    table.cell(info, 0, 6, "Target", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(info, 1, 6, dir == 0 or na(tpLvl) ? "-" : str.tostring(math.round_to_mintick(tpLvl)), text_color = color.green, text_size = size.small)

// ---------------------------------------------------------------- Visuals
plot(not na(rH) ? rH : na, "Window High", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(not na(rL) ? rL : na, "Window Low",  color = color.new(color.red, 0),  style = plot.style_linebr)
plot(dir != 0 and not na(entryLvl) ? entryLvl : na, "Entry",  color = color.new(color.orange, 0), style = plot.style_linebr)
plot(dir != 0 and not na(stopLvl)  ? stopLvl  : na, "Stop",   color = color.new(color.maroon, 0), style = plot.style_linebr)
plot(dir != 0 and not na(tpLvl)    ? tpLvl    : na, "Target", color = color.new(color.green, 0),  style = plot.style_linebr)
