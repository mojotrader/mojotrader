//@version=6
// PropQuantX Halyard MNQ 15min FREE
//
// Single-candle opening-range breakout with an optional loser re-entry and an
// optional loser reversal. Built for MNQ on 15-minute bars, extended hours.
//
// The range is one 15-minute candle. The first bar that CLOSES beyond it takes
// the day's trade and consumes the day whichever side it fired on — there is no
// second attempt if the filters reject it. Stop sits on the opposite edge of the
// range, target is a multiple of that distance. Flat before the session rolls;
// nothing is ever carried overnight.
//
// AFTER A STOP-OUT the day gets ONE more fill, from whichever of the two second-
// chance branches triggers first:
//   Re-entry — SAME direction as the loser, on a fresh close back beyond the
//              SAME range edge the first trade broke. Ships ON.
//   Reversal — OPPOSITE direction, on a close beyond the far edge. Ships OFF.
// They can never collide on one bar: a close cannot be above the ORB high and
// below the ORB low at once. Whichever fires ends the day.
//
// Editable: Position Sizing, Trade Management, Day Filter, Range Filter and
// Trade Visualization. Everything else is fixed in the CONFIGURATION block.
//
// Timezone is hardcoded — do not change your chart's timezone expecting the
// levels to move, they will not.
strategy("PropQuantX Halyard MNQ 15min FREE", overlay = true, pyramiding = 0, process_orders_on_close = true, initial_capital = 150000, default_qty_type = strategy.fixed, default_qty_value = 1, slippage = 0, commission_type = strategy.commission.cash_per_contract, commission_value = 0, margin_long = 1, margin_short = 1, max_labels_count = 500, max_boxes_count = 500)

// === Inputs ===
grpPS = "Position Sizing"
useRiskSizing = input.bool(true, "Use $ Risk Position Sizing", group = grpPS)
riskUSD = input.float(535, "Risk Per Trade ($)", minval = 0, group = grpPS)
qtyContracts = input.int(1, "Contracts (If Risk Sizing Off)", minval = 1, group = grpPS)
maxContracts = input.int(1000, "Max Contracts", minval = 1, group = grpPS, tooltip = "Hard cap on the risk-sized quantity.")

// Trade management. All three R:R inputs are exposed, not just the first: the
// re-entry and reverse ones are UNREAD while their toggle is off but go LIVE the
// moment it is ticked, and shipping a toggle that silently arms a hidden number
// is a trap.
grpTM = "Trade Management"
riskReward = input.float(0.8, "Risk:Reward (First Trade)", minval = 0.1, step = 0.01, group = grpTM)
enableReentryTrade = input.bool(true, "Enable Re-entry After Loss", group = grpTM, tooltip = "Same direction as the losing first trade, on a fresh close back beyond the same ORB edge. Raises the day's fill cap to 2.")
reentryRiskReward = input.float(0.8, "Risk:Reward (Re-entry Trade)", minval = 0.1, step = 0.01, group = grpTM, tooltip = "Only read while Enable Re-entry After Loss is on.")
enableReverseTrade = input.bool(false, "Enable Reverse Trade", group = grpTM, tooltip = "Opposite direction to the losing first trade. Also raises the day's fill cap to 2.")
reverseRiskReward = input.float(1.0, "Risk:Reward (Reverse Trade)", minval = 0.1, step = 0.01, group = grpTM, tooltip = "Only read while Enable Reverse Trade is on.")

// Day filter — one direction setting per weekday. "Off" is a day that never trades.
grpD = "Day Filter"
dayTip = "Read on the SESSION's day, which ends 13:30 / 14:30 ET — not on the calendar day."
dayMon = input.string("Long", "Monday", options = ["Both", "Long", "Short", "Off"], group = grpD, tooltip = dayTip)
dayTue = input.string("Both", "Tuesday", options = ["Both", "Long", "Short", "Off"], group = grpD)
dayWed = input.string("Both", "Wednesday", options = ["Both", "Long", "Short", "Off"], group = grpD)
dayThu = input.string("Both", "Thursday", options = ["Both", "Long", "Short", "Off"], group = grpD)
dayFri = input.string("Both", "Friday", options = ["Both", "Long", "Short", "Off"], group = grpD)

// Range filter — a DAY gate on the range candle's own size, in POINTS. 0 = off on
// either side. BOTH SHIP AT 0, so this changes nothing until a value is set.
grpR = "Range Filter"
orbRangeMinPts = input.float(0, "Min ORB Range (pts, 0=off)", minval = 0, step = 0.25, group = grpR, tooltip = "Skip the day if the range is narrower than this.")
orbRangeMaxPts = input.float(0, "Max ORB Range (pts, 0=off)", minval = 0, step = 0.25, group = grpR, tooltip = "Skip the day if the range is wider than this.")

// Min above Max passes on NOTHING, and a strategy that silently stops trading
// reads as "no signals today" rather than as a typo. Fail loudly instead.
if orbRangeMaxPts > 0 and orbRangeMinPts > orbRangeMaxPts
    runtime.error("Range Filter: Min ORB Range is above Max ORB Range, so no day can ever pass. Fix one of them.")

// Trade visualization. The boxes and their three price labels draw the exact
// stop and target of the live trade.
grpV = "Trade Visualization"
showPnLBoxes = input.bool(true, "Show TP/SL P&L Boxes", group = grpV)
showPnLLabels = input.bool(true, "Show TP/SL Labels", group = grpV)
profitBoxColor = input.color(color.blue, "Profit Box Color", group = grpV)
lossBoxColor = input.color(color.red, "Loss Box Color", group = grpV)

// === CONFIGURATION ===
// Fixed settings. Values marked UNREAD belong to a mode that is not selected —
// they are kept so the mode ternaries below still compile, and a constant
// condition folds anyway.
//
// NOTE WHICH VALUES ARE LIVE: tpType is Risk:Reward, so the Risk:Reward inputs
// above ARE read and `tpFixedTicks` / `atrTpMult` are not.
tradeDirection = "Both"       // blanket override on top of the per-day grid

slType = "ORB Edge + Buffer"
slBufferPts = 0.0             // ZERO -> the stop sits exactly ON the opposite ORB edge
slFixedTicks = 340            // UNREAD under ORB Edge + Buffer
atrSlMult = 3.8               // UNREAD under ORB Edge + Buffer
// UNREAD under ORB Edge + Buffer. Set slType = "Breakout Candle" above to arm
// the fourth mode: the stop goes beyond the breakout candle instead of the far
// ORB edge, and slBufferPts is then measured past THAT extreme. 1 = the
// breakout candle alone; 2 or 3 also take in the 1-2 candles BEFORE it, and
// since the level is the lowest low / highest high of that window, raising it
// can only widen the stop, never tighten it.
slCandleBars = 1
tpType = "Risk:Reward"
tpFixedTicks = 90             // UNREAD under Risk:Reward
atrTpMult = 5.0               // UNREAD under Risk:Reward
atrLen = 32                   // UNREAD: no ATR mode is picked and the vol filter is gone
maxBarsInTrade = 0            // 0 = TIME STOP OFF. Only TP, SL and the day flat close a trade

// OFF, so there are no entry filters at all: the break, the weekday grid and the
// direction are the whole entry condition. Set true to arm the trend filter.
useShortTrend = false
shortTrendEma = 190

// === ORB settings — the clock is HARDCODED to New York ===
// There is no timezone input any more, and the chart's own timezone setting
// moves nothing: every clock read below passes `tz` explicitly.
//
// THE CONVERSION IS NOT A FIXED HOUR, which is the whole subtlety. The range
// candle is anchored to 10:30 Asia/Kolkata = 05:00 UTC every day of the year,
// because India has no DST and the US does. On the New York clock that is 00:00
// under EST and 01:00 under EDT, so the ET hour has to FOLLOW the US changeover
// or it sits on the wrong bars for half the year. Both seasonal values below are
// therefore derived per bar rather than typed in.
tz = "America/New_York"

// ET's UTC offset in minutes on bar `t`: 300 under EST, 240 under EDT. Read off
// the tape rather than assumed, because the entire point is that it moves. The
// `+ 1440 % 1440` is there because New York and UTC are usually on different
// calendar days, which sends the raw difference negative.
f_etOffsetMin(t) =>
    etM = hour(t, tz) * 60 + minute(t, tz)
    (hour(t, "Etc/UTC") * 60 + minute(t, "Etc/UTC") - etM + 1440) % 1440

// 10:30 Asia/Kolkata written on the New York clock: 00:00 EST / 01:00 EDT.
f_orbStartMin(t) => f_etOffsetMin(t) == 240 ? 60 : 0

// 00:00 Asia/Kolkata — the boundary the trading day rolls on — written on the
// same clock: 13:30 EST / 14:30 EDT. It resets the day's state, picks the
// day-of-week and force-flattens.
f_sessionEndMin(t) => f_etOffsetMin(t) == 240 ? 870 : 810

// The instant this bar's session ENDS, on the New York clock. Shifting a bar
// forward to its own boundary makes the session's date and weekday simply the ET
// date and weekday of the shifted instant — no wrap-around arithmetic anywhere,
// and the key and the day filter cannot drift apart because they read the same
// shift. Bumping a YYYYMMDD key by 1 instead LOOKS equivalent and is not:
// 20260531 + 1 is not 20260601, so every month boundary would split one session
// into two, resetting the day's state and force-flattening mid-session.
f_sessionShift(t) => t + (1440 - f_sessionEndMin(t)) * 60000

f_sessionKey(t) =>
    s = f_sessionShift(t)
    year(s, tz) * 10000 + month(s, tz) * 100 + dayofmonth(s, tz)

// A STRING, not an int: request.security demands a SIMPLE string timeframe, and
// str.tostring() of an int is series-qualified — that combination does not
// compile. `orbMinutes` is gone with the volatility filter, which was the only
// thing that needed the width as a number.
orbTf = "15"

// The two Trade Visualization knobs that stayed locked. The switches and the two
// colours are inputs, up in the Inputs block.
keepTradeBoxes = 20
boxTransp = 70

// The day's fill cap is DERIVED from the two second-chance switches rather than
// being a third, disagreeable input. Either one on buys the day ONE extra fill —
// not one each: whichever branch triggers first ends the day, so a stop-out is
// followed by at most one more trade even with both ticked.
maxTradesPerDay = (enableReentryTrade or enableReverseTrade) ? 2 : 1

// === Risk / Position sizing ===
// Quantity is auto-calculated from: riskUSD / (abs(entry - stop) * syminfo.pointvalue)
calcQty(risk, entry, sl) =>
    riskPerPoint = math.abs(entry - sl)
    riskPerContract = riskPerPoint * syminfo.pointvalue
    math.max(math.floor(risk / (riskPerContract > 0 ? riskPerContract : syminfo.mintick * syminfo.pointvalue)), 1)

f_finalQty(_entry, _sl) =>
    q = useRiskSizing ? calcQty(riskUSD, _entry, _sl) : qtyContracts
    math.min(q, maxContracts)

// === TP/SL P&L visualization (boxes + labels) ===
// A BLUE profit box from entry to target, a RED risk box from entry to stop, and
// three text-only price labels (target / entry / stop) anchored at the entry bar
// with fully transparent backgrounds.
var box curRiskBox = na
var box curProfitBox = na
var label curSLLabel = na
var label curTPLabel = na
var label curEntryLabel = na

var array<box> histBoxes = array.new<box>()
var array<label> histLabels = array.new<label>()

// Extend the boxes to the right while the trade is live. The labels stay put at
// the entry bar, which keeps the three prices readable against the box edges
// instead of sliding along with price.
// math.max against left+8, never a bare bar_index: the boxes are BORN 8 bars
// wide, so assigning bar_index would shrink them back on the very next bar.
if showPnLBoxes and strategy.position_size != 0
    if not na(curRiskBox)
        box.set_right(curRiskBox, math.max(box.get_left(curRiskBox) + 8, bar_index))
    if not na(curProfitBox)
        box.set_right(curProfitBox, math.max(box.get_left(curProfitBox) + 8, bar_index))

// When a position closes, either keep or delete the boxes/labels based on keepTradeBoxes
posJustClosed = bar_index >= 1 and strategy.position_size == 0 and strategy.position_size[1] != 0
if showPnLBoxes and posJustClosed
    // Minimum 8 bars wide — a trade that closes in one or two bars
    // would otherwise leave a sliver too thin to read.
    if not na(curRiskBox)
        box.set_right(curRiskBox, math.max(box.get_left(curRiskBox) + 8, bar_index))
    if not na(curProfitBox)
        box.set_right(curProfitBox, math.max(box.get_left(curProfitBox) + 8, bar_index))

    if keepTradeBoxes == 0
        if not na(curRiskBox)
            box.delete(curRiskBox)
        if not na(curProfitBox)
            box.delete(curProfitBox)
        if not na(curSLLabel)
            label.delete(curSLLabel)
        if not na(curTPLabel)
            label.delete(curTPLabel)
        if not na(curEntryLabel)
            label.delete(curEntryLabel)
    else
        if not na(curRiskBox)
            array.push(histBoxes, curRiskBox)
        if not na(curProfitBox)
            array.push(histBoxes, curProfitBox)
        if not na(curSLLabel)
            array.push(histLabels, curSLLabel)
        if not na(curTPLabel)
            array.push(histLabels, curTPLabel)
        if not na(curEntryLabel)
            array.push(histLabels, curEntryLabel)

    curRiskBox := na
    curProfitBox := na
    curSLLabel := na
    curTPLabel := na
    curEntryLabel := na

// Enforce history limit on every bar (also handles reducing keepTradeBoxes)
if showPnLBoxes
    maxBoxCount = keepTradeBoxes * 2
    maxLabelCount = keepTradeBoxes * 3

    while keepTradeBoxes >= 0 and array.size(histBoxes) > maxBoxCount
        oldB = array.shift(histBoxes)
        box.delete(oldB)

    while keepTradeBoxes >= 0 and array.size(histLabels) > maxLabelCount
        oldL = array.shift(histLabels)
        label.delete(oldL)

// === Visual defaults (kept as constants, not inputs) ===
// The breakout TRIANGLE marks the bar that BREAKS the range, not the range
// candle itself.
showBreakoutMarker = true
orbHighColor = color.new(color.green, 30)
orbLowColor = color.new(color.red, 30)

// === Helpers (evaluated on the ORB timeframe inside request.security) ===
// `time` here is the ORB-timeframe bar's own time, so the DST test resolves on
// that bar rather than on the chart bar.
f_isOrbCandle() =>
    hour(time, tz) * 60 + minute(time, tz) == f_orbStartMin(time)

f_orbHighConfirmed() =>
    isOrb = f_isOrbCandle()
    isOrb and barstate.isconfirmed ? high : na

f_orbLowConfirmed() =>
    isOrb = f_isOrbCandle()
    isOrb and barstate.isconfirmed ? low : na

f_orbStartTimeConfirmed() =>
    isOrb = f_isOrbCandle()
    isOrb and barstate.isconfirmed ? time : na

// === Get the ORB candle High/Low (timezone anchored, timeframe anchored) ===
orbHighNew = request.security(syminfo.tickerid, orbTf, f_orbHighConfirmed(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
orbLowNew = request.security(syminfo.tickerid, orbTf, f_orbLowConfirmed(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
orbStartNew = request.security(syminfo.tickerid, orbTf, f_orbStartTimeConfirmed(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

// Reset once per session, on the 13:30 / 14:30 ET boundary — NOT on ET midnight.
sessionKey = f_sessionKey(time)
newDay = ta.change(sessionKey)

// === Persistent state ===
var float orbHigh = na
var float orbLow = na
var int orbStartTime = na

// The day's first break latches here and consumes the day whichever side it
// fired on.
var bool breakoutMarked = false

// Daily reset
if bool(newDay)
    orbHigh := na
    orbLow := na
    orbStartTime := na
    breakoutMarked := false

// When the ORB candle closes (confirmed), store its high/low as the day's levels.
orbReadyNow = not na(orbHighNew) and not na(orbLowNew) and not na(orbStartNew)
orbTrigger = orbReadyNow and (na(orbStartTime) or orbStartNew != orbStartTime)
if orbTrigger
    orbHigh := orbHighNew
    orbLow := orbLowNew
    orbStartTime := orbStartNew
    breakoutMarked := false

levelsAvailable = not na(orbHigh) and not na(orbLow) and not na(orbStartTime)

// === Indicators ===
// The ATR is only referenced by mode branches that are not selected.
emaShortVal = ta.ema(close, shortTrendEma)
atrVal = ta.atr(atrLen)

// === Entry filters ===
// RANGE is a DAY gate: it gates the BREAKOUT LATCH below, not the entry. That
// distinction is the whole behaviour — a day the range rejects is skipped ENTIRELY
// (no first trade, no re-entry, no reversal, no triangle drawn) and is NOT
// consumed, because `breakoutMarked` can only latch on a day allowed to break out
// in the first place.
//
// Knowable at the bars it gates: the range is fixed when the ORB candle closes,
// which is before anything can trade that day.
orbRange = orbHigh - orbLow
rangeDayOk = not na(orbRange) and (orbRangeMinPts <= 0 or orbRange >= orbRangeMinPts) and (orbRangeMaxPts <= 0 or orbRange <= orbRangeMaxPts)

// The per-BAR filter, and it is SHORTS ONLY. It ships off. Unlike the range gate
// above, a bar filter rejecting a break still CONSUMES the day — the latch fires
// on the break, not on the entry.
filterShortOK = not useShortTrend or (not na(emaShortVal) and close < emaShortVal)

// `breakoutMarked` latches the day's first break, so anything after it is ignored.
breakoutUp = levelsAvailable and rangeDayOk and not breakoutMarked and barstate.isconfirmed and close > orbHigh
breakoutDn = levelsAvailable and rangeDayOk and not breakoutMarked and barstate.isconfirmed and close < orbLow
breakoutClose = breakoutUp or breakoutDn

// The first break consumes the day whichever side it fires on, and whether or
// not it passes its filters, so a filter can only ever REMOVE a trade, never
// substitute a later one.
if breakoutClose
    breakoutMarked := true

plotshape(showBreakoutMarker and breakoutUp, title = "Close Above ORB High", style = shape.triangleup, location = location.abovebar, color = orbHighColor, size = size.tiny)
plotshape(showBreakoutMarker and breakoutDn, title = "Close Below ORB Low", style = shape.triangledown, location = location.belowbar, color = orbLowColor, size = size.tiny)

// === Stop / target by type ===
// ORB Edge + Buffer and Breakout Candle are structural (a price level, pushed
// slBufferPts PAST it). The other two are distances from the entry price.
//
// The two window extremes are computed HERE, at global scope, on every bar —
// NOT inside f_longStop/f_shortStop. Those are called from inside the six
// `if enter*` blocks, and a ta.* call that only runs on the bars where an
// entry fires does not see the continuous history it needs: it would return a
// value taken over whatever sparse set of bars happened to trigger, which on a
// once-a-day strategy is days apart. `ta.lowest(low, n)` INCLUDES the current
// bar, so the window ends at the breakout candle itself with no offset — and
// that is correct rather than lookahead, because Pine fills the entry at the
// NEXT bar's open, by which point this bar has closed.
//
// NOTE: no session reset. At slCandleBars > 1 a breakout within 1-2 bars of the
// session start reaches into the prior session. Only reachable when the range
// candle sits right at the open.
slWinLow = ta.lowest(low, slCandleBars)
slWinHigh = ta.highest(high, slCandleBars)
// Floored at one tick. slBufferPts ships at 0.0, and a
// breakout candle that closes on its own low puts the raw level exactly ON
// `close` — which is the entry reference calcQty divides by, so the risk per
// contract would be zero and the size would slam into maxContracts. The floor
// is what stops that, so do not drop it when tuning the buffer to 0.
// NOTE the unit: slBufferPts is POINTS, not ticks. On MNQ/NQ one tick is 0.25
// points, so one tick of buffer is 0.25 here, not 1.
slCandleBuf = math.max(slBufferPts, syminfo.mintick)

f_longStop(entryPx) =>
    slType == "ORB Edge + Buffer" ? orbLow - slBufferPts : slType == "Breakout Candle" ? slWinLow - slCandleBuf : slType == "Fixed Ticks" ? entryPx - slFixedTicks * syminfo.mintick : entryPx - atrVal * atrSlMult

f_shortStop(entryPx) =>
    slType == "ORB Edge + Buffer" ? orbHigh + slBufferPts : slType == "Breakout Candle" ? slWinHigh + slCandleBuf : slType == "Fixed Ticks" ? entryPx + slFixedTicks * syminfo.mintick : entryPx + atrVal * atrSlMult

// rr is only reached in Risk:Reward mode — under ATR / Fixed Ticks the first
// trade, the re-entry and the reversal all get the SAME distance.
f_longTP(entryPx, stopPx, rr) =>
    tpType == "Risk:Reward" ? entryPx + (entryPx - stopPx) * rr : tpType == "Fixed Ticks" ? entryPx + tpFixedTicks * syminfo.mintick : entryPx + atrVal * atrTpMult

f_shortTP(entryPx, stopPx, rr) =>
    tpType == "Risk:Reward" ? entryPx - (stopPx - entryPx) * rr : tpType == "Fixed Ticks" ? entryPx - tpFixedTicks * syminfo.mintick : entryPx - atrVal * atrTpMult

// === Strategy Execution ===
// Day filter (uses ORB timezone)
// The SESSION's day-of-week, not the bar's: a bar past the 13:30 / 14:30 ET
// boundary already belongs to tomorrow's session. Read off the same shifted
// instant as the session key, so the two agree by construction.
dow = dayofweek(f_sessionShift(time), tz)
// Saturday and Sunday fall through to "Off", which is what the five booleans did
// before — nothing here has to special-case the weekend.
dayMode = dow == dayofweek.monday ? dayMon : dow == dayofweek.tuesday ? dayTue : dow == dayofweek.wednesday ? dayWed : dow == dayofweek.thursday ? dayThu : dow == dayofweek.friday ? dayFri : "Off"
tradeDayOK = dayMode != "Off"

// The per-day setting ANDs into the global Trade Direction rather than replacing
// it, so the global still works as a blanket override on top of the per-day grid.
directionLongOK = (tradeDirection == "Both" or tradeDirection == "Long") and (dayMode == "Both" or dayMode == "Long")
directionShortOK = (tradeDirection == "Both" or tradeDirection == "Short") and (dayMode == "Both" or dayMode == "Short")

// State machine (per day):
// 0 = no trade yet (wait for first breakout)
// 1 = first trade placed (wait for it to close)
// 2 = first trade stopped out (wait for the SAME-side close beyond the ORB that
//     arms the re-entry, or the OPPOSITE-side close that arms the reversal —
//     whichever lands first)
// 3 = done for the day (first trade hit TP, or the second chance was taken)
//
// State 2 is the only state the extra trade can fire from, and both branches
// leave state 3, so the day is capped at two fills no matter which one wins and
// a losing re-entry is never followed by a third attempt.
var int tradeState = 0
var int firstTradeDir = 0
var int prevClosedTrades = 0
var int tradesToday = 0

if bool(newDay)
    tradeState := 0
    firstTradeDir := 0
    tradesToday := 0
    prevClosedTrades := strategy.closedtrades

// Detect when a trade closes and determine whether it was a stop-out (loss) or TP (profit).
// Guarded on tradeState == 1, so the SECOND trade closing cannot walk the state
// backwards out of 3 — the day stays done however that trade ends.
if strategy.closedtrades > prevClosedTrades
    lastTradeIdx = strategy.closedtrades - 1
    lastProfit = strategy.closedtrades.profit(lastTradeIdx)
    if tradeState == 1
        tradeState := lastProfit < 0 ? 2 : 3
    prevClosedTrades := strategy.closedtrades

// Whichever of the six entries fires records its three prices here and raises
// the flag; the boxes and labels are then drawn ONCE, below. A Pine function
// cannot assign to a global, so this is how six entry paths share one drawing
// routine instead of repeating it six times.
var float tradeEntryPx = na
var float tradeStopPx = na
var float tradeTargetPx = na
enteredThisBar = false

// --- First trade (take the FIRST breakout triangle, if it passes the filters) ---
enterLong = breakoutUp and directionLongOK and tradeDayOK and tradesToday < maxTradesPerDay and strategy.position_size == 0 and tradeState == 0
if enterLong
    longSL = f_longStop(close)
    longTP = f_longTP(close, longSL, riskReward)
    qty = f_finalQty(close, longSL)
    firstTradeDir := 1
    tradeState := 1
    tradesToday += 1
    tradeEntryPx := close
    tradeStopPx := longSL
    tradeTargetPx := longTP
    enteredThisBar := true
    strategy.entry("Long", strategy.long, qty = qty)
    strategy.exit("Long TP/SL", from_entry = "Long", stop = longSL, limit = longTP)

enterShort = breakoutDn and directionShortOK and tradeDayOK and filterShortOK and tradesToday < maxTradesPerDay and strategy.position_size == 0 and tradeState == 0
if enterShort
    shortSL = f_shortStop(close)
    shortTP = f_shortTP(close, shortSL, riskReward)
    qty = f_finalQty(close, shortSL)
    firstTradeDir := -1
    tradeState := 1
    tradesToday += 1
    tradeEntryPx := close
    tradeStopPx := shortSL
    tradeTargetPx := shortTP
    enteredThisBar := true
    strategy.entry("Short", strategy.short, qty = qty)
    strategy.exit("Short TP/SL", from_entry = "Short", stop = shortSL, limit = shortTP)

// --- Re-entry trade (only if the FIRST trade closed at a LOSS) ---
// SAME direction as the loser, on a fresh CLOSE back beyond the SAME ORB edge it
// originally broke. `breakoutUp` / `breakoutDn` are already spent for the day —
// `breakoutMarked` latched on the first break — so the level test is written out
// directly here, exactly as the reversal does it.
//
// THE CASE THIS EXISTS FOR — a wick stop-out with no close beyond the level:
//   01:00  range candle sets ORB high 29259.75 / ORB low
//   02:00  closes BELOW the ORB low -> short, stop on the ORB high
//   02:30  candle WICKS through 29259.75 and fills the stop, then closes back
//          INSIDE the range. No close above the ORB high, so the reversal never
//          arms — correctly, it is gated on a CLOSE, not on the stop fill.
//   03:15  closes BELOW the ORB low again -> re-entry short, same stop level
// The stop was taken by a wick, the trend never confirmed against the trade, and
// the setup re-presents itself. That is the day the first version gave up on.
//
// Under the shipped stop mode a long stops out ON the ORB LOW, so a re-entry
// long is the mirror image: price has to travel back across the whole range and
// close above the ORB high again. That is the point — it is a second breakout,
// not an average-down into the loser.
//
// The stop goes back on the SAME structural level as the first trade (the far
// ORB edge under ORB Edge + Buffer), so the second trade's risk per contract is
// whatever the re-entry close sits at above that edge — wider than the first
// trade's if the re-break closes further out, and then $ risk sizing hands back
// FEWER contracts. Risk in dollars stays flat; only the contract count moves.
//
// NOT filtered, same rule as the reversal below: the entry filters apply to the
// FIRST trade only. The per-day direction grid DOES still reach it via
// directionLongOK / directionShortOK, but that can never veto a re-entry the way
// it can veto a reversal — the direction is the same one the first trade already
// passed on.
reLong = enableReentryTrade and tradeState == 2 and firstTradeDir == 1 and directionLongOK and tradeDayOK and tradesToday < maxTradesPerDay and strategy.position_size == 0 and barstate.isconfirmed and levelsAvailable and close > orbHigh
if reLong
    reLongSL = f_longStop(close)
    reLongTP = f_longTP(close, reLongSL, reentryRiskReward)
    qty = f_finalQty(close, reLongSL)
    tradeState := 3
    tradesToday += 1
    tradeEntryPx := close
    tradeStopPx := reLongSL
    tradeTargetPx := reLongTP
    enteredThisBar := true
    strategy.entry("ReLong", strategy.long, qty = qty)
    strategy.exit("ReLong TP/SL", from_entry = "ReLong", stop = reLongSL, limit = reLongTP)

reShort = enableReentryTrade and tradeState == 2 and firstTradeDir == -1 and directionShortOK and tradeDayOK and tradesToday < maxTradesPerDay and strategy.position_size == 0 and barstate.isconfirmed and levelsAvailable and close < orbLow
if reShort
    reShortSL = f_shortStop(close)
    reShortTP = f_shortTP(close, reShortSL, reentryRiskReward)
    qty = f_finalQty(close, reShortSL)
    tradeState := 3
    tradesToday += 1
    tradeEntryPx := close
    tradeStopPx := reShortSL
    tradeTargetPx := reShortTP
    enteredThisBar := true
    strategy.entry("ReShort", strategy.short, qty = qty)
    strategy.exit("ReShort TP/SL", from_entry = "ReShort", stop = reShortSL, limit = reShortTP)

// --- Reversal trade (only if the FIRST trade closed at a LOSS) ---
// OFF BY DEFAULT: Enable Reverse Trade ships unticked, so neither branch fires and
// only the re-entry competes for the day's second fill until someone ticks it.
// Ticking it also makes the Risk:Reward (Reverse Trade) input live — it is unread
// until then.
// NOT filtered. The reversal is gated on the day-of-week, the direction and the
// losing first trade only — the entry filters apply to the FIRST trade.
//
// Note the per-day direction grid DOES reach it, via directionLongOK /
// directionShortOK: a weekday set to one side can never take the reversal, since
// the reversal is by definition the opposite side of the losing first trade.
//
// These sit BELOW the re-entry blocks but the order is cosmetic: a reversal and a
// re-entry are triggered by closes on OPPOSITE sides of the range, so no single
// bar can satisfy both. With both toggles on, the day's second fill simply goes
// to whichever side the price closes beyond first.
revLong = enableReverseTrade and tradeState == 2 and firstTradeDir == -1 and directionLongOK and tradeDayOK and tradesToday < maxTradesPerDay and strategy.position_size == 0 and barstate.isconfirmed and levelsAvailable and close > orbHigh
if revLong
    revLongSL = f_longStop(close)
    revLongTP = f_longTP(close, revLongSL, reverseRiskReward)
    qty = f_finalQty(close, revLongSL)
    tradeState := 3
    tradesToday += 1
    tradeEntryPx := close
    tradeStopPx := revLongSL
    tradeTargetPx := revLongTP
    enteredThisBar := true
    strategy.entry("RevLong", strategy.long, qty = qty)
    strategy.exit("RevLong TP/SL", from_entry = "RevLong", stop = revLongSL, limit = revLongTP)

revShort = enableReverseTrade and tradeState == 2 and firstTradeDir == 1 and directionShortOK and tradeDayOK and tradesToday < maxTradesPerDay and strategy.position_size == 0 and barstate.isconfirmed and levelsAvailable and close < orbLow
if revShort
    revShortSL = f_shortStop(close)
    revShortTP = f_shortTP(close, revShortSL, reverseRiskReward)
    qty = f_finalQty(close, revShortSL)
    tradeState := 3
    tradesToday += 1
    tradeEntryPx := close
    tradeStopPx := revShortSL
    tradeTargetPx := revShortTP
    enteredThisBar := true
    strategy.entry("RevShort", strategy.short, qty = qty)
    strategy.exit("RevShort TP/SL", from_entry = "RevShort", stop = revShortSL, limit = revShortTP)

// === RISK / REWARD BOXES — one routine for all six entries ===
// A profit box entry->target, a risk box entry->stop, both starting 8 bars wide,
// and three text-only price labels on transparent backgrounds so only the
// numbers show against the boxes.
if enteredThisBar and showPnLBoxes
    // clear any still-active viz (should normally be na when flat)
    if not na(curRiskBox)
        box.delete(curRiskBox)
    if not na(curProfitBox)
        box.delete(curProfitBox)
    if not na(curSLLabel)
        label.delete(curSLLabel)
    if not na(curTPLabel)
        label.delete(curTPLabel)
    if not na(curEntryLabel)
        label.delete(curEntryLabel)

    curProfitBox := box.new(left = bar_index, top = math.max(tradeEntryPx, tradeTargetPx), right = bar_index + 8, bottom = math.min(tradeEntryPx, tradeTargetPx), bgcolor = color.new(profitBoxColor, boxTransp), border_width = 0)
    curRiskBox := box.new(left = bar_index, top = math.max(tradeEntryPx, tradeStopPx), right = bar_index + 8, bottom = math.min(tradeEntryPx, tradeStopPx), bgcolor = color.new(lossBoxColor, boxTransp), border_width = 0)

    if showPnLLabels
        curTPLabel := label.new(bar_index, tradeTargetPx, str.tostring(tradeTargetPx, "#.##"), style = label.style_label_right, color = color.new(profitBoxColor, 100), textcolor = profitBoxColor, size = size.small)
        curEntryLabel := label.new(bar_index, tradeEntryPx, str.tostring(tradeEntryPx, "#.##"), style = label.style_label_right, color = color.new(color.white, 100), textcolor = color.white, size = size.small)
        curSLLabel := label.new(bar_index, tradeStopPx, str.tostring(tradeStopPx, "#.##"), style = label.style_label_right, color = color.new(lossBoxColor, 100), textcolor = lossBoxColor, size = size.small)

// The second-chance entries fire long after the day's breakout triangle is spent,
// so they get their own marker — a hollow diamond on the entry bar, above for a
// long and below for a short. Without it the only thing on the chart at that bar
// is a box, and a re-entry looks identical to a first trade.
plotshape(showBreakoutMarker and (reLong or revLong), title = "Second-Chance Long Entry", style = shape.diamond, location = location.abovebar, color = orbHighColor, size = size.tiny)
plotshape(showBreakoutMarker and (reShort or revShort), title = "Second-Chance Short Entry", style = shape.diamond, location = location.belowbar, color = orbLowColor, size = size.tiny)

// === DAY HIGHLIGHT ===
// ORANGE = the day is Off. A faint GREEN / RED wash = the day is one-way, so the
// setting is readable off the chart instead of only out of the input dialog.
isWeekday = dow >= dayofweek.monday and dow <= dayofweek.friday
bgcolor(not isWeekday ? na : not tradeDayOK ? color.new(color.orange, 95) : dayMode == "Long" ? color.new(color.green, 96) : dayMode == "Short" ? color.new(color.red, 96) : na)

// === Exits ===
// TIME STOP: flat at the close of the Nth bar after the entry. Counted from the
// FILL bar, so this reads the open trade's own entry bar rather than the signal.
if maxBarsInTrade > 0 and strategy.position_size != 0 and strategy.opentrades > 0
    if bar_index - strategy.opentrades.entry_bar_index(0) >= maxBarsInTrade
        strategy.close_all(comment = "time stop")

// END-OF-DAY FLAT: never carry a position past the session its levels belong to,
// i.e. past 13:30 ET / 14:30 ET. This must fire on the LAST bar of that session;
// a Pine script cannot see the next bar, so it projects one bar-length forward
// instead — exact on every ordinary boundary. `newDay` is the catch-up for
// boundaries that sit inside a market gap, where the projection lands in the gap
// and misses.
//
// KNOWN GAP: that catch-up is NOT "one bar late". On a holiday early close the
// tape halts at 13:00 ET, BEFORE the 13:30/14:30 boundary — the last bar opens
// 12:45 and projects to 13:00, which is still inside the session, so no flat
// fires and `newDay` does not arrive until the next session opens. On those ~10
// sessions a year the position is carried for hours, and over a holiday weekend
// for up to ~77. Watch those dates if you trade this live.
//
// This boundary is load-bearing: letting the position run to ET midnight
// instead leaves the morning's levels armed into the 18:00 ET Globex reopen,
// which is a different session, and the trades that adds lose money.
tfMs = timeframe.in_seconds(timeframe.period) * 1000
if strategy.position_size != 0 and (f_sessionKey(time + tfMs) != sessionKey or bool(newDay))
    strategy.close_all(comment = "day flat")
