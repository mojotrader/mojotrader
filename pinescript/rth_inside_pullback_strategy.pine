//@version=6
// RTH Inside-Range Break-then-PULLBACK (nqstats "RTH breaks" study) — run on a 5m chart.
//   Setup day: the 09:30 RTH open is INSIDE the prior day's RTH range (pRTH low < open < pRTH high).
//   BREAK  : the first prior-day extreme to be breached (>1 tick) sets the direction (high=long, low=short).
//   ENTRY  : AFTER the break, a LIMIT rests at a pullback measured FROM the broken level (direction-relative):
//            25% = shallow ... 75% = deep.  long: entry = pRTH high - depth*range ; short: entry = pRTH low + depth*range.
//   STOP   : the opposite prior-day extreme (unchanged from the breakout version).
//   TARGET : selectable -> pRTH level (the broken extreme) / HOD-LOD / +10% / +30% / +50% extension of the range.
//   One trade/day, EOD flatten.  Tested ~1yr MNQ 5m: the 25% pullback is best across targets (PF ~1.5-2.0), but
//   the edge is small-sample and somewhat fat-tail dependent — validate on more data. The plain breakout version
//   (rth_inside_breakout_strategy.pine) tested more robust; use this to explore pullback entries.
strategy("RTH Inside Break-Pullback (nqstats)", overlay = true, pyramiding = 1, max_boxes_count = 200, max_labels_count = 200,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1, process_orders_on_close = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5, slippage = 1)

// ---------------------------------------------------------------- Inputs
tz        = input.string("America/New_York", "Timezone", group = "Session")
sess      = input.session("0930-1600", "RTH session", group = "Session")
allowLong = input.bool(true, "Take longs (break pRTH high)",  group = "Strategy")
allowShort= input.bool(true, "Take shorts (break pRTH low)",  group = "Strategy")
pbSel     = input.string("25%", "Pullback depth (25% shallow - 75% deep)", options = ["25%", "50%", "75%"], group = "Strategy",
     tooltip = "Retrace depth measured FROM the broken level (direction-relative): 25% = shallow, 75% = deep. long entry = pRTH high - depth*range ; short entry = pRTH low + depth*range. 25% shallow tested best (most fills, ~75% win to pRTH level).")
tgtSel    = input.string("pRTH level", "Target", options = ["pRTH level", "HOD/LOD", "Ext 10%", "Ext 30%", "Ext 50%"], group = "Strategy",
     tooltip = "pRTH level = return to the broken extreme (highest win rate). Extensions = beyond the broken level. HOD/LOD = the day's extreme at entry.")
breachTk  = input.int(1, "Breach ticks beyond level", 0, 20, group = "Strategy")
useBE     = input.bool(false, "Breakeven at +1R", group = "Strategy")
qty       = input.float(1, "Contracts", minval = 1, group = "Strategy")
cutH      = input.int(16, "Entry cutoff hour",   0, 23, group = "Time", tooltip = "Latest time a pullback may be entered. 16:00 = allow all session.")
cutM      = input.int(0,  "Entry cutoff minute", 0, 59, group = "Time")
flatH     = input.int(16, "Flatten hour",   0, 23, group = "Time")
flatM     = input.int(0,  "Flatten minute", 0, 59, group = "Time")

grpRR     = "Risk / Reward tool"
showRR    = input.bool(true, "Show risk/reward box at the break", group = grpRR)
ptVal     = input.float(2.0, "$ per point per contract", group = grpRR, tooltip = "MNQ=2, NQ=20, MES=5, ES=50.")
rrBars    = input.int(24, "R/R box width (bars)", 1, 300, group = grpRR)

fib = pbSel == "25%" ? 0.25 : pbSel == "50%" ? 0.50 : 0.75

// ---------------------------------------------------------------- Prior-day RTH range + day extremes
inSess     = not na(time(timeframe.period, sess, tz))
newSession = inSess and not inSess[1]
var float curH = na
var float curL = na
var float pH   = na
var float pL   = na
var float dHigh = na
var float dLow  = na
var bool  insideDay = false
var float rng = na

var int   dir = 0
var float entL = na
var float zstop = na
var float curTP = na
var float mgStop = na
var bool  beDone = false
var bool  placed = false
var bool  broke = false
var bool  wasIn = false
var bool  done = false

if newSession
    pH := curH
    pL := curL
    insideDay := not na(pH) and not na(pL) and open < pH and open > pL
    rng := (not na(pH) and not na(pL)) ? pH - pL : na
    curH := high
    curL := low
    dHigh := high
    dLow  := low
    dir := 0
    entL := na
    zstop := na
    curTP := na
    mgStop := na
    beDone := false
    placed := false
    broke := false
    wasIn := false
    done := false
else if inSess
    curH := math.max(curH, high)
    curL := math.min(curL, low)
    dHigh := math.max(dHigh, high)
    dLow  := math.min(dLow, low)

// ---------------------------------------------------------------- Time gates
tk       = breachTk * syminfo.mintick
tod      = hour(time, tz) * 60 + minute(time, tz)
inWindow = inSess and tod <= (cutH*60 + cutM)
flatten  = tod >= (flatH*60 + flatM)

// ---------------------------------------------------------------- Detect the first break -> set direction + levels
if insideDay and not broke and not done and inSess and not na(rng) and rng > 0
    if allowLong and high > pH + tk
        dir := 1
        broke := true
    else if allowShort and low < pL - tk
        dir := -1
        broke := true
    if broke
        entL := dir == 1 ? pH - fib*rng : pL + fib*rng   // direction-relative: 25%=shallow, 75%=deep
        zstop := dir == 1 ? pL : pH

// ---------------------------------------------------------------- Arm the resting pullback LIMIT (once)
canArm = broke and dir != 0 and not placed and not done and inWindow and not flatten
// long entry must sit below the break, short above (skip degenerate cases)
validLong  = dir == 1 and entL < pH
validShort = dir == -1 and entL > pL
if canArm and (validLong or validShort)
    if dir == 1
        strategy.entry("L", strategy.long,  qty = qty, limit = entL)
    else
        strategy.entry("S", strategy.short, qty = qty, limit = entL)
    placed := true

// ---------------------------------------------------------------- On fill: set stop + target
opened = strategy.position_size != 0 and strategy.position_size[1] == 0
if opened
    mgStop := zstop
    if dir == 1
        curTP := tgtSel == "pRTH level" ? pH : tgtSel == "HOD/LOD" ? dHigh : tgtSel == "Ext 10%" ? pH + 0.10*rng : tgtSel == "Ext 30%" ? pH + 0.30*rng : pH + 0.50*rng
    else
        curTP := tgtSel == "pRTH level" ? pL : tgtSel == "HOD/LOD" ? dLow : tgtSel == "Ext 10%" ? pL - 0.10*rng : tgtSel == "Ext 30%" ? pL - 0.30*rng : pL - 0.50*rng
    beDone := false

// ---------------------------------------------------------------- Breakeven at +1R
if useBE and not beDone and strategy.position_size != 0 and not na(entL)
    R = math.abs(entL - zstop)
    if dir == 1 and high >= entL + R
        mgStop := math.max(mgStop, entL)
        beDone := true
    if dir == -1 and low <= entL - R
        mgStop := math.min(mgStop, entL)
        beDone := true

// ---------------------------------------------------------------- Exits
if strategy.position_size != 0
    strategy.exit("Lx", from_entry = "L", stop = mgStop, limit = curTP)
    strategy.exit("Sx", from_entry = "S", stop = mgStop, limit = curTP)

wasIn := wasIn or strategy.position_size != 0
if strategy.position_size == 0 and wasIn
    done := true
if done or flatten or not inWindow
    strategy.cancel("L")
    strategy.cancel("S")
if flatten
    strategy.close_all(comment = "EOD flat")

// ---------------------------------------------------------------- Risk/Reward box (drawn at the break)
if showRR and broke and not broke[1] and not na(entL) and not na(zstop)
    x1 = bar_index
    x2 = bar_index + rrBars
    ptp = dir == 1 ? (tgtSel == "pRTH level" ? pH : tgtSel == "HOD/LOD" ? dHigh : tgtSel == "Ext 10%" ? pH + 0.10*rng : tgtSel == "Ext 30%" ? pH + 0.30*rng : pH + 0.50*rng) : (tgtSel == "pRTH level" ? pL : tgtSel == "HOD/LOD" ? dLow : tgtSel == "Ext 10%" ? pL - 0.10*rng : tgtSel == "Ext 30%" ? pL - 0.30*rng : pL - 0.50*rng)
    riskUsd = math.abs(entL - zstop) * ptVal * qty
    rewUsd  = math.abs(ptp - entL) * ptVal * qty
    rrr = riskUsd > 0 ? rewUsd / riskUsd : na
    rewTop = dir == 1 ? ptp : entL
    rewBot = dir == 1 ? entL : ptp
    rskTop = dir == 1 ? entL : zstop
    rskBot = dir == 1 ? zstop : entL
    box.new(x1, rewTop, x2, rewBot, xloc = xloc.bar_index, border_color = color.new(color.green, 0), border_width = 1, bgcolor = color.new(color.green, 82))
    box.new(x1, rskTop, x2, rskBot, xloc = xloc.bar_index, border_color = color.new(color.red, 0),   border_width = 1, bgcolor = color.new(color.red, 82))
    label.new(x2, entL, "Risk $" + str.tostring(riskUsd, "#") + " | Reward $" + str.tostring(rewUsd, "#") + " (" + str.tostring(rrr, "#.##") + "R, " + str.tostring(qty, "#.#") + "x)", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 15), textcolor = color.white, size = size.small)

// ---------------------------------------------------------------- Visuals
plot(not na(pH) ? pH : na, "pRTH High", color = color.new(color.teal, 0), style = plot.style_linebr)
plot(not na(pL) ? pL : na, "pRTH Low",  color = color.new(color.red, 0),  style = plot.style_linebr)
plot(broke and dir != 0 and not na(entL) ? entL : na, "Pullback entry", color = color.new(color.orange, 0), style = plot.style_linebr)
plot(strategy.position_size != 0 and not na(curTP) ? curTP : na, "Target", color = color.new(color.green, 0), style = plot.style_linebr)
