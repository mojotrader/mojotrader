[htf180_h, htf180_l, htf180_t] = request.security(syminfo.tickerid, "180", [high, low, time], lookahead=barmerge.lookahead_off)
[htf240_h, htf240_l, htf240_t] = request.security(syminfo.tickerid, "240", [high, low, time], lookahead=barmerge.lookahead_off)
[htf420_h, htf420_l, htf420_t] = request.security(syminfo.tickerid, "420", [high, low, time], lookahead=barmerge.lookahead_off)

