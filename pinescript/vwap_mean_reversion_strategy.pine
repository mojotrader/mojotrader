//@version=6
// VWAP Mean-Reversion — intentionally MINIMAL (few parameters, easy to validate honestly).
// Idea: during RTH, fade moves that stretch to a standard-deviation band back toward the session VWAP.
// Costs are modeled by default so every result you see is NET. Test out-of-sample before trusting it.
strategy("VWAP Mean-Reversion", overlay = true, pyramiding = 0,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     process_orders_on_close = true, calc_on_every_tick = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 2.5, slippage = 1)

// ================================================================ INPUTS  (keep this list SHORT)
tz        = input.string("America/New_York", "Session timezone", group = "Session")
rthSess   = input.session("0930-1600", "RTH session — VWAP anchors at its START (NY open)", group = "Session")
cutoffH   = input.int(15, "Entry cutoff hour",   0, 23, group = "Session")
cutoffM   = input.int(30, "Entry cutoff minute", 0, 59, group = "Session")
flatH     = input.int(15, "Flatten hour",   0, 23, group = "Session")
flatM     = input.int(55, "Flatten minute", 0, 59, group = "Session")

bandMult  = input.float(2.0, "Entry band (std-dev multiple)", minval = 0.5, step = 0.1, group = "Strategy")
atrLen    = input.int(14,  "ATR length (for stop)", 1, group = "Strategy")
atrMult   = input.float(1.5, "Stop = ATR ×", minval = 0.2, step = 0.1, group = "Strategy")
qty       = input.float(1, "Contracts", minval = 1, group = "Strategy")

// ================================================================ NEW YORK OPEN ANCHORED VWAP + DEVIATION BANDS
// Anchored at the NY open via TradingView session detection: the VWAP RESETS on the first bar of
// the RTH session and only accumulates during it, so each day is a distinct, clearly-anchored line.
inSession  = not na(time(timeframe.period, rthSess, tz))
newSession = inSession and not inSession[1]

var float sPV  = 0.0   // sum(price * vol)   since NY open
var float sV   = 0.0   // sum(vol)           since NY open
var float sP2V = 0.0   // sum(price^2 * vol) since NY open
if newSession
    sPV  := 0.0
    sV   := 0.0
    sP2V := 0.0
if inSession
    src = hlc3
    sPV  += src * volume
    sV   += volume
    sP2V += src * src * volume

// VWAP and its OWN standard deviation, both measured from the NY-open anchor (na outside the session)
vwap  = inSession and sV > 0 ? sPV / sV : na
varc  = inSession and sV > 0 ? math.max(sP2V / sV - vwap * vwap, 0) : na  // volume-weighted variance of price around the VWAP
dev   = na(varc) ? na : math.sqrt(varc)                                    // 1 standard deviation of THIS anchored VWAP
upper = na(dev) ? na : vwap + bandMult * dev                               // deviation multiplier applied to that VWAP's std-dev
lower = na(dev) ? na : vwap - bandMult * dev

// vwap is na outside the session, so each RTH day plots as its own anchored segment
plot(vwap,  "NY VWAP", color = color.new(color.orange, 0), linewidth = 2)
plot(upper, "Upper",   color = color.new(color.gray, 0))
plot(lower, "Lower",   color = color.new(color.gray, 0))

// ================================================================ SIGNALS + TIME WINDOW
tod       = hour(time, tz) * 60 + minute(time, tz)
inWindow  = inSession and tod <= (cutoffH * 60 + cutoffM)
flatten   = tod >= (flatH * 60 + flatM)

// reversion confirmation: price stretched beyond a band, then CLOSES back inside it
longSig  = not na(lower) and ta.crossover(close, lower)     // dipped below lower band, closed back above -> fade up
shortSig = not na(upper) and ta.crossunder(close, upper)    // spiked above upper band, closed back below -> fade down

atr = ta.atr(atrLen)
var float eStop = na

// ================================================================ ENTRIES (flat-only, inside window)
if inWindow and not flatten and strategy.position_size == 0
    if longSig
        strategy.entry("L", strategy.long, qty = qty)
        eStop := close - atrMult * atr
    if shortSig
        strategy.entry("S", strategy.short, qty = qty)
        eStop := close + atrMult * atr

// ================================================================ EXITS
// target = VWAP (the mean, dynamic); stop = fixed ATR distance captured at entry
if strategy.position_size != 0 and not na(vwap)
    strategy.exit("Lx", from_entry = "L", stop = eStop, limit = vwap)
    strategy.exit("Sx", from_entry = "S", stop = eStop, limit = vwap)

// hard flat at session end
if flatten
    strategy.close_all(comment = "EOD flat")
